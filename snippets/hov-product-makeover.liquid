<!-- 
================================================================
House of Viya — Complete Product Page Makeover
================================================================

ALL CUSTOMIZABLE VIA SHOPIFY METAFIELDS (per product):
• Custom tags (Bestseller, Hot Selling, Limited Deal, etc.)
• Material composition (304 SS, 18K Gold, Copper, etc.)
• Subtitle
• "Why you should buy" section
• Guarantee text (default: 6 Months Anti-Tarnish)

FEATURES:
• Slash pricing with % OFF
• Customizable product tags (metafield-driven)
• Material composition badges
• Pincode delivery checker
• Floating Add to Cart + Buy Now bar
• Compact quantity selector
• Trust strip + payment icons
• "Why buy this" customizable section

================================================================
-->

{% comment %} ■■■■■■■ LIQUID: Read metafields + calculate pricing ■■■■■■■ {% endcomment %}

{% assign cv = product.selected_or_first_available_variant %}
{% assign price = cv.price %}
{% assign compare = cv.compare_at_price %}
{% assign on_sale = false %}
{% assign pct_off = 0 %}
{% if compare and compare > price %}
  {% assign on_sale = true %}
  {% assign saved = compare | minus: price %}
  {% assign pct_off = saved | times: 100 | divided_by: compare %}
{% endif %}

{% comment %} ■■ Read custom metafields ■■ {% endcomment %}
{% assign custom_tags_raw = product.metafields.custom.product_tags | default: '' %}
{% assign custom_subtitle = product.metafields.custom.subtitle | default: '' %}
{% assign material_raw = product.metafields.custom.material_info | default: '' %}
{% assign why_buy_raw = product.metafields.custom.why_buy | default: '' %}

{% comment %} ■■ Parse into arrays ■■ {% endcomment %}
{% assign custom_tags = custom_tags_raw | split: ',' %}
{% assign materials = material_raw | split: ',' %}
{% assign why_buy_lines = why_buy_raw | split: '
' %}

<style>
/* ===== CRITICAL LAYOUT FIX: Force product-action to stack vertically ===== */
.product-action.fl { 
  flex-direction: column !important; 
  align-items: stretch !important; 
}

/* ===== Primary Button ===== */
.product-action .hov-buttons .hov-btn-primary.btn.pr_btn { 
  height: 48px !important;              /* Increased height */
  border: none !important; 
  background: linear-gradient(135deg, #0F3B2E 0%, #1a5c47 50%, #0F3B2E 100%) !important; 
  background-size: 200% 200% !important; 
  color: #fff !important; 
  max-width: none !important; 
  padding: 14px 12px !important;        /* Increased padding */
  border-radius: 6px !important; 
  font-size: 13px !important;           /* Slightly bigger text */
  flex: 0 0 auto !important; 
  line-height: 1.2 !important;
  width: auto !important;      
  min-width: 160px !important;          /* Increased width */
  max-width: 240px !important;
  margin-top: 10px !important;          /* ✅ Added top margin */
}

/* ===== Secondary Button ===== */
.product-action .hov-buttons .shopify-payment-button .hov-btn-secondary { 
  height: 48px !important;              /* Increased height */
  border: 2px solid #1a1a1a !important; 
  background: #1a1a1a !important; 
  color: #fff !important; 
  max-width: none !important; 
  padding: 14px 12px !important;        /* Increased padding */
  border-radius: 6px !important; 
  font-size: 13px !important; 
  width: auto !important;        
  line-height: 1.2 !important;
  min-width: 160px !important; 
  max-width: 240px !important;
  margin-top: 10px !important;          /* ✅ Added top margin */
}
/* ===== Hide WhatsApp "Order on WhatsApp" button ===== */
.order_whatsapp { display: none !important; }
a[onclick*="sendWhatsAppOrder"] { display: none !important; }

/* 1. CUSTOM TAGS */
.hov2-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; width: 100%; }
.hov2-tag { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; padding: 4px 10px; border-radius: 6px; line-height: 1.2; white-space: nowrap; }
.hov2-tag--bestseller { background: #FFF3E0; color: #E65100; }
.hov2-tag--hot { background: #FFEBEE; color: #C62828; }
.hov2-tag--limited { background: #FFEBEE; color: #C62828; animation: hov2Flash 1.8s ease-in-out infinite; }
.hov2-tag--new { background: #E3F2FD; color: #1565C0; }
.hov2-tag--sale { background: #E53935; color: #fff; }
.hov2-tag--default { background: #F3E5F5; color: #6A1B9A; }
@keyframes hov2Flash { 0%,100%{opacity:1;} 50%{opacity:0.6;} }

/* 2. SLASH PRICING */
.hov2-slash { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; flex-wrap: wrap; width: 100%; }
.hov2-slash-sale { font-size: 22px; font-weight: 800; color: #0F3B2E; }
.hov2-slash-cmp { font-size: 16px; color: #aaa; text-decoration: line-through; }
.hov2-slash-off { background: #E53935; color: #fff; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 4px; }
.hov2-slash-saved { font-size: 12px; color: #2E7D32; font-weight: 600; }

/* 3. SUBTITLE */
.hov2-subtitle { font-size: 14px; color: #777; margin-top: -4px; margin-bottom: 14px; line-height: 1.5; font-style: italic; width: 100%; }

/* 4. MATERIAL BADGES */
.hov2-materials { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; width: 100%; }
.hov2-mat { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 600; padding: 5px 10px; border-radius: 8px; border: 1px solid #e0e0e0; background: #fafafa; color: #444; }
.hov2-mat-icon { width: 14px; height: 14px; color: #0F3B2E; flex-shrink: 0; }
.hov2-mat--gold { border-color: #FFD54F; background: #FFFDE7; color: #8D6E00; }
.hov2-mat--copper { border-color: #FFAB91; background: #FBE9E7; color: #BF360C; }
.hov2-mat--ss { border-color: #B0BEC5; background: #ECEFF1; color: #37474F; }

/* 5. QUANTITY SELECTOR */
.hov2-qty-row { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; width: 100%; }
.hov2-qty-label { font-size: 13px; font-weight: 600; color: #555; white-space: nowrap; }
.hov2-qty-box { display: inline-flex; align-items: center; border: 1.5px solid #d4d4d4; border-radius: 10px; overflow: hidden; background: #fff; }
.hov2-qty-btn { width: 38px; height: 38px !important; border: none !important; background: #f8f8f8 !important; font-size: 18px; font-weight: 600; color: #333 !important; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 0.15s; font-family: inherit; flex: none !important; }
.hov2-qty-btn:hover { background: #eee !important; }
.hov2-qty-val { width: 52px; height: 38px; border: none; border-left: 1px solid #e8e8e8; border-right: 1px solid #e8e8e8; text-align: center; font-size: 15px; font-weight: 700; color: #333; background: #fff; -moz-appearance: textfield; }
.hov2-qty-val::-webkit-inner-spin-button, .hov2-qty-val::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }

/* 6. CTA BUTTONS — premium height, gradient + soft shadow, refined hover */
.hov-buttons {
  display: flex !important;
  flex-direction: row !important;
  gap: 12px !important;
  margin: 8px 0 6px !important;
  width: 100% !important;
}
.hov-btn {
  position: relative !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px !important;
  flex: 1 1 0 !important;
  padding: 0 20px !important;
  border-radius: 12px !important;
  font-size: 14px !important;
  font-weight: 700 !important;
  letter-spacing: 0.3px !important;
  cursor: pointer !important;
  transition: transform 0.25s cubic-bezier(0.25,0.46,0.45,0.94), box-shadow 0.25s ease, background-position 0.6s ease !important;
  overflow: hidden !important;
  font-family: inherit !important;
  height: 52px !important;
  line-height: 1 !important;
  min-height: 52px !important;
  max-width: none !important;
}
.hov-btn-primary {
  background: linear-gradient(135deg, #0F3B2E 0%, #1a5c47 50%, #0F3B2E 100%) !important;
  background-size: 200% 200% !important;
  color: #fff !important;
  border: none !important;
  box-shadow: 0 6px 18px rgba(15,59,46,0.22) !important;
}
.hov-btn-primary:hover {
  background-position: 100% 0 !important;
  transform: translateY(-2px) !important;
  box-shadow: 0 12px 26px rgba(15,59,46,0.30) !important;
}
.hov-btn-primary::after {
  content: '' !important;
  position: absolute !important;
  top: 0 !important;
  left: -100% !important;
  width: 60% !important;
  height: 100% !important;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.18), transparent) !important;
  animation: hov2Shimmer 3.2s ease-in-out infinite !important;
  pointer-events: none !important;
}
@keyframes hov2Shimmer { 0% { left: -100%; } 100% { left: 200%; } }
.hov-btn-secondary {
  background: #1a1a1a !important;
  color: #fff !important;
  border: 1.5px solid #1a1a1a !important;
  box-shadow: 0 4px 14px rgba(0,0,0,0.18) !important;
  height: 52px !important;
  line-height: 1 !important;
}
.hov-btn-secondary:hover {
  background: #000 !important;
  border-color: #000 !important;
  transform: translateY(-2px) !important;
  box-shadow: 0 10px 22px rgba(0,0,0,0.28) !important;
}
.hov-btn .hov2-icon, .hov-btn .hov2-bolt { width: 17px !important; height: 17px !important; }
/* Wrapper normalization for Shopify payment button DOM */
.hov-buttons > div { flex: 1 1 0% !important; display: flex !important; flex-direction: column !important; }
.hov-buttons > div > div { flex: 1 !important; display: flex !important; }
.hov-buttons .shopify-payment-button { flex: 1 !important; display: flex !important; }
.hov-buttons .shopify-payment-button .hov-btn-secondary { width: 100% !important; height: 52px !important; }
.hov-buttons > label.cart_term { display: none !important; }

/* 7. PREMIUM TRUST BADGES — 4 in a row, icon + label + sub */
.hov2-trust {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  margin: 14px 0 0;
  padding: 0;
  border: 0;
  width: 100%;
}
.hov2-trust-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 6px;
  padding: 12px 8px;
  background: linear-gradient(180deg, #FAF7F2 0%, #F4F1EC 100%);
  border: 1px solid rgba(200, 178, 138, 0.32);
  border-radius: 12px;
  color: #0F3B2E;
  line-height: 1.3;
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  min-width: 0;
}
.hov2-trust-item:hover {
  border-color: rgba(200, 178, 138, 0.62);
  box-shadow: 0 6px 18px rgba(15, 59, 46, 0.10);
  transform: translateY(-2px);
}
.hov2-trust-icon {
  width: 22px;
  height: 22px;
  color: #0F3B2E;
  flex-shrink: 0;
}
.hov2-trust-label {
  font-size: 11.5px;
  font-weight: 700;
  color: #0F3B2E;
  letter-spacing: 0.2px;
}
.hov2-trust-sub {
  font-size: 9.5px;
  font-weight: 500;
  color: #7A7A7A;
  letter-spacing: 0.1px;
}

/* 7b. MICRO TRUST TEXT */
.hov2-microtrust {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin: 10px 0 14px;
  font-size: 12px;
  color: #7A7A7A;
  letter-spacing: 0.3px;
  text-align: center;
  flex-wrap: wrap;
  font-weight: 500;
}
.hov2-microtrust strong {
  color: #0F3B2E;
  font-weight: 700;
}
.hov2-microtrust-dot { color: #C8B28A; font-weight: 700; }

/* 8. DELIVERY / PINCODE — modernized */
.hov2-pincode { margin: 16px 0 14px; width: 100%; }
.hov2-pin-label { font-size: 13px; font-weight: 700; color: #2E2E2E; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; letter-spacing: 0.2px; }
.hov2-pin-label svg { width: 16px; height: 16px; color: #0F3B2E; }
.hov2-pin-row {
  display: flex;
  gap: 0;
  border: 1.5px solid #E8E1D8;
  border-radius: 12px;
  overflow: hidden;
  background: #fff;
  max-width: 380px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.hov2-pin-row:focus-within {
  border-color: #0F3B2E;
  box-shadow: 0 0 0 3px rgba(15,59,46,0.08);
}
.hov2-pin-input {
  flex: 1;
  border: none;
  padding: 11px 14px;
  font-size: 13px;
  font-weight: 500;
  outline: none;
  font-family: inherit;
  height: auto !important;
  background: #fff !important;
  color: #2E2E2E !important;
  letter-spacing: 0.2px;
}
.hov2-pin-input::placeholder { color: #b8b5b0; }
.hov2-pin-btn {
  background: #0F3B2E !important;
  color: #fff !important;
  border: none !important;
  padding: 11px 22px !important;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  text-transform: uppercase;
  letter-spacing: 0.7px;
  font-family: inherit;
  white-space: nowrap;
  flex: none !important;
  height: auto !important;
  border-radius: 0 !important;
  transition: background 0.2s ease;
}
.hov2-pin-btn:hover { background: #174D3C !important; }
.hov2-pin-helper {
  margin-top: 8px;
  font-size: 11.5px;
  color: #7A7A7A;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  letter-spacing: 0.2px;
}
.hov2-pin-result { margin-top: 8px; font-size: 12px; line-height: 1.5; display: none; }
.hov2-pin-result.is-visible { display: block; }
.hov2-pin-success { color: #2E7D32; }
.hov2-pin-error { color: #C62828; }

/* 9. PAYMENTS — minimal pay-with, equal-spaced premium icons */
.hov2-payments {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 14px 0 0;
  flex-wrap: wrap;
  width: 100%;
}
.hov2-pay-label {
  font-size: 10px;
  color: #b0aca6;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-weight: 600;
  margin-right: 6px;
}
.hov2-pay-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  background: #fff;
  border: 1px solid #E8E1D8;
  border-radius: 8px;
  padding: 0 10px;
  font-size: 11px;
  font-weight: 800;
  color: #2E2E2E;
  height: 32px;
  min-width: 46px;
  letter-spacing: 0.5px;
  transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  box-shadow: 0 1px 2px rgba(0,0,0,0.03);
}
.hov2-pay-icon svg { display: block; flex-shrink: 0; }
.hov2-pay-icon:hover { border-color: rgba(15,59,46,0.35); transform: translateY(-1px); box-shadow: 0 3px 8px rgba(0,0,0,0.06); }
.hov2-pay--upi { color: #fff; background: linear-gradient(135deg,#6B3FA0 0%,#FF7E1B 100%); border-color: transparent; font-style: italic; letter-spacing: 0.6px; }
.hov2-pay--gpay { color: #1F1F1F; }
.hov2-pay--visa { color: #1A1F71; font-style: italic; font-weight: 900; letter-spacing: 1.2px; }
.hov2-pay--mc { color: #1F1F1F; gap: 4px; }
.hov2-pay--cod { background: #F1F7F2; color: #0F3B2E; border-color: rgba(15,59,46,0.22); }

/* 10. ABOUT THIS PIECE — unified description + why-you'll-love-it card */
.hov2-about {
  margin-top: 20px;
  background: #FAF7F2;
  border: 1px solid #E8E1D8;
  border-radius: 16px;
  padding: 22px 24px;
  width: 100%;
  box-sizing: border-box;
}
.hov2-about-title {
  font-size: 11px;
  font-weight: 700;
  color: #8d8579;
  margin: 0 0 14px;
  letter-spacing: 1.6px;
  text-transform: uppercase;
}
.hov2-about-desc {
  font-size: 14px;
  color: #4a4a4a;
  line-height: 1.75;
  margin: 0;
}
.hov2-about-desc p { margin: 0 0 10px; }
.hov2-about-desc p:last-child { margin-bottom: 0; }
.hov2-about-desc a { color: #0F3B2E; text-decoration: underline; }
.hov2-about-divider {
  height: 1px;
  background: rgba(15,59,46,0.12);
  margin: 18px 0;
  border: 0;
}
.hov2-about-sub {
  font-size: 14px;
  font-weight: 700;
  color: #0F3B2E;
  margin: 0 0 12px;
  display: flex;
  align-items: center;
  gap: 7px;
  letter-spacing: 0.3px;
}
.hov2-whybuy-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
.hov2-whybuy-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 13.5px;
  color: #2E2E2E;
  line-height: 1.55;
  padding: 0;
}
.hov2-whybuy-check {
  width: 16px;
  height: 16px;
  color: #0F3B2E;
  flex-shrink: 0;
  margin-top: 3px;
}

/* 11. FLOATING BAR */
.hov2-float-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 999; background: #fff; border-top: 1px solid #e8e8e8; box-shadow: 0 -4px 20px rgba(0,0,0,0.1); transform: translateY(100%); transition: transform 0.35s cubic-bezier(0.25,0.46,0.45,0.94); }
.hov2-float-bar.is-visible { transform: translateY(0); }
.hov2-float-inner { max-width: 700px; margin: 0 auto; padding: 10px 16px; display: flex; align-items: center; gap: 10px; }
.hov2-float-info { flex: 0 0 auto; display: flex; align-items: center; gap: 8px; }
.hov2-float-thumb { width: 40px; height: 40px; border-radius: 8px; object-fit: cover; border: 1px solid #eee; }
.hov2-float-meta { min-width: 0; }
.hov2-float-price-row { display: flex; align-items: center; gap: 5px; }
.hov2-float-sale { font-size: 15px; font-weight: 700; color: #0F3B2E; }
.hov2-float-cmp { font-size: 11px; color: #aaa; text-decoration: line-through; }
.hov2-float-off { font-size: 9px; font-weight: 700; color: #E53935; background: #FFEBEE; padding: 1px 5px; border-radius: 3px; }
.hov2-float-tag { font-size: 9px; font-weight: 700; text-transform: uppercase; color: #E65100; }
.hov2-float-btns { flex: 1; display: flex; gap: 8px; justify-content: flex-end; }
.hov2-float-atc, .hov2-float-buy { display: flex; align-items: center; justify-content: center; gap: 6px; border-radius: 11px; font-size: 13px; font-weight: 600; cursor: pointer; padding: 11px 16px; transition: all 0.2s ease; font-family: inherit; white-space: nowrap; flex: 1; max-width: 150px; }
.hov2-float-atc { background: #fff !important; color: #0F3B2E !important; border: 1.5px solid #0F3B2E !important; height: auto !important; }
.hov2-float-buy { background: #0F3B2E !important; color: #fff !important; border: none !important; height: auto !important; }
.hov2-float-atc.is-added { background: #0F3B2E !important; color: #fff !important; border-color: #0F3B2E !important; }

/* 12. HIDE ORIGINAL ELEMENTS */
.hov-qty-wrap { display: none !important; }
.hov-sticky-bar { display: none !important; }

/* 13. MOBILE RESPONSIVE */
@media (max-width: 749px) {
  .hov-btn { padding: 0 14px !important; font-size: 13px !important; border-radius: 11px !important; height: 48px !important; min-height: 48px !important; }
  .hov-btn-secondary, .hov-buttons .shopify-payment-button .hov-btn-secondary { height: 48px !important; }
  .hov-buttons { gap: 10px !important; }
  .hov2-trust { grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .hov2-trust-item { padding: 11px 6px; gap: 5px; }
  .hov2-trust-icon { width: 20px; height: 20px; }
  .hov2-trust-label { font-size: 11px; }
  .hov2-trust-sub { font-size: 9px; }
  .hov2-microtrust { font-size: 11px; gap: 5px; }
  .hov2-slash-sale { font-size: 20px; }
  .hov2-float-inner { padding: 8px 10px; gap: 8px; }
  .hov2-float-thumb { width: 36px; height: 36px; }
  .hov2-float-btns { gap: 6px; }
  .hov2-float-atc, .hov2-float-buy { padding: 10px 10px; font-size: 12px; max-width: none; flex: 1 1 0; min-width: 0; }
  .hov2-pincode { margin-top: 12px; }
  .hov2-pin-row { max-width: 100%; }
  .hov2-pin-input { padding: 10px 12px; }
  .hov2-pin-btn { padding: 10px 16px !important; }
  .hov2-payments { gap: 6px; }
  .hov2-pay-icon { padding: 0 9px; min-width: 40px; height: 28px; font-size: 10.5px; }
  .hov2-whybuy { padding: 14px 14px; }
  .hov2-whybuy-item { font-size: 12.5px; }
}
@media (max-width: 540px) {
  .hov2-float-thumb { display: none; }
  .hov2-float-tag { display: none; }
  .hov2-float-info { gap: 0; flex: 0 0 auto; min-width: 0; max-width: 38%; }
  .hov2-float-meta { min-width: 0; }
  .hov2-float-sale { font-size: 14px; }
  .hov2-float-cmp, .hov2-float-off { display: none; }
  .hov2-float-btns { flex: 1 1 auto; gap: 6px; }
  .hov2-float-atc, .hov2-float-buy { padding: 10px 8px !important; font-size: 12px !important; gap: 4px; }
  .hov2-float-atc svg, .hov2-float-buy svg { width: 13px !important; height: 13px !important; }
}
@media (max-width: 400px) {
  .hov2-float-info { display: none; }
  .hov2-float-atc, .hov2-float-buy { flex: 1; max-width: none; }
  .hov-buttons { flex-direction: column !important; gap: 8px !important; }
}
</style>

<!-- FLOATING BAR HTML -->
<div class="hov2-float-bar" id="hov2FloatBar">
  <div class="hov2-float-inner">
    <div class="hov2-float-info">
      <img class="hov2-float-thumb" src="{{ product.featured_image | image_url: width: 100 }}" alt="{{ product.title | escape }}" loading="lazy">
      <div class="hov2-float-meta">
        {% if custom_tags.size > 0 %}<div class="hov2-float-tag">{{ custom_tags[0] | strip }}</div>{% endif %}
        <div class="hov2-float-price-row">
          <span class="hov2-float-sale">{{ price | money }}</span>
          {% if on_sale %}<span class="hov2-float-cmp">{{ compare | money }}</span><span class="hov2-float-off">{{ pct_off }}%</span>{% endif %}
        </div>
      </div>
    </div>
    <div class="hov2-float-btns">
      <button class="hov2-float-atc" id="hov2FloatATC"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg> Add to Cart</button>
      <button class="hov2-float-buy" id="hov2FloatBuy"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg> Buy Now</button>
    </div>
  </div>
</div>

<script>
(function() {
  var VARIANT_ID = '{{ cv.id }}';
  function init() {
    var form = document.querySelector('.hov-product-form');
    var btnsWrap = document.querySelector('.hov-buttons');
    var qtyWrap = document.querySelector('.hov-qty-wrap');
    var addBtn = document.querySelector('.hov-btn-primary');
    var buyBtn = document.querySelector('.hov-btn-secondary');
    if (!btnsWrap || !addBtn) return;
    var insertTarget = qtyWrap || btnsWrap;
    var parent = insertTarget.parentElement;
    var injectHTML = '';

   // Subtitle
    {% if custom_subtitle != blank %}
      var titleEl = document.querySelector('.hov-title');
      if (titleEl) {
        titleEl.insertAdjacentHTML('afterend', '<div class="hov2-subtitle">{{ custom_subtitle | escape }}</div>');
      }
    {% endif %}

    // Custom Tags
    {% if custom_tags_raw != blank %}
      injectHTML += '<div class="hov2-tags">';
      {% for tag in custom_tags %}
        {% assign t = tag | strip | downcase %}
        {% assign tDisplay = tag | strip %}
        {% if t contains 'bestseller' or t contains 'best seller' %}
          injectHTML += '<span class="hov2-tag hov2-tag--bestseller">★ {{ tDisplay }}</span>';
        {% elsif t contains 'hot' or t contains 'trending' %}
          injectHTML += '<span class="hov2-tag hov2-tag--hot">★ {{ tDisplay }}</span>';
        {% elsif t contains 'limited' or t contains 'flash' or t contains 'deal' %}
          injectHTML += '<span class="hov2-tag hov2-tag--limited">★ {{ tDisplay }}</span>';
        {% elsif t contains 'new' %}
          injectHTML += '<span class="hov2-tag hov2-tag--new">★ {{ tDisplay }}</span>';
        {% else %}
          injectHTML += '<span class="hov2-tag hov2-tag--default">{{ tDisplay }}</span>';
        {% endif %}
      {% endfor %}

      injectHTML += '</div>';
    {% endif %}

    // Slash Pricing
    injectHTML += '<div class="hov2-slash"><span class="hov2-slash-sale">{{ price | money }}</span>';
    {% if on_sale %}
      injectHTML += '<span class="hov2-slash-cmp">{{ compare | money }}</span><span class="hov2-slash-off">{{ pct_off }}% OFF</span><span class="hov2-slash-saved">You save {{ saved | money }}</span>';
    {% endif %}
    injectHTML += '</div>';

    // Material Badges
    {% if material_raw != blank %}
      injectHTML += '<div class="hov2-materials">';
      {% for mat in materials %}
        {% assign m = mat | strip | downcase %}
        {% assign mDisplay = mat | strip %}
        {% if m contains 'gold' %}
          injectHTML += '<span class="hov2-mat hov2-mat--gold"><svg class="hov2-mat-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v8m-4-4h8"/></svg> {{ mDisplay }}</span>';
        {% elsif m contains 'copper' %}
          injectHTML += '<span class="hov2-mat hov2-mat--copper"><svg class="hov2-mat-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg> {{ mDisplay }}</span>';
        {% else %}
          injectHTML += '<span class="hov2-mat hov2-mat--ss"><svg class="hov2-mat-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> {{ mDisplay }}</span>';
        {% endif %}
      {% endfor %}
      injectHTML += '</div>';
    {% endif %}

    // Quantity
    injectHTML += '<div class="hov2-qty-row"><span class="hov2-qty-label">Qty</span><div class="hov2-qty-box"><button type="button" class="hov2-qty-btn" id="hov2QtyMinus">−</button><input type="number" class="hov2-qty-val" id="hov2QtyInput" name="quantity" value="1" min="1"><button type="button" class="hov2-qty-btn" id="hov2QtyPlus">+</button></div></div>';

    var wrapper = document.createElement('div');
    wrapper.innerHTML = injectHTML;
    while (wrapper.firstChild) parent.insertBefore(wrapper.firstChild, btnsWrap);

    // Add icons to existing buttons
    if (!addBtn.querySelector('.hov2-icon')) {
      addBtn.innerHTML = '<svg class="hov2-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg> Add to Cart';
    }
    if (buyBtn && !buyBtn.querySelector('.hov2-bolt')) {
      buyBtn.innerHTML = '<svg class="hov2-bolt" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg> Buy It Now';
    }

    // Inject remaining sections after buttons — order: trust, micro-trust, pincode, payments, why buy
    // Insertion anchor is the reward-points hook when present (so trust lands BELOW it),
    // otherwise it falls back to the buttons wrapper.
    var rewardHook = document.getElementById('reward-page-points');
    var insertAnchor = rewardHook || btnsWrap;
    var afterHTML = '';

    // Premium 4-badge trust row directly below CTAs
    afterHTML += '<div class="hov2-trust">' +
      '<div class="hov2-trust-item">' +
        '<svg class="hov2-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5l-8-3z"/><path d="m9 12 2 2 4-4"/></svg>' +
        '<span class="hov2-trust-label">Anti-Tarnish</span>' +
        '<span class="hov2-trust-sub">Long-lasting shine</span>' +
      '</div>' +
      '<div class="hov2-trust-item">' +
        '<svg class="hov2-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l3 6-9 12L3 9l3-6z"/><path d="M9 3 6 9m9-6 3 6M3 9h18"/></svg>' +
        '<span class="hov2-trust-label">Skin Safe</span>' +
        '<span class="hov2-trust-sub">Nickel-free</span>' +
      '</div>' +
      '<div class="hov2-trust-item">' +
        '<svg class="hov2-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 7 3 13 9 13"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L3 9"/></svg>' +
        '<span class="hov2-trust-label">7-Day Returns</span>' +
        '<span class="hov2-trust-sub">Easy & hassle-free</span>' +
      '</div>' +
      '<div class="hov2-trust-item">' +
        '<svg class="hov2-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>' +
        '<span class="hov2-trust-label">Secure Payment</span>' +
        '<span class="hov2-trust-sub">UPI / Razorpay / Cash </span>' +
      '</div>' +
    '</div>';

    // Micro trust line
    afterHTML += '<div class="hov2-microtrust">' +
      '<strong>✨ Loved by 10,000+ happy customers</strong>' +
      '<span class="hov2-microtrust-dot">•</span>' +
      '<span>Waterproof</span>' +
      '<span class="hov2-microtrust-dot">•</span>' +
      '<span>Sweat proof</span>' +
      '<span class="hov2-microtrust-dot">•</span>' +
      '<span>Everyday Wear</span>' +
    '</div>';

    // Delivery / pincode
    afterHTML += '<div class="hov2-pincode"><div class="hov2-pin-label"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> Check Delivery Availability</div><div class="hov2-pin-row"><input class="hov2-pin-input" id="hov2PinInput" type="text" placeholder="Enter 6-digit pincode" maxlength="6" inputmode="numeric"><button class="hov2-pin-btn" id="hov2PinCheck" type="button">Check</button></div><div class="hov2-pin-helper"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg> Delivery available across India</div><div class="hov2-pin-result" id="hov2PinResult"></div></div>';

    // Payments — minimal "Pay with" label, equal-spaced icons
    afterHTML += '<div class="hov2-payments">' +
      '<span class="hov2-pay-label">Pay with</span>' +
      '<span class="hov2-pay-icon hov2-pay--upi" title="UPI">UPI</span>' +
      '<span class="hov2-pay-icon hov2-pay--gpay" title="Google Pay"><svg viewBox="0 0 18 18" width="14" height="14" aria-hidden="true"><path fill="#4285F4" d="M9 3.6c1.33 0 2.52.46 3.46 1.36l2.57-2.57C13.4.9 11.36 0 9 0 5.48 0 2.44 2.02.96 4.96l3 2.32C4.66 5.14 6.65 3.6 9 3.6z"/><path fill="#34A853" d="M17.62 9.21c0-.59-.05-1.16-.14-1.71H9v3.39h4.85c-.22 1.11-.85 2.06-1.79 2.7l2.9 2.25c1.7-1.57 2.66-3.89 2.66-6.62z"/><path fill="#FBBC05" d="M3.95 10.72c-.18-.55-.29-1.12-.29-1.72s.1-1.18.29-1.72L.96 4.96C.34 6.17 0 7.55 0 9s.34 2.83.96 4.04l2.99-2.32z"/><path fill="#EA4335" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.9-2.25c-.81.54-1.85.86-3.06.86-2.35 0-4.34-1.54-5.05-3.68l-3 2.32C2.44 15.98 5.48 18 9 18z"/></svg>Pay</span>' +
      '<span class="hov2-pay-icon hov2-pay--visa" title="Visa">VISA</span>' +
      '<span class="hov2-pay-icon hov2-pay--mc" title="Mastercard"><svg viewBox="0 0 32 20" width="22" height="14" aria-hidden="true"><circle cx="12" cy="10" r="7.5" fill="#EB001B"/><circle cx="20" cy="10" r="7.5" fill="#F79E1B" fill-opacity="0.92"/></svg></span>' +
      '<span class="hov2-pay-icon hov2-pay--cod" title="Cash on Delivery"><svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="1.5" y="3.5" width="13" height="9" rx="1.5"/><circle cx="8" cy="8" r="2"/></svg>COD</span>' +
    '</div>';
    // Unified "About this piece" card — description + why-you'll-love-it bullets
    {% assign has_desc = false %}
    {% if product.description != blank %}{% assign has_desc = true %}{% endif %}
    {% if has_desc or why_buy_raw != blank %}
      afterHTML += '<div class="hov2-about">';
      afterHTML += '<div class="hov2-about-title">About this piece</div>';
      {% if has_desc %}
        afterHTML += '<div class="hov2-about-desc">' + {{ product.description | json }} + '</div>';
      {% endif %}
      {% if why_buy_raw != blank %}
        {% if has_desc %}
          afterHTML += '<hr class="hov2-about-divider">';
        {% endif %}
        afterHTML += '<div class="hov2-about-sub">★ Why you\'ll love it</div><ul class="hov2-whybuy-list">';
        {% for line in why_buy_lines %}
          {% assign trimmed = line | strip | replace: '•', '' | replace: '·', '' | replace: '▪', '' | replace: '●', '' | replace: '*', '' | strip %}
          {% if trimmed != blank %}
            afterHTML += '<li class="hov2-whybuy-item"><svg class="hov2-whybuy-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg><span>{{ trimmed | escape }}</span></li>';
          {% endif %}
        {% endfor %}
        afterHTML += '</ul>';
      {% endif %}
      afterHTML += '</div>';
    {% endif %}
    insertAnchor.insertAdjacentHTML('afterend', afterHTML);

    // Relocate "About this piece" card into .hov-media so it renders
    // below the product image in the left column.
    var aboutCard = document.querySelector('.hov2-about');
    var mediaCol = document.querySelector('.hov-media');
    if (aboutCard && mediaCol && aboutCard.parentElement !== mediaCol) {
      mediaCol.appendChild(aboutCard);
    }

    // Quantity buttons logic
    var qtyInput = document.getElementById('hov2QtyInput');
    var qtyMinus = document.getElementById('hov2QtyMinus');
    var qtyPlus = document.getElementById('hov2QtyPlus');
    var origQty = form ? form.querySelector('.hov-quantity-input') : null;
    function syncQty() { if (origQty) origQty.value = qtyInput.value; }
    qtyMinus.addEventListener('click', function() { var v = parseInt(qtyInput.value) || 1; if (v > 1) { qtyInput.value = v - 1; syncQty(); } });
    qtyPlus.addEventListener('click', function() { var v = parseInt(qtyInput.value) || 1; qtyInput.value = v + 1; syncQty(); });
    qtyInput.addEventListener('change', syncQty);

    // Pincode checker (visual-only for now)
    var pinInput = document.getElementById('hov2PinInput');
    var pinBtn = document.getElementById('hov2PinCheck');
    var pinResult = document.getElementById('hov2PinResult');
    pinBtn.addEventListener('click', function() {
      var pin = pinInput.value.trim();
      if (pin.length !== 6 || !/^\d{6}$/.test(pin)) {
        pinResult.className = 'hov2-pin-result is-visible';
        pinResult.innerHTML = '<span class="hov2-pin-error">Please enter a valid 6-digit pincode</span>';
        return;
      }
      pinBtn.textContent = '...';
      setTimeout(function() {
        pinResult.className = 'hov2-pin-result is-visible';
        pinResult.innerHTML = '<span class="hov2-pin-success">✓ Delivery available to <strong>' + pin + '</strong></span><div class="hov2-pin-details"><div class="hov2-pin-detail"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg> Est. 3–7 business days</div><div class="hov2-pin-detail"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> COD available</div></div>';
        pinBtn.textContent = 'CHECK';
      }, 600);
    });
    pinInput.addEventListener('keypress', function(e) { if (e.key === 'Enter') { e.preventDefault(); pinBtn.click(); } });

    // Floating bar scroll logic
    var floatBar = document.getElementById('hov2FloatBar');
    var floatATC = document.getElementById('hov2FloatATC');
    var floatBuy = document.getElementById('hov2FloatBuy');
    var isBarVisible = false;
    var ticking = false;
    window.addEventListener('scroll', function() {
      if (!ticking) {
        requestAnimationFrame(function() {
          var scrollY = window.pageYOffset || document.documentElement.scrollTop;
          var threshold = btnsWrap.getBoundingClientRect().bottom + window.scrollY + 50;
          if (scrollY > threshold && !isBarVisible) { isBarVisible = true; floatBar.classList.add('is-visible'); }
          else if (scrollY <= threshold && isBarVisible) { isBarVisible = false; floatBar.classList.remove('is-visible'); }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    // Floating add to cart
    floatATC.addEventListener('click', function(e) {
      e.preventDefault();
      var vid = (form && form.querySelector('input[name="id"]')) ? form.querySelector('input[name="id"]').value : VARIANT_ID;
      var qty = qtyInput ? qtyInput.value : 1;
      floatATC.disabled = true;
      var origHTML = floatATC.innerHTML;
      floatATC.innerHTML = '★ Adding...';
      fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: parseInt(vid), quantity: parseInt(qty) }) })
        .then(function(r) { return r.json(); })
        .then(function() {
          floatATC.innerHTML = '✓ Added!';
          floatATC.classList.add('is-added');
          fetch('/cart.js').then(function(r) { return r.json(); }).then(function(cart) { document.querySelectorAll('.cart-count, .cart-count-bubble span, [data-cart-count]').forEach(function(el) { el.textContent = cart.item_count; }); });
          setTimeout(function() { floatATC.innerHTML = origHTML; floatATC.classList.remove('is-added'); floatATC.disabled = false; }, 2000);
        })
        .catch(function() { floatATC.innerHTML = 'Retry'; setTimeout(function() { floatATC.innerHTML = origHTML; floatATC.disabled = false; }, 2000); });
    });
    floatBuy.addEventListener('click', function(e) {
      e.preventDefault();
      var vid = (form && form.querySelector('input[name="id"]')) ? form.querySelector('input[name="id"]').value : VARIANT_ID;
      var qty = qtyInput ? (parseInt(qtyInput.value) || 1) : 1;
      floatBuy.disabled = true;
      var origBuyHTML = floatBuy.innerHTML;
      floatBuy.innerHTML = '★ Loading...';
      fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: parseInt(vid), quantity: qty }) })
        .then(function(r) { return r.json(); })
        .then(function() { window.location.href = 'https://houseofviya.in/cart'; })
        .catch(function() {
          floatBuy.innerHTML = origBuyHTML;
          floatBuy.disabled = false;
          window.location.href = 'https://houseofviya.in/cart';
        });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
