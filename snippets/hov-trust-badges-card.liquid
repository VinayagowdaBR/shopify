{%- comment -%}
  HOV Trust Badges Card
  ---------------------
  Reusable dark trust-signal card. Mobile-first (2x2 grid),
  600px+ collapses to a single row of 4. No JS, inline SVGs.

  Usage:  {% render 'hov-trust-badges-card' %}
{%- endcomment -%}

<aside class="hov-trust-card" aria-label="Why shop with House of Viya">
  <ul class="hov-trust-card__list" role="list">
    <li class="hov-trust-card__item">
      <span class="hov-trust-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <rect x="2" y="6" width="13" height="11" rx="1"/>
          <path d="M15 9h4l3 3v5h-7"/>
          <circle cx="6.5" cy="18" r="1.8"/>
          <circle cx="17.5" cy="18" r="1.8"/>
        </svg>
      </span>
      <span class="hov-trust-card__title">Free Shipping</span>
      <span class="hov-trust-card__sub">On orders above &#8377;999</span>
    </li>

    <li class="hov-trust-card__item">
      <span class="hov-trust-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M5 21V4"/>
          <path d="M5 4h12.5l-2.5 4 2.5 4H5"/>
        </svg>
      </span>
      <span class="hov-trust-card__title">Made in India</span>
      <span class="hov-trust-card__sub">Proudly made in India</span>
    </li>

    <li class="hov-trust-card__item">
      <span class="hov-trust-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M21 12a9 9 0 0 1-15 6.7L3 16"/>
          <polyline points="3 21 3 16 8 16"/>
          <path d="M3 12a9 9 0 0 1 15-6.7L21 8"/>
          <polyline points="21 3 21 8 16 8"/>
        </svg>
      </span>
      <span class="hov-trust-card__title">Easy Exchange</span>
      <span class="hov-trust-card__sub">Hassle-free size exchange</span>
    </li>

    <li class="hov-trust-card__item">
      <span class="hov-trust-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" focusable="false">
          <path d="M12 2.5l2.7 5.9 6.5.6-4.9 4.4 1.5 6.4L12 16.5 6.2 19.8l1.5-6.4L2.8 9l6.5-.6L12 2.5z"/>
        </svg>
      </span>
      <span class="hov-trust-card__title">4.9 Google Reviews</span>
      <span class="hov-trust-card__sub">Customer satisfaction</span>
    </li>
  </ul>
</aside>

<style>
  .hov-trust-card-wrap {
    padding: 28px 16px 8px;
  }
  @media (min-width: 750px) {
    .hov-trust-card-wrap {
      padding: 36px 20px 14px;
    }
  }
  .hov-trust-card {
    --htc-bg-1: #08110D;
    --htc-bg-2: #142A22;
    --htc-text: #FFFFFF;
    --htc-sub: rgba(255, 255, 255, 0.62);
    --htc-gold: #C8B28A;
    --htc-divider: rgba(200, 178, 138, 0.22);
    display: block;
    margin: 0 auto;
    padding: 18px 14px;
    background: linear-gradient(135deg, var(--htc-bg-1) 0%, var(--htc-bg-2) 100%);
    border: 1px solid rgba(200, 178, 138, 0.22);
    border-radius: 18px;
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.30);
    color: var(--htc-text);
    position: relative;
    overflow: hidden;
  }
  .hov-trust-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 80% at 50% 0%, rgba(200, 178, 138, 0.08), transparent 60%);
    pointer-events: none;
  }
  .hov-trust-card__list {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }
  .hov-trust-card__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 12px 8px;
    text-align: center;
    position: relative;
    transition: transform 0.3s ease;
  }
  .hov-trust-card__item:nth-child(odd)::after {
    content: '';
    position: absolute;
    top: 18%;
    bottom: 18%;
    right: 0;
    width: 1px;
    background: var(--htc-divider);
  }
  .hov-trust-card__item:nth-child(-n+2)::before {
    content: '';
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: 0;
    height: 1px;
    background: var(--htc-divider);
  }
  .hov-trust-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--htc-text);
    transition: color 0.25s ease, transform 0.25s ease;
  }
  .hov-trust-card__title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.4px;
    color: var(--htc-text);
    line-height: 1.3;
  }
  .hov-trust-card__sub {
    font-size: 10.5px;
    font-weight: 400;
    color: var(--htc-sub);
    line-height: 1.4;
    letter-spacing: 0.2px;
  }
  .hov-trust-card__item:hover {
    transform: translateY(-2px);
  }
  .hov-trust-card__item:hover .hov-trust-card__icon {
    color: var(--htc-gold);
    transform: scale(1.06);
  }

  @media (min-width: 600px) {
    .hov-trust-card {
      padding: 22px 18px;
    }
    .hov-trust-card__list {
      grid-template-columns: repeat(4, 1fr);
    }
    .hov-trust-card__item:nth-child(odd)::after,
    .hov-trust-card__item:nth-child(-n+2)::before {
      content: none;
    }
    .hov-trust-card__item:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 18%;
      bottom: 18%;
      right: 0;
      width: 1px;
      background: var(--htc-divider);
    }
    .hov-trust-card__item {
      padding: 10px 12px;
    }
    .hov-trust-card__title {
      font-size: 13px;
    }
    .hov-trust-card__sub {
      font-size: 11.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hov-trust-card__item,
    .hov-trust-card__icon {
      transition: none;
    }
    .hov-trust-card__item:hover,
    .hov-trust-card__item:hover .hov-trust-card__icon {
      transform: none;
    }
  }
</style>
