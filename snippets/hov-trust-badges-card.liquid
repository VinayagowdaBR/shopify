{%- comment -%}
  HOV Trust Badges Card
  ---------------------
  Dark 2x2 trust badge card displayed at the top of the footer
  and under the Add to Cart / Buy It Now buttons on the product page.

  Visual: dark card, white icons + labels, gold hairline dividers.
  Mobile-first 2x2 grid, inline SVGs, no JS.

  Usage:  {% render 'hov-trust-badges-card' %}
{%- endcomment -%}

<aside class="hov-trust-card" aria-label="Why shop with House of Viya">
  <ul class="hov-trust-card__grid" role="list">
    <li class="hov-trust-card__item">
      <span class="hov-trust-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M3 7h11v9H3z"/>
          <path d="M14 10h4l3 3v3h-7"/>
          <circle cx="7" cy="18" r="1.8"/>
          <circle cx="17" cy="18" r="1.8"/>
        </svg>
      </span>
      <span class="hov-trust-card__label">Free Shipping</span>
      <span class="hov-trust-card__sub">For All Prepaid Orders</span>
    </li> 

    <li class="hov-trust-card__item">
      <span class="hov-trust-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M20.5 7.5l-9 9-3-3-5 5"/>
          <path d="M14.5 7.5h6v6"/>
        </svg>
      </span>
      <span class="hov-trust-card__label">Made In India</span>
      <span class="hov-trust-card__sub">Proudly Assembled in India 🇮🇳</span>
    </li>

    <li class="hov-trust-card__item">
      <span class="hov-trust-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M3 12a9 9 0 0 1 15-6.7L21 8"/>
          <polyline points="21 3 21 8 16 8"/>
          <path d="M21 12a9 9 0 0 1-15 6.7L3 16"/>
          <polyline points="3 21 3 16 8 16"/>
        </svg>
      </span>
      <span class="hov-trust-card__label">Easy Exchange</span>
      <span class="hov-trust-card__sub">Easy Exchange for Size</span>
    </li>

    <li class="hov-trust-card__item">
      <span class="hov-trust-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <polygon points="12 3 14.6 9 21 9.6 16.2 13.9 17.7 20 12 16.8 6.3 20 7.8 13.9 3 9.6 9.4 9 12 3"/>
        </svg>
      </span>
      <span class="hov-trust-card__label">4.9 Google Reviews</span>
      <span class="hov-trust-card__sub">{{ shop.metafields.custom.review_count | default: 'XX' }} Customer satisfaction</span>
    </li>
  </ul>
</aside>

<style>
  aside.hov-trust-card {
    --htc-bg: #0E2A22;
    --htc-border: rgba(200, 178, 138, 0.22);
    --htc-icon: #F5EFE0;
    --htc-label: #F5EFE0;
    --htc-sub: rgba(245, 239, 224, 0.68);
    --htc-divider: rgba(200, 178, 138, 0.45);
    --htc-radius: 16px;
    display: block !important;
    box-sizing: border-box;
    margin: 14px 0 18px;
    padding: 22px 16px;
    background: #0E2A22 !important;
    background-color: #0E2A22 !important;
    border: 1px solid var(--htc-border);
    border-radius: var(--htc-radius);
    box-shadow: 0 14px 36px rgba(0, 30, 22, 0.35);
  }
  aside.hov-trust-card *,
  aside.hov-trust-card *::before,
  aside.hov-trust-card *::after {
    box-sizing: border-box;
  }

  /* Mobile-first: 2 x 2 grid */
  aside.hov-trust-card .hov-trust-card__grid {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    grid-template-rows: auto !important;
    align-items: stretch !important;
    column-gap: 0 !important;
    row-gap: 22px !important;
    width: 100% !important;
  }
  aside.hov-trust-card .hov-trust-card__item {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 6px !important;
    margin: 0 !important;
    padding: 6px 10px !important;
    text-align: center !important;
    position: relative !important;
    min-width: 0 !important;
    list-style: none !important;
    border: 0 !important;
    background: transparent !important;
    transition: transform 0.25s ease;
  }
  /* Mobile dividers: vertical between columns, horizontal between rows */
  aside.hov-trust-card .hov-trust-card__item:nth-child(odd)::after {
    content: '' !important;
    position: absolute !important;
    right: 0 !important;
    left: auto !important;
    top: 18% !important;
    bottom: 18% !important;
    width: 1px !important;
    height: auto !important;
    background: var(--htc-divider) !important;
    transform: none !important;
  }
  aside.hov-trust-card .hov-trust-card__item:nth-child(even)::after {
    content: none !important;
  }
  aside.hov-trust-card .hov-trust-card__item:nth-child(-n+2)::before {
    content: '' !important;
    position: absolute !important;
    left: 8% !important;
    right: 8% !important;
    top: auto !important;
    bottom: -11px !important;
    height: 1px !important;
    width: auto !important;
    background: var(--htc-divider) !important;
    transform: none !important;
  }
  aside.hov-trust-card .hov-trust-card__icon {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 32px !important;
    height: 32px !important;
    margin: 0 !important;
    padding: 0 !important;
    color: var(--htc-icon);
    transition: transform 0.25s ease;
  }
  aside.hov-trust-card .hov-trust-card__icon svg {
    display: block !important;
    width: 22px !important;
    height: 22px !important;
  }
  aside.hov-trust-card .hov-trust-card__label {
    display: block !important;
    font-size: 12px;
    font-weight: 600;
    color: var(--htc-label);
    line-height: 1.25;
    letter-spacing: 0.2px;
    margin: 0 !important;
    padding: 0 !important;
  }
  aside.hov-trust-card .hov-trust-card__sub {
    display: block !important;
    font-size: 10px;
    font-weight: 400;
    color: var(--htc-sub);
    line-height: 1.3;
    letter-spacing: 0.2px;
    margin: 0 !important;
    padding: 0 !important;
  }
  aside.hov-trust-card .hov-trust-card__item:hover .hov-trust-card__icon {
    transform: scale(1.08);
  }

  /* Tablet & up: switch to a single row of 4 equal columns */
  @media (min-width: 768px) {
    aside.hov-trust-card {
      padding: 28px 24px;
    }
    aside.hov-trust-card .hov-trust-card__grid {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      align-items: stretch !important;
      justify-content: space-between !important;
      grid-template-columns: none !important;
      grid-template-rows: none !important;
      row-gap: 0 !important;
      column-gap: 0 !important;
    }
    aside.hov-trust-card .hov-trust-card__item {
      flex: 1 1 0 !important;
      width: 25% !important;
      max-width: 25% !important;
      padding: 4px 18px !important;
      gap: 8px !important;
    }
    /* Reset mobile dividers — single divider on every item except the last */
    aside.hov-trust-card .hov-trust-card__item::before {
      content: none !important;
    }
    aside.hov-trust-card .hov-trust-card__item::after,
    aside.hov-trust-card .hov-trust-card__item:nth-child(odd)::after,
    aside.hov-trust-card .hov-trust-card__item:nth-child(even)::after {
      content: '' !important;
      position: absolute !important;
      right: 0 !important;
      left: auto !important;
      top: 50% !important;
      bottom: auto !important;
      transform: translateY(-50%) !important;
      width: 1px !important;
      height: 56% !important;
      background: var(--htc-divider) !important;
    }
    aside.hov-trust-card .hov-trust-card__item:last-child::after {
      content: none !important;
    }
    aside.hov-trust-card .hov-trust-card__icon {
      width: 38px !important;
      height: 38px !important;
    }
    aside.hov-trust-card .hov-trust-card__icon svg {
      width: 26px !important;
      height: 26px !important;
    }
    aside.hov-trust-card .hov-trust-card__label {
      font-size: 15px;
    }
    aside.hov-trust-card .hov-trust-card__sub {
      font-size: 12px;
    }
  }

  @media (min-width: 1024px) {
    aside.hov-trust-card {
      padding: 32px 32px;
    }
    aside.hov-trust-card .hov-trust-card__item {
      padding: 4px 24px !important;
      gap: 10px !important;
    }
  }

  /* Footer-top placement: max-width and breathing room */
  .site-footer aside.hov-trust-card {
    max-width: 1280px;
    margin: 0 auto 36px;
    background: #0E2A22 !important;
  }

  @media (prefers-reduced-motion: reduce) {
    aside.hov-trust-card .hov-trust-card__item,
    aside.hov-trust-card .hov-trust-card__icon {
      transition: none;
    }
    aside.hov-trust-card .hov-trust-card__item:hover .hov-trust-card__icon {
      transform: none;
    }
  }
</style>
