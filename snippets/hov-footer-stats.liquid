{%- comment -%}
  HOV Footer Stats & Reviews
  --------------------------
  Dark green band split into two columns:
   - Left: 3 KPI tiles (Happy Customers / Customer Rated / Trusted Across India)
   - Right: "Loved By Our Beautiful Customers" testimonial strip with thumbnails.
{%- endcomment -%}

<section class="hov-foot-stats" aria-label="House of Viya stats and reviews">
  <div class="hov-foot-stats__inner">

    <div class="hov-foot-stats__kpis" role="list">
      <div class="hov-foot-stats__kpi" role="listitem">
        <span class="hov-foot-stats__kpi-ico" aria-hidden="true">
          <svg viewBox="0 0 32 32" width="34" height="34" fill="none" stroke="#F5EFE0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="11" r="4"/>
            <path d="M4 26c1-4 4-7 8-7s7 3 8 7"/>
            <circle cx="22" cy="13" r="3"/>
            <path d="M19 26c0.6-3 2.4-5 5-5s4.4 2 5 5"/>
          </svg>
        </span>
        <span class="hov-foot-stats__kpi-num">10,000+</span>
        <span class="hov-foot-stats__kpi-lbl">Happy Customers</span>
      </div>

      <div class="hov-foot-stats__kpi" role="listitem">
        <span class="hov-foot-stats__kpi-ico" aria-hidden="true">
          <svg viewBox="0 0 32 32" width="34" height="34" fill="none" stroke="#F5EFE0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="16 5 19.2 12 26.5 12.6 21 17.5 22.7 24.5 16 20.7 9.3 24.5 11 17.5 5.5 12.6 12.8 12"/>
          </svg>
        </span>
        <span class="hov-foot-stats__kpi-num">4.7+</span>
        <span class="hov-foot-stats__kpi-lbl">Customer Rated</span>
      </div>

      <div class="hov-foot-stats__kpi" role="listitem">
        <span class="hov-foot-stats__kpi-ico" aria-hidden="true">
          <svg viewBox="0 0 32 32" width="34" height="34" fill="none" stroke="#F5EFE0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 4l10 4v8c0 6-4 10.5-10 12-6-1.5-10-6-10-12V8z"/>
            <path d="M11 16l3.5 3.5L21 13"/>
          </svg>
        </span>
        <span class="hov-foot-stats__kpi-num">5,000+</span>
        <span class="hov-foot-stats__kpi-lbl">Trusted<br/>Across India</span>
      </div>
    </div>

    <div class="hov-foot-stats__reviews">
      <div class="hov-foot-stats__rv-head">
        <p class="hov-foot-stats__rv-stars" aria-label="5 star rating">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="#E7B96A"><polygon points="8,1 10,6 15,6.4 11.2,9.7 12.4,14.6 8,12 3.6,14.6 4.8,9.7 1,6.4 6,6"/></svg>
          <svg viewBox="0 0 16 16" width="14" height="14" fill="#E7B96A"><polygon points="8,1 10,6 15,6.4 11.2,9.7 12.4,14.6 8,12 3.6,14.6 4.8,9.7 1,6.4 6,6"/></svg>
          <svg viewBox="0 0 16 16" width="14" height="14" fill="#E7B96A"><polygon points="8,1 10,6 15,6.4 11.2,9.7 12.4,14.6 8,12 3.6,14.6 4.8,9.7 1,6.4 6,6"/></svg>
          <svg viewBox="0 0 16 16" width="14" height="14" fill="#E7B96A"><polygon points="8,1 10,6 15,6.4 11.2,9.7 12.4,14.6 8,12 3.6,14.6 4.8,9.7 1,6.4 6,6"/></svg>
          <svg viewBox="0 0 16 16" width="14" height="14" fill="#E7B96A"><polygon points="8,1 10,6 15,6.4 11.2,9.7 12.4,14.6 8,12 3.6,14.6 4.8,9.7 1,6.4 6,6"/></svg>
        </p>
        <p class="hov-foot-stats__rv-quote">
          &ldquo;Absolutely in love with the quality! It&rsquo;s elegant, and tarnish-free, and perfect for daily wear.&rdquo;
        </p>
        <a
          id="hov-foot-stats-ig-cta-{{ section.id | default: 'fs' }}"
          class="hov-foot-stats__rv-meta hov-foot-stats__rv-meta--cta"
          href="https://www.instagram.com/houseofviya.official/"
          target="_blank"
          rel="noopener noreferrer"
          data-hov-ig-url="https://www.instagram.com/houseofviya.official/"
          style="display:inline-flex;align-items:center;justify-content:center;gap:6px;margin:4px auto 14px;padding:9px 20px;border-radius:999px;font-size:11px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;text-decoration:none;color:#0B2219;background:linear-gradient(135deg,#E7B96A 0%,#f3d28f 50%,#C8B28A 100%);border:1px solid rgba(255,240,200,0.55);box-shadow:inset 0 1px 0 rgba(255,255,255,0.6),inset 0 -2px 0 rgba(0,0,0,0.08),0 6px 18px rgba(231,185,106,0.45);cursor:pointer;transition:transform 0.2s ease,box-shadow 0.2s ease,filter 0.2s ease;position:relative;z-index:5;"
          onmouseover="this.style.transform='translateY(-2px) scale(1.05)';this.style.filter='brightness(1.1)';this.style.boxShadow='inset 0 1px 0 rgba(255,255,255,0.7),inset 0 -2px 0 rgba(0,0,0,0.1),0 10px 24px rgba(231,185,106,0.7)';this.style.cursor='pointer';"
          onmouseout="this.style.transform='';this.style.filter='';this.style.boxShadow='inset 0 1px 0 rgba(255,255,255,0.6),inset 0 -2px 0 rgba(0,0,0,0.08),0 6px 18px rgba(231,185,106,0.45)';"
        >Tag @houseofviya.official to get featured &rarr;</a>
        <script>
          (function(){
            var el = document.getElementById('hov-foot-stats-ig-cta-{{ section.id | default: "fs" }}');
            if (!el || el.dataset.hovInit) return;
            el.dataset.hovInit = '1';

            // The redirect is handled by the native <a href target="_blank">.
            // We only stop other theme JS from hijacking/preventing the click —
            // we never call preventDefault ourselves, so the link always opens.
            el.addEventListener('click', function(ev){
              ev.stopPropagation();
            }, true);

            // JS-driven blink: cannot be killed by CSS overrides.
            var on = true;
            setInterval(function(){
              el.style.opacity = on ? '0.4' : '1';
              on = !on;
            }, 550);
          })();
        </script>
      </div>

      {%- assign hov_handle = settings.customer_photos_handle | default: '@houseofviya' -%}
      {%- assign hov_handle_url = settings.customer_photos_handle_url -%}

      {%- if hov_handle_url != blank -%}
        <a
          href="{{ hov_handle_url }}"
          class="hov-foot-stats__rv-title hov-foot-stats__rv-title--link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open Instagram {{ hov_handle }} to tag us"
        >
          <span class="hov-foot-stats__rv-title-text">Loved By Our Beautiful Customers</span>
          <svg class="hov-foot-stats__rv-title-ig" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" ry="5"/>
            <path d="M16 11.37a4 4 0 1 1-4.74-4.74A4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
          <span class="hov-foot-stats__rv-title-arrow" aria-hidden="true">→</span>
        </a>
      {%- else -%}
        <p class="hov-foot-stats__rv-title">Loved By Our Beautiful Customers</p>
      {%- endif -%}

      <ul class="hov-foot-stats__rv-grid" role="list">
        {%- for i in (1..4) -%}
          {%- assign photo_key = 'customer_photo_' | append: i -%}
          {%- assign url_key = photo_key | append: '_url' -%}
          {%- assign photo = settings[photo_key] -%}
          {%- assign photo_url = settings[url_key] | default: hov_handle_url -%}

          <li class="hov-foot-stats__rv-card">
            {%- if photo != blank -%}
              {%- if photo_url != blank -%}
                <a class="hov-foot-stats__rv-link" href="{{ photo_url }}" target="_blank" rel="noopener" aria-label="Customer photo {{ i }}">
              {%- endif -%}
              {{ photo | image_url: width: 600 | image_tag:
                  loading: 'lazy',
                  class: 'hov-foot-stats__rv-img',
                  widths: '300,600',
                  sizes: '(min-width: 768px) 200px, 50vw',
                  alt: 'House of Viya customer photo'
              }}
              {%- if photo_url != blank -%}</a>{%- endif -%}
            {%- else -%}
              {%- if hov_handle_url != blank -%}
                <a class="hov-foot-stats__rv-link hov-foot-stats__rv-thumb hov-foot-stats__rv-thumb--empty" href="{{ hov_handle_url }}" target="_blank" rel="noopener" aria-label="Tag us on Instagram">
              {%- else -%}
                <span class="hov-foot-stats__rv-thumb hov-foot-stats__rv-thumb--empty" aria-hidden="true">
              {%- endif -%}
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 7h3l2-2.5h8L18 7h3v12H3z"/>
                  <circle cx="12" cy="13" r="4"/>
                </svg>
                <span class="hov-foot-stats__rv-thumb-handle">{{ hov_handle }}</span>
                <span class="hov-foot-stats__rv-thumb-cta">Tag us to be featured</span>
              {%- if hov_handle_url != blank -%}</a>{%- else -%}</span>{%- endif -%}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>

  </div>
</section>

<style>
  .hov-foot-stats {
    background: #0B2219;
    color: #F5EFE0;
    padding: 28px 16px;
    border-top: 1px solid rgba(200, 178, 138, 0.18);
  }
  .hov-foot-stats__inner {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr;
  }
  .hov-foot-stats__kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    text-align: center;
    align-content: center;
  }
  .hov-foot-stats__kpi {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 8px 6px;
    position: relative;
  }
  .hov-foot-stats__kpi + .hov-foot-stats__kpi::before {
    content: '';
    position: absolute;
    left: 0;
    top: 22%;
    bottom: 22%;
    width: 1px;
    background: rgba(200, 178, 138, 0.28);
  }
  .hov-foot-stats__kpi-ico {
    color: #F5EFE0;
    margin-bottom: 4px;
  }
  .hov-foot-stats__kpi-num {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.4px;
    color: #F5EFE0;
  }
  .hov-foot-stats__kpi-lbl {
    font-size: 11px;
    font-weight: 400;
    color: rgba(245, 239, 224, 0.72);
    line-height: 1.3;
  }

  .hov-foot-stats__reviews {
    border-top: 1px solid rgba(200, 178, 138, 0.18);
    padding-top: 18px;
  }
  .hov-foot-stats__rv-head {
    text-align: center;
  }
  .hov-foot-stats__rv-stars {
    margin: 0 0 6px;
    display: inline-flex;
    gap: 2px;
  }
  .hov-foot-stats__rv-quote {
    margin: 0 auto 4px;
    max-width: 360px;
    font-size: 12px;
    line-height: 1.45;
    color: rgba(245, 239, 224, 0.85);
    font-style: italic;
  }
  /* Instagram CTA pill — full styling lives inline on the element so it survives any cache/specificity issue. See <a id="hov-foot-stats-ig-cta-*"> above. */
  .hov-foot-stats__rv-title {
    text-align: center;
    margin: 6px 0 12px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1.1px;
    text-transform: uppercase;
    color: #E7B96A;
  }

  /* === Tappable Instagram CTA — shiny / pressable === */
  .hov-foot-stats__rv-title--link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 6px auto 14px;
    padding: 10px 22px;
    border-radius: 999px;
    text-decoration: none;
    color: #0B2219;
    background:
      linear-gradient(135deg, #E7B96A 0%, #f3d28f 45%, #C8B28A 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      inset 0 -2px 0 rgba(0, 0, 0, 0.08),
      0 8px 22px rgba(231, 185, 106, 0.28),
      0 0 0 1px rgba(231, 185, 106, 0.5);
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transform: translateY(0);
    transition:
      transform 0.18s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.25s ease,
      filter 0.25s ease;
    isolation: isolate;
  }

  /* Static text in the link picks up the gold-on-emerald aesthetic */
  .hov-foot-stats__rv-title--link .hov-foot-stats__rv-title-text {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.1px;
    text-transform: uppercase;
    line-height: 1;
    color: inherit;
  }

  .hov-foot-stats__rv-title--link .hov-foot-stats__rv-title-ig {
    color: inherit;
    flex-shrink: 0;
  }
  .hov-foot-stats__rv-title--link .hov-foot-stats__rv-title-arrow {
    font-size: 14px;
    line-height: 1;
    transform: translateX(0);
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Shimmer that travels across — every 3.5s, ✨ feel */
  .hov-foot-stats__rv-title--link::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      transparent 0%,
      transparent 35%,
      rgba(255, 255, 255, 0.55) 50%,
      transparent 65%,
      transparent 100%
    );
    transform: translateX(-100%);
    animation: hovTitleShine 3.5s ease-in-out infinite;
    pointer-events: none;
    z-index: 1;
  }
  .hov-foot-stats__rv-title--link > * { position: relative; z-index: 2; }

  @keyframes hovTitleShine {
    0%   { transform: translateX(-100%); }
    55%  { transform: translateX(120%); }
    100% { transform: translateX(120%); }
  }

  /* Hover — lift slightly, brighter glow, arrow nudges */
  .hov-foot-stats__rv-title--link:hover {
    transform: translateY(-2px);
    filter: brightness(1.04);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.6),
      inset 0 -2px 0 rgba(0, 0, 0, 0.1),
      0 12px 28px rgba(231, 185, 106, 0.42),
      0 0 0 1px rgba(231, 185, 106, 0.7);
  }
  .hov-foot-stats__rv-title--link:hover .hov-foot-stats__rv-title-arrow {
    transform: translateX(4px);
  }

  /* Press — physical "click" feel */
  .hov-foot-stats__rv-title--link:active {
    transform: translateY(1px) scale(0.985);
    transition: transform 0.08s ease;
    box-shadow:
      inset 0 2px 4px rgba(0, 0, 0, 0.15),
      inset 0 -1px 0 rgba(255, 255, 255, 0.25),
      0 4px 10px rgba(231, 185, 106, 0.2),
      0 0 0 1px rgba(231, 185, 106, 0.5);
    filter: brightness(0.96);
  }

  /* Keyboard focus — same glow as hover */
  .hov-foot-stats__rv-title--link:focus-visible {
    outline: none;
    transform: translateY(-2px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.6),
      inset 0 -2px 0 rgba(0, 0, 0, 0.1),
      0 0 0 3px rgba(231, 185, 106, 0.55),
      0 12px 28px rgba(231, 185, 106, 0.42);
  }

  /* Reduced motion — keep accessibility */
  @media (prefers-reduced-motion: reduce) {
    .hov-foot-stats__rv-title--link::before { animation: none; }
    .hov-foot-stats__rv-title--link,
    .hov-foot-stats__rv-title--link .hov-foot-stats__rv-title-arrow {
      transition: none;
    }
  }
  .hov-foot-stats__rv-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  .hov-foot-stats__rv-card {
    margin: 0;
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(200, 178, 138, 0.25);
  }
  .hov-foot-stats__rv-link {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .hov-foot-stats__rv-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
  }
  .hov-foot-stats__rv-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }
  .hov-foot-stats__rv-thumb {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 8px;
    background:
      linear-gradient(135deg, #6b4a37 0%, #8a6346 50%, #c9a884 100%);
  }
  .hov-foot-stats__rv-thumb--empty {
    background: rgba(245, 239, 224, 0.04);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    color: rgba(245, 239, 224, 0.55);
    text-align: center;
    padding: 6px;
    text-decoration: none;
    transition: border-color 0.25s ease, color 0.25s ease, background 0.25s ease;
  }
  a.hov-foot-stats__rv-thumb--empty:hover {
    border-color: rgba(231, 185, 106, 0.7);
    color: #E7B96A;
    background: rgba(231, 185, 106, 0.06);
  }
  .hov-foot-stats__rv-thumb-handle {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: #E7B96A;
    margin-top: 2px;
  }
  .hov-foot-stats__rv-thumb-cta {
    font-size: 9.5px;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    opacity: 0.75;
    line-height: 1.25;
  }

  @media (min-width: 768px) {
    .hov-foot-stats {
      padding: 36px 24px;
    }
    .hov-foot-stats__inner {
      grid-template-columns: 1fr 1.4fr;
      gap: 36px;
      align-items: center;
    }
    .hov-foot-stats__reviews {
      border-top: 0;
      border-left: 1px solid rgba(200, 178, 138, 0.18);
      padding-top: 0;
      padding-left: 28px;
    }
    .hov-foot-stats__kpi-num {
      font-size: 22px;
    }
    .hov-foot-stats__kpi-lbl {
      font-size: 12px;
    }
    .hov-foot-stats__rv-grid {
      gap: 10px;
    }
  }

  @media (min-width: 1024px) {
    .hov-foot-stats {
      padding: 44px 32px;
    }
    .hov-foot-stats__kpi-num {
      font-size: 26px;
    }
    .hov-foot-stats__rv-title {
      font-size: 14px;
    }
    .hov-foot-stats__rv-quote {
      font-size: 13px;
    }
  }
</style>
