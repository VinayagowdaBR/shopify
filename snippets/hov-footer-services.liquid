{%- comment -%}
  HOV Footer Services
  -------------------
  Bottom strip with 4 service icons:
  Secure Payment / Quick Returns / Order Tracking / 24/7 Support.
{%- endcomment -%}

<section class="hov-foot-services" aria-label="Customer services">
  <ul class="hov-foot-services__row" role="list">

    <li class="hov-foot-services__item">
      <span class="hov-foot-services__ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#F5EFE0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3l8 3v6c0 4.5-3.2 8.4-8 9-4.8-.6-8-4.5-8-9V6z"/>
          <path d="M9 12l2 2 4-4"/>
        </svg>
      </span>
      <span class="hov-foot-services__txt">
        <strong>Secure Payment</strong>
        <small>100% Safe Checkout</small>
      </span>
    </li>

    <li class="hov-foot-services__item">
      <span class="hov-foot-services__ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#F5EFE0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 0 1 15-6.7L21 8"/>
          <polyline points="21 3 21 8 16 8"/>
          <path d="M21 12a9 9 0 0 1-15 6.7L3 16"/>
          <polyline points="3 21 3 16 8 16"/>
        </svg>
      </span>
      <span class="hov-foot-services__txt">
        <strong>Quick Returns</strong>
        <small>Easy Exchange</small>
      </span>
    </li>

    <li class="hov-foot-services__item">
      <span class="hov-foot-services__ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#F5EFE0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="7" width="14" height="10" rx="1.5"/>
          <path d="M17 10h3l1 2v5h-4"/>
          <circle cx="7.5" cy="18" r="1.8"/>
          <circle cx="17.5" cy="18" r="1.8"/>
        </svg>
      </span>
      <span class="hov-foot-services__txt">
        <strong>Order Tracking</strong>
        <small>Real-time Updates</small>
      </span>
    </li>

    <li class="hov-foot-services__item">
      <span class="hov-foot-services__ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#F5EFE0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12a9 9 0 1 0-18 0v3a3 3 0 0 0 3 3h1v-6H5"/>
          <path d="M19 18h-1v-6h1a3 3 0 0 1 0 6z"/>
          <path d="M16 18a4 4 0 0 1-4 4h-1"/>
        </svg>
      </span>
      <span class="hov-foot-services__txt">
        <strong>24/7 Support</strong>
        <small>Dedicated Care</small>
      </span>
    </li>

  </ul>
</section>

<style>
  .hov-foot-services {
    background: #0B2219;
    color: #F5EFE0;
    padding: 18px 16px;
    border-top: 1px solid rgba(200, 178, 138, 0.18);
  }
  .hov-foot-services__row {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1280px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px 12px;
  }
  .hov-foot-services__item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 6px;
    position: relative;
    min-width: 0;
  }
  .hov-foot-services__ico {
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #F5EFE0;
  }
  .hov-foot-services__txt {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 0;
  }
  .hov-foot-services__txt strong {
    font-size: 12px;
    font-weight: 600;
    color: #F5EFE0;
    letter-spacing: 0.2px;
  }
  .hov-foot-services__txt small {
    font-size: 10px;
    font-weight: 400;
    color: rgba(245, 239, 224, 0.6);
    letter-spacing: 0.2px;
  }

  @media (min-width: 768px) {
    .hov-foot-services {
      padding: 22px 24px;
    }
    .hov-foot-services__row {
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
    }
    .hov-foot-services__item {
      justify-content: center;
      padding: 4px 16px;
    }
    .hov-foot-services__item + .hov-foot-services__item::before {
      content: '';
      position: absolute;
      left: 0;
      top: 12%;
      bottom: 12%;
      width: 1px;
      background: rgba(200, 178, 138, 0.25);
    }
    .hov-foot-services__txt strong {
      font-size: 13px;
    }
    .hov-foot-services__txt small {
      font-size: 11px;
    }
  }

  @media (min-width: 1024px) {
    .hov-foot-services {
      padding: 26px 32px;
    }
  }
</style>
