{%- capture navigation -%}{% section 'navigation' %}{%- endcapture -%}
{%- if navigation contains '<!--mmobile-->' -%}{% assign endiv = '</div>'  %}{%- endif -%}
{%- assign desktopnav = navigation | split: '<!--mmobile-->' | first | append: endiv  -%}
{%- assign mobilenav = navigation | split: '<!--mmobile-->' | last | split: '<!--mmobileend -->' | first   -%}
{%- capture siteHeader -%}
{% if settings.snow_effect %}<div class="snow-wrap falling-snow{% if settings.snow_style == "style2" %} style2{% else %} style1{% endif %}">{% endif %}

{%- comment -%}*** Top Announcement ***{%- endcomment -%}
{%- if settings.announcement -%}
<div class="pr tc fl f-jcc f-aic notification-bar{% if settings.announcement_mb %} hide-sm{% endif %}" style="--tcl:{{ settings.annouance_txt }}; --tfw: {{settings.annouance_fw}};--tfs:{{settings.annouance_fs}}px;--tfsm:{{settings.annouance_fsm}}px">
	{%- if settings.announcement_link != blank -%}
		<a href="{{ settings.announcement_link }}" class="ttlTxt db">{{ settings.announcement_txt }}</a>
	{%- else -%}
		<span class="ttlTxt db">{{ settings.announcement_txt }}</span>
	{%- endif -%}
	<span class="close-announcement"><i class="at at-times-l" aria-hidden="true"></i></span>
</div>
{%- endif -%}

{% comment %}*** Top Bar ***{% endcomment %}
{% assign topheaderMb = '' %}
{%- if settings.leftTxt-mobile and settings.centerTxt-mobile and settings.rightTxt-mobile -%}
	{% assign topheaderMb = 'hide-sm hide-md' %}
{%- endif -%}
{%- if settings.topbar -%}
<div class="top-header-wrapper">
	<div class="top-header fl f-aic f-col f-row-md{% if settings.topbar_fullwidth %} fullwidth{% else %} page-width{% endif %} {{topheaderMb}}">
		{%- if settings.leftTxt != blank -%}
			<div class="header-txt fl1 left-hdr{% if settings.leftTxt-mobile %} hide-sm hide-md{% else %} small--tc{% endif %}">
				{%- if settings.leftTxt contains "[social-icons]"-%}
					{%- assign topLeftTxt = settings.leftTxt | split: "[social-icons]" -%}
					{{topLeftTxt[0]}} {% render 'social-media' %} {{topLeftTxt[1]}}
				{%- else -%}
					{{ settings.leftTxt }}
				{%- endif -%}
			</div>
		{%- endif -%}
		<div class="header-txt fl1 middle-hdr tc{% if settings.centerTxt-mobile %} hide-sm hide-md{% endif %}">
			<div class="hov-announce" id="announcementBarText" aria-live="polite" aria-atomic="true">
				<span class="hov-announce-text">{{ settings.centerTxt }}</span>
			</div>
		</div>
		<style>
			/* Subtle shimmer across the top header strip */
			.top-header-wrapper { position: relative; overflow: hidden; }
			.top-header-wrapper::before {
				content: "";
				position: absolute;
				top: 0;
				left: -50%;
				width: 50%;
				height: 100%;
				background: linear-gradient(90deg, transparent 0%, rgba(200, 178, 138, 0.10) 50%, transparent 100%);
				animation: hovShimmer 7s ease-in-out infinite;
				pointer-events: none;
				z-index: 1;
			}
			@keyframes hovShimmer {
				0%   { left: -50%; }
				100% { left: 110%; }
			}
			.top-header-wrapper > .top-header { position: relative; z-index: 2; }

			/* Announcement container */
			.hov-announce {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 8px;
				min-height: 24px;
				font-family: inherit;
				font-size: 13px;
				font-weight: 500;
				letter-spacing: 0.45px;
				transition: opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1),
				            transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
				opacity: 1;
				transform: translateY(0);
				will-change: opacity, transform;
			}
			.hov-announce.is-fading {
				opacity: 0;
				transform: translateY(-6px);
			}
			.hov-announce-text {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				flex-wrap: wrap;
				justify-content: center;
			}

			/* Gold promo-code pill */
			.hov-promo-pill {
				display: inline-flex;
				align-items: center;
				gap: 5px;
				background: linear-gradient(135deg, #C8B28A 0%, #d8c39b 50%, #C8B28A 100%);
				color: #0F3B2E;
				font-family: 'JetBrains Mono', 'Courier New', monospace;
				font-weight: 800;
				font-size: 11px;
				letter-spacing: 0.9px;
				padding: 2px 9px 2px 7px;
				border-radius: 999px;
				cursor: pointer;
				transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
				vertical-align: middle;
				white-space: nowrap;
				user-select: none;
			}
			.hov-promo-pill::before {
				content: "";
				display: inline-block;
				width: 10px;
				height: 10px;
				background: #0F3B2E;
				-webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'><path d='M20.59 13.41 11 23l-9-9 9.59-9.59A2 2 0 0 1 13 4h7a2 2 0 0 1 2 2v7a2 2 0 0 1-.59 1.41z'/><circle cx='6.5' cy='6.5' r='1.5'/></svg>") center / contain no-repeat;
				        mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'><path d='M20.59 13.41 11 23l-9-9 9.59-9.59A2 2 0 0 1 13 4h7a2 2 0 0 1 2 2v7a2 2 0 0 1-.59 1.41z'/><circle cx='6.5' cy='6.5' r='1.5'/></svg>") center / contain no-repeat;
			}
			.hov-promo-pill:hover {
				transform: translateY(-1px);
				box-shadow: 0 4px 12px rgba(200, 178, 138, 0.45);
			}
			.hov-promo-pill.is-copied {
				background: linear-gradient(135deg, #1f6e54 0%, #0F3B2E 100%);
				color: #ffffff;
			}
			.hov-promo-pill.is-copied::before {
				background: #ffffff;
				-webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'/></svg>") center / contain no-repeat;
				        mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'/></svg>") center / contain no-repeat;
			}

			/* Toast under the pill */
			.hov-promo-toast {
				position: absolute;
				top: calc(100% + 6px);
				left: 50%;
				transform: translate(-50%, 4px);
				background: #0F3B2E;
				color: #ffffff;
				font-size: 11px;
				font-weight: 600;
				letter-spacing: 0.4px;
				padding: 4px 10px;
				border-radius: 6px;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.25s ease, transform 0.25s ease;
				white-space: nowrap;
				z-index: 10;
			}
			.hov-promo-pill-wrap { position: relative; display: inline-flex; }
			.hov-promo-pill-wrap.is-showing .hov-promo-toast {
				opacity: 1;
				transform: translate(-50%, 0);
			}

			@media (max-width: 749px) {
				.hov-announce { font-size: 12px; letter-spacing: 0.3px; }
				.hov-promo-pill { font-size: 10px; padding: 2px 7px 2px 6px; }
			}
		</style>
		<script>
			(function(){
				var HOLD_MS = 5500;
				var FADE_MS = 550;
				/* Detect promo codes: ALL-CAPS letters + digits, length 5–14 */
				var PROMO_RE = /\b([A-Z]{3,10}\d{1,4})\b/g;

				function escapeHTML(s){
					return String(s)
						.replace(/&/g, '&amp;')
						.replace(/</g, '&lt;')
						.replace(/>/g, '&gt;')
						.replace(/"/g, '&quot;');
				}

				function formatMessage(msg){
					return escapeHTML(msg).replace(PROMO_RE, function(match){
						return '<span class="hov-promo-pill-wrap">' +
							'<button type="button" class="hov-promo-pill" data-code="' + match + '" aria-label="Copy code ' + match + '">' + match + '</button>' +
							'<span class="hov-promo-toast" aria-hidden="true">Code copied!</span>' +
						'</span>';
					});
				}

				function start(){
					var el = document.getElementById("announcementBarText");
					if (!el) return;
					var textHost = el.querySelector(".hov-announce-text") || el;
					var messages = [
						"🎁 Free Studs With Every Order — yours on us, no minimum",
						"👜 Free Jewellery Pouch when you buy 2+ pieces",
						"💎 VIYAVIP10 — flat 10% OFF | VIP code for our insiders",
						"🔁 REPEAT5 — flat 5% OFF on your return order above ₹999",
						"✨ WELCOME10 — new here? Enjoy 10% OFF on ₹1,499+"
					];
					var i = 0;
					var paused = false;

					function render(){ textHost.innerHTML = formatMessage(messages[i]); }
					render();

					/* Click-to-copy on promo pills */
					el.addEventListener("click", function(e){
						var pill = e.target.closest(".hov-promo-pill");
						if (!pill) return;
						var code = pill.getAttribute("data-code");
						var wrap = pill.closest(".hov-promo-pill-wrap");
						var copy = function(){
							if (navigator.clipboard && navigator.clipboard.writeText) {
								return navigator.clipboard.writeText(code);
							}
							var ta = document.createElement("textarea");
							ta.value = code; ta.style.position = "fixed"; ta.style.opacity = "0";
							document.body.appendChild(ta); ta.select();
							try { document.execCommand("copy"); } catch(e) {}
							document.body.removeChild(ta);
							return Promise.resolve();
						};
						copy().then(function(){
							pill.classList.add("is-copied");
							if (wrap) wrap.classList.add("is-showing");
							setTimeout(function(){
								pill.classList.remove("is-copied");
								if (wrap) wrap.classList.remove("is-showing");
							}, 1600);
						});
					});

					/* Pause rotation on hover (so the customer can actually read it) */
					el.addEventListener("mouseenter", function(){ paused = true; });
					el.addEventListener("mouseleave", function(){ paused = false; });

					setInterval(function(){
						if (paused) return;
						el.classList.add("is-fading");
						setTimeout(function(){
							i = (i + 1) % messages.length;
							render();
							el.classList.remove("is-fading");
						}, FADE_MS);
					}, HOLD_MS);
				}

				if (document.readyState === "loading") {
					document.addEventListener("DOMContentLoaded", start);
				} else { start(); }
			})();
		</script>
		{%- if settings.rightTxt != blank -%}
			<div class="header-social fl1 right-hdr tr{% if settings.rightTxt-mobile %} hide-sm hide-md{% else %} small--tc{% endif %}">
				{%- if settings.rightTxt contains "[social-icons]"-%}
					{% assign topRightTxt = settings.rightTxt | split: "[social-icons]" %}
					{{topRightTxt[0]}} {% render 'social-media' %} {{topRightTxt[1]}}
				{%- else -%}
					{{settings.rightTxt}}
				{%- endif -%}
			</div>
		{%- endif -%}
	</div>
</div>
{%- endif -%}

{% comment %}*** Main Header ***{% endcomment %}
{%- capture logo -%}
  	{%- capture logoWidth -%}{{ settings.logo_width | escape }}x{%- endcapture -%}
	<div class="header-logo">
		<a href="{{ routes.root_url }}" class="header-logo-link">
			{%- if settings.home_classic and template == 'index' and settings.logo_cl != blank -%}
				<img src="{{ settings.logo_cl | img_url: logoWidth }}" width="{{settings.logo_width}}" height="{{settings.logo_width | divided_by: settings.logo_cl.aspect_ratio | floor}}" class="cllogo" alt="{{ settings.logo_cl.alt | default: shop.name }}" srcset="{{ settings.logo_cl | img_url: logoWidth, scale: 2 }} 1x, {{ settings.logo_cl | img_url: logoWidth, scale: 4 }} 1.1x">
                <img src="{{ settings.logo | img_url: logoWidth }}" width="{{settings.logo_width}}" height="{{settings.logo_width | divided_by: settings.logo.aspect_ratio | floor}}" class="stlogo" alt="{{ settings.logo.alt | default: shop.name }}" srcset="{{ settings.logo | img_url: logoWidth, scale: 2 }} 1x, {{ settings.logo | img_url: logoWidth, scale: 4 }} 1.1x">
          	{%- elsif settings.logo != blank -%}
				<img src="{{ settings.logo | img_url: logoWidth }}" width="{{settings.logo_width}}" height="{{settings.logo_width | divided_by: settings.logo.aspect_ratio | floor}}" alt="{{ settings.logo.alt | default: shop.name }}" srcset="{{ settings.logo | img_url: logoWidth, scale: 1 }} 1x, {{ settings.logo | img_url: logoWidth, scale: 2 }} 2x">
			{%- else -%}
				{{ shop.name }}
			{%- endif -%}
		</a>
	</div>
{%- endcapture -%}
{%- capture textblock -%}
	{%- if settings.hdTxt-block contains "[social-icons]"-%}
		{%- assign headerTxt = settings.hdTxt-block | split: "[social-icons]" -%}
		{{headerTxt[0]}} {% render 'social-media' %} {{headerTxt[1]}}
	{%- else -%}
		{{ settings.hdTxt-block }}
	{%- endif -%}
{%- endcapture -%}
<div id="header" data-section-id="header" data-section-type="header-section" {% if settings.home_classic and template == "index" %}class="classic-style"{% endif %}>
		<header class="site-header fl f-aic {{settings.align_logo}}{% if settings.nav_below_logo %} nav-below{% endif %}{% if settings.main_header_fullwidth %} fullwidth{% else %} page-width{% endif %}">
			<div class="mobile-nav hide-lg">
				<a href="#" class="hdicon js-mobile-nav-toggle open" title="{{ 'layout.navigation.menu' | t }}"><i class="at at-bars-l" aria-hidden="true"></i></a>
				{% if settings.enable_search %}
              		<a href="{{ routes.search_url }}" class="hdicon searchIco" title="{{ 'general.search.tool_tip' | t }}"><i class="at at-search-l"></i></a>
                {% endif %}
			</div>
			{%- if settings.align_logo == "left" -%}{{logo}}{%- endif -%}
			{%- if settings.nav_below_logo -%}
				<div class="txtBlock hide-sm hide-md{% if settings.align_logo == "left" %} tc{% endif %}">{% render 'custom-search-bar' %}</div>
			{%- else -%}
				{{desktopnav}}
			{%- endif -%}
			{% if settings.align_logo == "center" %}{{logo}}{% endif %}
				<div class="icons-col fl f-jce f-aic">
                  	{% if settings.enable_search %}
						<a href="{{ routes.search_url }}" class="hdicon searchIco hide-sm hide-md" title="{{ 'general.search.tool_tip' | t }}"><i class="at at-search-l"></i></a>
                  	{% endif %}
                  
                   
                  	{% if shop.customer_accounts_enabled or settings.show_multiple_currencies or settings.show_language %}
					<a href="{{ routes.account_url }}" class="hdicon site-settings" title="{{ 'layout.header_settingbox.icon_tooltip' | t }}">
                     <i class="{{ settings.my_account_icn }}"></i>
                    </a> 
                  	{% endif %}
                    {% render 'customer-links' %}
                
                  
					{% if settings.enable_wishlist %}<a href="{{pages[settings.wishlist_page].url}}" class="hdicon wishlist hide-sm hide-md" title="{{ 'products.wishlist.title' | t }}"><i class="at at-heart-l"></i><span class="favCount hide">0</span></a>{% endif %}
					{%- unless settings.catalogmode -%}
                        <a href="{{ routes.cart_url }}" id="cartLink" class="hdicon{% if settings.ajax_cart %} header-cart{% endif %}" title="{{ 'layout.cart.title' | t }}">
                            <i class="at at-{{settings.icon_style}}"></i> <span id="CartCount" class="site-header__cart-count flo-cart-icon-bubble">{{ cart.item_count }}</span>
                        </a>
                    {%- endunless -%}
				</div>
		</header>
		{%- if settings.nav_below_logo -%}{{desktopnav}}{%- endif -%}
</div>
<div class="stickySpace"></div>
{%- if settings.snow_effect -%}</div>{%- endif -%}
{{mobilenav}}
{%- endcapture -%}
{{siteHeader | strip_newlines | remove: "  " | remove: "	" }}
{%- if template == 'index' -%}<h1 style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0">House of Viya – 925 Silver & Gold-Plated Jewellery Online India</h1>{%- endif -%}
