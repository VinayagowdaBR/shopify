{%- comment -%}
  Premium wishlist heart styling — overrides the default .btn.wishlist
  rendered by snippets/product-card-grid.liquid (+ list variant).

  States handled:
    .addto-wishlist           → not yet saved (outline heart .at-heart-l)
    .wishlist:not(.addto-wishlist) → already saved (filled heart .at-heart)
    .at-circle-notch-r       → mid-save spinner

  Loaded once globally from layout/theme.liquid.
{%- endcomment -%}

{% style %}
  .btn.wishlist {
    width: 38px !important;
    height: 38px !important;
    min-width: 38px !important;
    border-radius: 50% !important;
    background: rgba(255, 255, 255, 0.94) !important;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(232, 225, 216, 0.9) !important;
    color: #0F3B2E !important;
    padding: 0 !important;
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(15, 59, 46, 0.08);
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  .btn.wishlist:hover {
    background: #ffffff !important;
    color: #C8B28A !important;
    border-color: rgba(200, 178, 138, 0.6) !important;
    transform: scale(1.08);
    box-shadow: 0 4px 14px rgba(15, 59, 46, 0.14);
  }

  .btn.wishlist .at {
    font-size: 16px;
    line-height: 1;
    margin: 0 !important;
  }

  /* Saved state — emerald background, white heart */
  .btn.wishlist:not(.addto-wishlist):not(:has(.at-circle-notch-r)) {
    background: #0F3B2E !important;
    color: #ffffff !important;
    border-color: #0F3B2E !important;
  }
  .btn.wishlist:not(.addto-wishlist):hover {
    background: #C8B28A !important;
    color: #ffffff !important;
    border-color: #C8B28A !important;
  }
  .btn.wishlist:not(.addto-wishlist) .at-heart {
    animation: hovHeartPop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) 1;
  }

  @keyframes hovHeartPop {
    0%   { transform: scale(0.6); }
    50%  { transform: scale(1.28); }
    100% { transform: scale(1); }
  }

  /* In-progress save (spinner shown by theme.js mid-click) */
  .btn.wishlist .at-circle-notch-r,
  .btn.wishlist .at-spin {
    animation: hovHeartSpin 0.8s linear infinite;
  }
  @keyframes hovHeartSpin {
    to { transform: rotate(360deg); }
  }

  /* Hide the literal "Add to Wishlist" tooltip text inside the button —
     aria-label keeps it accessible to screen readers. */
  .btn.wishlist .tooltip-label {
    display: none;
  }

  /* Header wishlist count badge (.favCount) — match the cart bubble style.
     Anchor `.hdicon` is the parent <a>, the existing theme.css.liquid:698
     rule positions both #CartCount and .favCount absolute relative to it. */
  .hdicon { position: relative; }

  .favCount,
  #CartCount {
    position: absolute !important;
    top: -4px !important;
    right: -8px !important;
    background: #C8B28A !important;          /* gold to match brand */
    color: #ffffff !important;
    font-size: 10px !important;
    font-weight: 800 !important;
    letter-spacing: 0.2px;
    min-width: 18px !important;
    height: 18px !important;
    border-radius: 999px !important;
    padding: 0 5px;
    line-height: 18px !important;
    text-align: center;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
    border: 1.5px solid rgba(255, 255, 255, 0.9);
    box-sizing: border-box;
  }

  /* Critical: hide the "0" badge when the wishlist is empty.
     The HTML ships with class="favCount hide" — .hide must win. */
  .favCount.hide {
    display: none !important;
  }
{% endstyle %}
