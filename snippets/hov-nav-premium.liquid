{%- comment -%}
  Premium navigation styling — overrides the default theme nav rendered
  by sections/navigation.liquid + snippets/header.liquid.

  Adds:
   - Serif uppercase typography with elegant letter-spacing
   - Animated gold underline on hover / active state
   - Caret rotates 180° on hover
   - Soft cream dropdown panel with gold accent stripe
   - Premium dropdown item hover (gold sparkle prefix, slide-in)
   - Subtle scroll shadow on the header

  Loaded once globally from layout/theme.liquid.
{%- endcomment -%}

{% style %}
  /* ============================================================
     TOP-LEVEL MENU ITEMS
     ============================================================ */
  .siteNavigation > li.lvl1 > a {
    font-family: inherit !important;
    font-size: 12.5px !important;
    font-weight: 600 !important;
    letter-spacing: 2px !important;
    text-transform: uppercase;
    padding: 20px 22px !important;
    position: relative;
    display: inline-flex !important;
    align-items: center;
    gap: 7px;
    transition: color 0.3s ease;
  }

  /* Animated gold underline on hover */
  .siteNavigation > li.lvl1 > a::after {
    content: "";
    position: absolute;
    bottom: 12px;
    left: 22px;
    right: 22px;
    height: 1.5px;
    background: linear-gradient(90deg, transparent 0%, #C8B28A 50%, transparent 100%);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .siteNavigation > li.lvl1:hover > a::after,
  .siteNavigation > li.lvl1.active > a::after {
    transform: scaleX(1);
  }
  .siteNavigation > li.lvl1:hover > a {
    color: #C8B28A !important;
  }

  /* Caret rotation */
  .siteNavigation > li.lvl1 > a .at-angle-down-l {
    font-size: 9px;
    margin-left: 2px;
    transition: transform 0.35s ease;
    opacity: 0.75;
  }
  .siteNavigation > li.lvl1.parent:hover > a .at-angle-down-l {
    transform: rotate(-180deg);
    opacity: 1;
  }

  /* ============================================================
     DROPDOWN PANEL (simple sub-menu)
     ============================================================ */
  .siteNavigation li.lvl1.parent ul.subnav,
  .siteNavigation li.lvl1.parent > ul {
    background: #FAF7F2 !important;
    border: 1px solid #E8E1D8 !important;
    border-radius: 0 0 18px 18px !important;
    box-shadow: 0 18px 50px rgba(15, 59, 46, 0.14) !important;
    padding: 22px 18px !important;
    min-width: 240px;
    position: relative;
    overflow: hidden;
    margin-top: 0 !important;
  }
  .siteNavigation li.lvl1.parent ul.subnav::before,
  .siteNavigation li.lvl1.parent > ul::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 80px;
    height: 3px;
    background: linear-gradient(90deg, #C8B28A 0%, transparent 100%);
  }

  /* Dropdown items */
  .siteNavigation li.lvl1.parent ul li > a,
  .siteNavigation li.lvl1.parent .megamenu a {
    font-family: inherit !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    letter-spacing: 0.4px !important;
    color: #2E2E2E !important;
    padding: 10px 14px 10px 16px !important;
    border-radius: 8px;
    transition: background 0.25s ease, color 0.25s ease, padding 0.25s ease, transform 0.25s ease;
    position: relative;
    display: block !important;
    line-height: 1.45 !important;
  }
  .siteNavigation li.lvl1.parent ul li > a::before,
  .siteNavigation li.lvl1.parent .megamenu a::before {
    content: "✦";
    position: absolute;
    left: -2px;
    top: 50%;
    transform: translateY(-50%);
    color: #C8B28A;
    font-size: 12px;
    opacity: 0;
    transition: opacity 0.25s ease, left 0.25s ease;
  }
  .siteNavigation li.lvl1.parent ul li > a:hover,
  .siteNavigation li.lvl1.parent .megamenu a:hover {
    background: rgba(200, 178, 138, 0.12) !important;
    color: #0F3B2E !important;
    padding-left: 24px !important;
  }
  .siteNavigation li.lvl1.parent ul li > a:hover::before,
  .siteNavigation li.lvl1.parent .megamenu a:hover::before {
    opacity: 1;
    left: 6px;
  }

  /* ============================================================
     MEGA-MENU PANEL
     ============================================================ */
  .siteNavigation li.lvl1.parent .megamenu {
    background: #FAF7F2 !important;
    border: 1px solid #E8E1D8 !important;
    border-radius: 0 0 20px 20px !important;
    box-shadow: 0 22px 60px rgba(15, 59, 46, 0.16) !important;
    padding: 28px 32px !important;
    position: relative;
    overflow: hidden;
  }
  .siteNavigation li.lvl1.parent .megamenu::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 120px;
    height: 3px;
    background: linear-gradient(90deg, #C8B28A 0%, transparent 100%);
  }
  .siteNavigation li.lvl1.parent .megamenu .imageCol img {
    border-radius: 12px;
    transition: transform 0.4s ease;
  }
  .siteNavigation li.lvl1.parent .megamenu .imageCol:hover img {
    transform: scale(1.03);
  }
  .siteNavigation li.lvl1.parent .megamenu .imageCol .ttl {
    font-family: inherit !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    letter-spacing: 1.6px !important;
    color: #0F3B2E !important;
    margin-top: 10px;
    text-transform: uppercase;
  }

  /* ============================================================
     SMOOTH DROPDOWN REVEAL ANIMATION
     ============================================================ */
  .siteNavigation li.lvl1.parent ul.subnav,
  .siteNavigation li.lvl1.parent > ul,
  .siteNavigation li.lvl1.parent .megamenu {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.3s;
    visibility: hidden;
    pointer-events: none;
  }
  .siteNavigation li.lvl1.parent:hover > ul,
  .siteNavigation li.lvl1.parent:hover > ul.subnav,
  .siteNavigation li.lvl1.parent:hover .megamenu,
  .siteNavigation li.lvl1.parent:focus-within > ul,
  .siteNavigation li.lvl1.parent:focus-within .megamenu {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0s;
    visibility: visible;
    pointer-events: auto;
  }

  /* ============================================================
     RESPONSIVE — keep classy on smaller laptops
     ============================================================ */
  @media (max-width: 1199px) {
    .siteNavigation > li.lvl1 > a {
      padding: 18px 16px !important;
      letter-spacing: 2px !important;
      font-size: 12.5px !important;
    }
  }
{% endstyle %}
