<section
  id="curated-grid-{{ section.id }}"
  class="hov-curated-grid-section{% if section.settings.hide_desktop %} hide-desktop{% endif %}{% if section.settings.hide_mobile %} hide-mobile{% endif %}"
  style="
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_desktop }};
    margin: {{ section.settings.margin_desktop }};
  "
>
  <div class="hov-curated-inner">

    {% if section.settings.heading != blank %}
      <div class="hov-curated-heading-wrap">
        <h2 class="hov-curated-heading">{{ section.settings.heading }}</h2>

        {% if section.settings.show_line %}
          <div class="hov-curated-line">
            <span></span>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="hov-curated-scroll-wrap">
      <div class="hov-curated-pages">
        {% for block in section.blocks %}
          {% assign page_mod = forloop.index0 | modulo: 8 %}

          {% if page_mod == 0 %}
            <div class="hov-curated-page">
          {% endif %}

            <div class="hov-curated-item" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="hov-curated-link">
              {% endif %}

                {% if block.settings.image != blank %}
                  <div class="hov-curated-image-wrap">
                    <img
                      src="{{ block.settings.image | image_url: width: 600 }}"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                      alt="{{ block.settings.title | escape | default: 'Category' }}"
                      loading="lazy"
                      draggable="false"
                    >
                  </div>
                {% else %}
                  <div class="hov-curated-image-wrap hov-curated-placeholder">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                {% if block.settings.title != blank %}
                  <div class="hov-curated-title">{{ block.settings.title }}</div>
                {% endif %}

              {% if block.settings.link != blank %}
                </a>
              {% endif %}
            </div>

          {% if page_mod == 7 or forloop.last %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

  </div>
</section>

<style>
  @media (min-width: 769px) {
    #curated-grid-{{ section.id }}.hide-desktop {
      display: none !important;
    }
  }

  @media (max-width: 768px) {
    #curated-grid-{{ section.id }}.hide-mobile {
      display: none !important;
    }
  }

  #curated-grid-{{ section.id }} {
    width: 100%;
    box-sizing: border-box;
  }

  #curated-grid-{{ section.id }} * {
    box-sizing: border-box;
  }

  #curated-grid-{{ section.id }} .hov-curated-inner {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #curated-grid-{{ section.id }} .hov-curated-heading-wrap {
    text-align: center;
    margin-bottom: {{ section.settings.heading_bottom_gap }}px;
  }

  #curated-grid-{{ section.id }} .hov-curated-heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.12;
    letter-spacing: 0.2px;
  }

  #curated-grid-{{ section.id }} .hov-curated-line {
    width: {{ section.settings.line_width }}%;
    max-width: 190px;
    min-width: 105px;
    height: 12px;
    margin: 7px auto 0;
    position: relative;
  }

  #curated-grid-{{ section.id }} .hov-curated-line::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 5px;
    height: {{ section.settings.line_thickness }}px;
    background: {{ section.settings.line_color }};
  }

  #curated-grid-{{ section.id }} .hov-curated-line::after,
  #curated-grid-{{ section.id }} .hov-curated-line span::after {
    content: "";
    position: absolute;
    top: 1px;
    width: 9px;
    height: 9px;
    background: {{ section.settings.line_color }};
    transform: rotate(45deg);
  }

  #curated-grid-{{ section.id }} .hov-curated-line::after {
    left: -1px;
  }

  #curated-grid-{{ section.id }} .hov-curated-line span::after {
    right: -1px;
  }

  #curated-grid-{{ section.id }} .hov-curated-pages {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.row_gap }}px {{ section.settings.column_gap }}px;
  }

  #curated-grid-{{ section.id }} .hov-curated-page {
    display: contents;
  }

  #curated-grid-{{ section.id }} .hov-curated-item {
    text-align: center;
    min-width: 0;
  }

  #curated-grid-{{ section.id }} .hov-curated-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  #curated-grid-{{ section.id }} .hov-curated-image-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    background: #f7eee8;
  }

  #curated-grid-{{ section.id }} .hov-curated-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  #curated-grid-{{ section.id }} .hov-curated-link:hover img {
    transform: scale(1.04);
  }

  #curated-grid-{{ section.id }} .hov-curated-placeholder svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #curated-grid-{{ section.id }} .hov-curated-title {
    margin-top: {{ section.settings.title_top_gap }}px;
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size }}px;
    font-weight: {{ section.settings.title_weight }};
    line-height: 1.18;
    text-transform: {{ section.settings.title_case }};
    word-break: normal;
    overflow-wrap: anywhere;
    min-height: 2.4em;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    #curated-grid-{{ section.id }} {
      padding: {{ section.settings.padding_mobile }} !important;
      margin: {{ section.settings.margin_mobile }} !important;
    }

    #curated-grid-{{ section.id }} .hov-curated-heading-wrap {
      margin-bottom: {{ section.settings.mobile_heading_bottom_gap }}px;
    }

    #curated-grid-{{ section.id }} .hov-curated-heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
      line-height: 1.12;
      letter-spacing: 0.1px;
    }

    #curated-grid-{{ section.id }} .hov-curated-line {
      width: {{ section.settings.mobile_line_width }}%;
      min-width: 96px;
      max-width: 125px;
      height: 11px;
      margin-top: 6px;
    }

    #curated-grid-{{ section.id }} .hov-curated-line::before {
      top: 5px;
      height: {{ section.settings.line_thickness }}px;
    }

    #curated-grid-{{ section.id }} .hov-curated-line::after,
    #curated-grid-{{ section.id }} .hov-curated-line span::after {
      top: 1px;
      width: 8px;
      height: 8px;
    }

    #curated-grid-{{ section.id }} .hov-curated-scroll-wrap {
      width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    #curated-grid-{{ section.id }} .hov-curated-scroll-wrap::-webkit-scrollbar {
      display: none;
    }

    #curated-grid-{{ section.id }} .hov-curated-pages {
      display: flex;
      flex-wrap: nowrap;
      gap: 14px;
      width: max-content;
    }

    #curated-grid-{{ section.id }} .hov-curated-page {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(2, auto);
      gap: {{ section.settings.mobile_row_gap }}px {{ section.settings.mobile_column_gap }}px;
      width: calc(100vw - 24px);
      flex: 0 0 calc(100vw - 24px);
      scroll-snap-align: start;
    }

    #curated-grid-{{ section.id }} .hov-curated-item {
      min-width: 0;
      max-width: 100%;
    }

    #curated-grid-{{ section.id }} .hov-curated-image-wrap {
      border-radius: {{ section.settings.mobile_image_radius }}px;
    }

    #curated-grid-{{ section.id }} .hov-curated-title {
      margin-top: {{ section.settings.mobile_title_top_gap }}px;
      font-size: {{ section.settings.mobile_title_size }}px;
      line-height: 1.15;
      min-height: 2.4em;
      padding: 0 1px;
      overflow-wrap: break-word;
      word-break: normal;
    }
  }
</style>

{% schema %}
{
  "name": "Collection List 2",
  "settings": [
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curated for You"
    },
    {
      "type": "checkbox",
      "id": "show_line",
      "label": "Show decorative line",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#0F3B2E"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Category title color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 700,
      "max": 1400,
      "step": 50,
      "default": 1100
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size desktop",
      "min": 20,
      "max": 60,
      "step": 1,
      "default": 28
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Heading size mobile",
      "min": 18,
      "max": 44,
      "step": 1,
      "default": 22
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "default": "500",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "range",
      "id": "line_width",
      "label": "Line width desktop",
      "min": 12,
      "max": 80,
      "step": 1,
      "default": 22
    },
    {
      "type": "range",
      "id": "mobile_line_width",
      "label": "Line width mobile",
      "min": 15,
      "max": 90,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "line_thickness",
      "label": "Line thickness",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius desktop",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_image_radius",
      "label": "Image corner radius mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size desktop",
      "min": 14,
      "max": 36,
      "step": 1,
      "default": 28
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "label": "Title size mobile",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "default": "400",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "select",
      "id": "title_case",
      "label": "Title case",
      "default": "none",
      "options": [
        { "value": "none", "label": "Normal" },
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "capitalize", "label": "Capitalized" },
        { "value": "lowercase", "label": "lowercase" }
      ]
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap desktop",
      "min": 10,
      "max": 90,
      "step": 2,
      "default": 56
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row gap desktop",
      "min": 10,
      "max": 80,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_column_gap",
      "label": "Column gap mobile",
      "min": 4,
      "max": 30,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_row_gap",
      "label": "Row gap mobile",
      "min": 8,
      "max": 40,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "heading_bottom_gap",
      "label": "Heading bottom gap desktop",
      "min": 8,
      "max": 60,
      "step": 2,
      "default": 18
    },
    {
      "type": "range",
      "id": "mobile_heading_bottom_gap",
      "label": "Heading bottom gap mobile",
      "min": 8,
      "max": 50,
      "step": 2,
      "default": 14
    },
    {
      "type": "range",
      "id": "title_top_gap",
      "label": "Title top gap desktop",
      "min": 4,
      "max": 30,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_title_top_gap",
      "label": "Title top gap mobile",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 7
    },
    {
      "type": "text",
      "id": "padding_desktop",
      "label": "Section padding desktop",
      "default": "28px 12px 24px"
    },
    {
      "type": "text",
      "id": "margin_desktop",
      "label": "Section margin desktop",
      "default": "0"
    },
    {
      "type": "text",
      "id": "padding_mobile",
      "label": "Section padding mobile",
      "default": "18px 8px 8px"
    },
    {
      "type": "text",
      "id": "margin_mobile",
      "label": "Section margin mobile",
      "default": "0"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Collection item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Collection List 2",
      "blocks": [
        { "type": "item", "settings": { "title": "Chains" } },
        { "type": "item", "settings": { "title": "Mangalsutra" } },
        { "type": "item", "settings": { "title": "Hip Belts" } },
        { "type": "item", "settings": { "title": "Anklets" } },
        { "type": "item", "settings": { "title": "For Him" } },
        { "type": "item", "settings": { "title": "Bangles" } },
        { "type": "item", "settings": { "title": "Rings" } },
        { "type": "item", "settings": { "title": "Earrings" } }
      ]
    }
  ]
}
{% endschema %}