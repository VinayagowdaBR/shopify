{%- liquid
  assign s = section.settings
-%}
{%- if s.enabled -%}
<div id="hovSpin" class="hov-spin" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="hovSpinHeadline"
     data-delay="{{ s.delay | times: 1000 }}"
     data-exit-intent="{{ s.exit_intent }}">

  <div class="hov-spin__overlay" data-hov-close></div>

  <div class="hov-spin__card" role="document">
    <button type="button" class="hov-spin__close" aria-label="Close" data-hov-close>
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path d="M6 6 L18 18 M18 6 L6 18" stroke="#0F3D2E" stroke-width="2" stroke-linecap="round" fill="none"/>
      </svg>
    </button>

    <button type="button" class="hov-spin__mute" aria-label="Toggle sound" aria-pressed="false">
      <svg class="hov-spin__icon-sound" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path d="M3 9v6h4l5 4V5L7 9H3z M16 8a5 5 0 0 1 0 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      </svg>
      <svg class="hov-spin__icon-mute" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path d="M3 9v6h4l5 4V5L7 9H3z M16 9l5 6 M21 9l-5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      </svg>
    </button>

    <div class="hov-spin__grid">
      <!-- LEFT: Wheel -->
      <div class="hov-spin__wheel-side">
        <div class="hov-spin__wheel-wrap">
          <div class="hov-spin__pointer" aria-hidden="true">
            <svg viewBox="0 0 40 44" width="40" height="44">
              <defs>
                <linearGradient id="hovPtrGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#E8C87C"/>
                  <stop offset="50%" stop-color="#C9A961"/>
                  <stop offset="100%" stop-color="#8A6F33"/>
                </linearGradient>
              </defs>
              <path d="M20 40 L4 6 Q20 0 36 6 Z" fill="url(#hovPtrGrad)" stroke="#8A6F33" stroke-width="1"/>
            </svg>
          </div>

          <svg class="hov-spin__wheel" viewBox="0 0 400 400" aria-label="Prize wheel">
            <defs>
              <linearGradient id="hovGoldRing" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#E8C87C"/>
                <stop offset="50%" stop-color="#B8923F"/>
                <stop offset="100%" stop-color="#E8C87C"/>
              </linearGradient>
              <radialGradient id="hovHubGrad" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#1A4D3A"/>
                <stop offset="100%" stop-color="#0A2C20"/>
              </radialGradient>
              <filter id="hovWheelShadow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur in="SourceAlpha" stdDeviation="6"/>
                <feOffset dx="0" dy="4"/>
                <feComponentTransfer><feFuncA type="linear" slope="0.35"/></feComponentTransfer>
                <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
            </defs>

            <!-- Outer gold band (static) -->
            <circle cx="200" cy="200" r="198" fill="url(#hovGoldRing)" filter="url(#hovWheelShadow)"/>
            <circle cx="200" cy="200" r="184" fill="#0F3D2E"/>

            <!-- Rivets (static) -->
            <g class="hov-spin__rivets" fill="#7A5C26"></g>

            <!-- Rotating segments + labels -->
            <g class="hov-spin__rotor"></g>

            <!-- Center hub (static, always upright) -->
            <circle cx="200" cy="200" r="30" fill="url(#hovHubGrad)" stroke="url(#hovGoldRing)" stroke-width="2.5"/>
            <path class="hov-spin__hub-spark"
                  d="M200 182 L203 197 L218 200 L203 203 L200 218 L197 203 L182 200 L197 197 Z"
                  fill="#C9A961"/>
          </svg>
        </div>

        <form class="hov-spin__email-form" id="hovEmailForm" novalidate>
          <label class="hov-spin__email-label" for="hovEmailInput">Enter your email to unlock your spin</label>
          <div class="hov-spin__email-row">
            <input type="email" id="hovEmailInput" class="hov-spin__email-input"
                   placeholder="you@example.com" required autocomplete="email"
                   spellcheck="false" />
            <button type="submit" class="hov-spin__cta hov-spin__cta--unlock" id="hovUnlockBtn">
              <span class="hov-spin__cta-text">UNLOCK</span>
            </button>
          </div>
          <p class="hov-spin__email-error" id="hovEmailError" hidden>Please enter a valid email address.</p>
          <p class="hov-spin__email-consent">By entering your email, you agree to receive marketing from House of Viya. Unsubscribe anytime.</p>
        </form>

        <button type="button" class="hov-spin__cta hov-spin__cta--spin" id="hovSpinBtn" hidden>
          <span class="hov-spin__cta-text">SPIN THE WHEEL</span>
        </button>
      </div>

      <!-- RIGHT: Brand + result -->
      <div class="hov-spin__panel">
        <!-- Decorative scattered sparkles -->
        <span class="hov-spin__sparkle hov-spin__sparkle--1" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 2 L13.5 10.5 L22 12 L13.5 13.5 L12 22 L10.5 13.5 L2 12 L10.5 10.5 Z" fill="#C9A961"/></svg>
        </span>
        <span class="hov-spin__sparkle hov-spin__sparkle--2" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 2 L13.5 10.5 L22 12 L13.5 13.5 L12 22 L10.5 13.5 L2 12 L10.5 10.5 Z" fill="#C9A961"/></svg>
        </span>
        <span class="hov-spin__sparkle hov-spin__sparkle--3" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 2 L13.5 10.5 L22 12 L13.5 13.5 L12 22 L10.5 13.5 L2 12 L10.5 10.5 Z" fill="#C9A961"/></svg>
        </span>
        <span class="hov-spin__sparkle hov-spin__sparkle--4" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 2 L13.5 10.5 L22 12 L13.5 13.5 L12 22 L10.5 13.5 L2 12 L10.5 10.5 Z" fill="#C9A961"/></svg>
        </span>

        <div class="hov-spin__brand-block">
          <div class="hov-spin__brand-rule" aria-hidden="true">
            <span></span>
            <svg viewBox="0 0 24 24" width="12" height="12"><path d="M12 2 L13.5 10.5 L22 12 L13.5 13.5 L12 22 L10.5 13.5 L2 12 L10.5 10.5 Z" fill="#C9A961"/></svg>
            <span></span>
          </div>
          <div class="hov-spin__brand">HOUSE OF VIYA<sup>™</sup></div>
          <div class="hov-spin__tagline">Every piece has a story</div>
        </div>

        <h2 class="hov-spin__headline" id="hovSpinHeadline">EVERY SPIN<br/>HAS A STORY</h2>
        <p class="hov-spin__subtitle">Your next jewellery story begins with a little surprise.</p>

        <div class="hov-spin__result" id="hovResult" aria-live="polite" hidden>
          <span class="hov-spin__result-eyebrow">YOU UNLOCKED</span>
          <h3 class="hov-spin__prize" id="hovPrize"></h3>
          <div class="hov-spin__code-wrap" id="hovCodeWrap">
            <span class="hov-spin__code-label">YOUR CODE</span>
            <code class="hov-spin__code" id="hovCode"></code>
          </div>
          <button type="button" class="hov-spin__copy" id="hovCopy">
            <span class="hov-spin__copy-default">Copy Code</span>
            <span class="hov-spin__copy-done">Copied <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M5 12 L10 17 L20 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg></span>
          </button>
          <p class="hov-spin__fineprint">Code valid for 7 days. One use per customer.</p>
        </div>
      </div>
    </div>

    <!-- Confetti overlay -->
    <canvas class="hov-spin__confetti" aria-hidden="true"></canvas>
  </div>
</div>

<style>
  .hov-spin {
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
    box-sizing: border-box;
    font-family: 'Inter', 'Lato', system-ui, -apple-system, sans-serif;
    color: #0F3D2E;
  }
  .hov-spin.is-open { display: flex; }
  .hov-spin *, .hov-spin *::before, .hov-spin *::after { box-sizing: border-box; }

  .hov-spin__overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 30% 40%, rgba(201,169,97,0.12), transparent 60%),
      linear-gradient(135deg, rgba(15,61,46,0.96), rgba(10,44,32,0.98));
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .hov-spin__card {
    position: relative;
    width: min(96vw, 1180px);
    aspect-ratio: 16 / 9;
    max-height: 92vh;
    background: #F5EFE3;
    border: 1px solid rgba(201, 169, 97, 0.35);
    border-radius: 24px;
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(255, 255, 255, 0.04) inset;
    overflow: hidden;
    transform: translateY(20px) scale(0.96);
    opacity: 0;
    transition: transform 0.5s cubic-bezier(.21,1.02,.42,1.01), opacity 0.4s ease-out;
  }
  .hov-spin.is-open .hov-spin__card {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  /* Subtle radial cream gradient + faint hero photo wash */
  .hov-spin__card::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 75% 20%, rgba(201,169,97,0.08), transparent 55%),
      radial-gradient(ellipse at 0% 100%, rgba(15,61,46,0.04), transparent 60%);
    pointer-events: none;
  }

  .hov-spin__close,
  .hov-spin__mute {
    position: absolute;
    top: 18px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(15, 61, 46, 0.12);
    background: #FFFFFF;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    z-index: 6;
    color: #0F3D2E;
    box-shadow: 0 6px 16px rgba(15, 61, 46, 0.12);
    transition: transform 0.25s ease, background 0.2s ease;
  }
  .hov-spin__close { right: 18px; }
  .hov-spin__mute  { right: 64px; }
  .hov-spin__close:hover { transform: rotate(90deg); }
  .hov-spin__mute:hover  { transform: scale(1.06); }

  .hov-spin__mute .hov-spin__icon-mute { display: none; }
  .hov-spin__mute[aria-pressed="true"] .hov-spin__icon-sound { display: none; }
  .hov-spin__mute[aria-pressed="true"] .hov-spin__icon-mute  { display: block; }

  .hov-spin__grid {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
  }

  /* ============== WHEEL SIDE ============== */
  .hov-spin__wheel-side {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    padding: 36px 28px;
  }

  .hov-spin__wheel-wrap {
    position: relative;
    width: min(78%, 460px);
    aspect-ratio: 1 / 1;
  }

  .hov-spin__pointer {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    width: 40px;
    height: 44px;
    z-index: 4;
    filter: drop-shadow(0 4px 6px rgba(0,0,0,0.28));
    transform-origin: 50% 0%;
    will-change: transform;
  }
  /* When the wheel ticks past a segment edge, the JS toggles this class for ~120ms */
  .hov-spin__pointer.is-tick {
    /* visual reinforcement; transform itself is driven by JS each frame */
  }

  .hov-spin__wheel {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* The rotor is the only thing that animates each frame.
     SVG `transform` attribute is set via setAttribute so cross-browser SVG quirks
     (transform-box: fill-box) don't trip us up. will-change is still a hint. */
  .hov-spin__rotor {
    will-change: transform;
  }

  .hov-spin__hub-spark {
    transform-origin: 200px 200px;
    animation: hovHubSparkle 4s ease-in-out infinite;
  }
  @keyframes hovHubSparkle {
    0%, 100% { transform: rotate(0deg) scale(1); opacity: 1; }
    50%      { transform: rotate(45deg) scale(1.08); opacity: 0.85; }
  }

  .hov-spin__cta {
    appearance: none;
    border: none;
    cursor: pointer;
    padding: 14px 36px;
    border-radius: 999px;
    background: linear-gradient(135deg, #E8C87C, #C9A961 55%, #B8923F);
    color: #0F3D2E;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 4px;
    text-transform: uppercase;
    box-shadow: 0 10px 24px rgba(184, 146, 63, 0.35), inset 0 1px 0 rgba(255,255,255,0.5);
    transition: transform 0.2s ease, box-shadow 0.25s ease, opacity 0.3s ease;
    position: relative;
  }
  .hov-spin__cta:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 14px 28px rgba(184, 146, 63, 0.45), inset 0 1px 0 rgba(255,255,255,0.5);
  }
  .hov-spin__cta:active:not(:disabled) { transform: translateY(0); }
  .hov-spin__cta:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .hov-spin.is-spinning .hov-spin__cta-text::after {
    content: "…";
    margin-left: 4px;
  }
  .hov-spin.is-result .hov-spin__cta { display: none; }

  /* ============== EMAIL GATE ============== */
  .hov-spin__email-form {
    width: min(100%, 380px);
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
  }
  .hov-spin.is-unlocked .hov-spin__email-form,
  .hov-spin.is-spinning .hov-spin__email-form,
  .hov-spin.is-result .hov-spin__email-form { display: none; }

  .hov-spin__email-label {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #0F3D2E;
    text-align: center;
    margin-bottom: 2px;
  }
  .hov-spin__email-row {
    display: flex;
    align-items: stretch;
    gap: 8px;
    background: #FFFFFF;
    border: 1px solid rgba(201, 169, 97, 0.55);
    border-radius: 999px;
    padding: 4px 4px 4px 18px;
    box-shadow: 0 6px 18px rgba(15, 61, 46, 0.08);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .hov-spin__email-row:focus-within {
    border-color: #C9A961;
    box-shadow: 0 6px 18px rgba(184, 146, 63, 0.25);
  }
  .hov-spin__email-form.is-invalid .hov-spin__email-row {
    border-color: #B94A3B;
    box-shadow: 0 6px 18px rgba(185, 74, 59, 0.18);
  }
  .hov-spin__email-input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    font-family: 'Inter', 'Lato', sans-serif;
    font-size: 14px;
    color: #0F3D2E;
    padding: 8px 0;
  }
  .hov-spin__email-input::placeholder { color: rgba(15, 61, 46, 0.4); }

  .hov-spin__cta--unlock {
    padding: 10px 22px;
    font-size: 12px;
    letter-spacing: 3px;
    flex: 0 0 auto;
  }

  .hov-spin__email-error {
    margin: 0;
    font-size: 12px;
    color: #B94A3B;
    text-align: center;
    letter-spacing: 0.3px;
  }
  .hov-spin__email-consent {
    margin: 2px 0 0;
    font-size: 11px;
    line-height: 1.45;
    color: rgba(15, 61, 46, 0.55);
    text-align: center;
    letter-spacing: 0.2px;
  }

  /* ============== RIGHT PANEL ============== */
  .hov-spin__panel {
    position: relative;
    height: 100%;
    padding: 56px 56px 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  .hov-spin__sparkle {
    position: absolute;
    pointer-events: none;
    opacity: 0.35;
    animation: hovSparkle 3.6s ease-in-out infinite;
  }
  .hov-spin__sparkle svg { width: 100%; height: 100%; display: block; }
  .hov-spin__sparkle--1 { top: 8%;  right: 14%; width: 18px; height: 18px; animation-delay: 0s; }
  .hov-spin__sparkle--2 { top: 22%; right: 6%;  width: 12px; height: 12px; animation-delay: 1.1s; opacity: 0.28; }
  .hov-spin__sparkle--3 { bottom: 18%; right: 10%; width: 14px; height: 14px; animation-delay: 2.2s; }
  .hov-spin__sparkle--4 { bottom: 8%;  left: 8%;   width: 16px; height: 16px; animation-delay: 0.6s; opacity: 0.25; }
  @keyframes hovSparkle {
    0%, 100% { opacity: 0.15; transform: scale(0.85) rotate(0deg); }
    50%      { opacity: 0.55; transform: scale(1.1)  rotate(45deg); }
  }

  .hov-spin__brand-block {
    margin-bottom: 22px;
  }
  .hov-spin__brand-rule {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  .hov-spin__brand-rule span {
    flex: 0 0 32px;
    height: 1px;
    background: linear-gradient(90deg, transparent, #C9A961, transparent);
  }
  .hov-spin__brand {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 14px;
    letter-spacing: 6px;
    color: #0F3D2E;
    font-weight: 500;
  }
  .hov-spin__brand sup { font-size: 9px; letter-spacing: 0; vertical-align: super; }
  .hov-spin__tagline {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: 12px;
    color: rgba(15,61,46,0.6);
    letter-spacing: 1px;
    margin-top: 4px;
  }

  .hov-spin__headline {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(34px, 4.6vw, 56px);
    line-height: 1.02;
    letter-spacing: 1px;
    margin: 0 0 14px;
    color: #0F3D2E;
  }
  .hov-spin__subtitle {
    font-size: 14px;
    line-height: 1.55;
    color: rgba(15,61,46,0.7);
    max-width: 36ch;
    margin: 0 0 20px;
  }

  /* ----- Result card ----- */
  .hov-spin__result {
    margin-top: 6px;
    padding: 22px 24px 20px;
    background: rgba(255,255,255,0.65);
    border: 1px solid rgba(201, 169, 97, 0.45);
    border-radius: 14px;
    box-shadow: 0 14px 30px rgba(15, 61, 46, 0.08);
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.55s ease, transform 0.55s cubic-bezier(.21,1.02,.42,1.01);
  }
  .hov-spin.is-result .hov-spin__result {
    opacity: 1;
    transform: translateY(0);
  }
  .hov-spin__result[hidden] { display: none; }
  .hov-spin.is-result .hov-spin__result[hidden] { display: block; }

  .hov-spin__result-eyebrow {
    display: block;
    font-size: 10px;
    letter-spacing: 3.5px;
    color: #B8923F;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .hov-spin__prize {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.1;
    color: #0F3D2E;
    margin: 0 0 14px;
    letter-spacing: 0.5px;
  }
  .hov-spin__code-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    background: rgba(15, 61, 46, 0.04);
    border: 1px dashed rgba(201, 169, 97, 0.6);
    border-radius: 10px;
    margin-bottom: 12px;
  }
  .hov-spin__code-label {
    font-size: 10px;
    letter-spacing: 2.5px;
    color: rgba(15,61,46,0.55);
    font-weight: 600;
  }
  .hov-spin__code {
    font-family: 'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 2px;
    color: #0F3D2E;
  }
  .hov-spin__copy {
    appearance: none;
    width: 100%;
    padding: 13px 18px;
    border-radius: 10px;
    background: #0F3D2E;
    color: #F5EFE3;
    border: 1px solid #C9A961;
    cursor: pointer;
    font-family: 'Inter', 'Lato', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    transition: background 0.25s, color 0.25s, transform 0.15s;
  }
  .hov-spin__copy:hover { background: #144837; transform: translateY(-1px); }
  .hov-spin__copy:active { transform: translateY(0); }
  .hov-spin__copy .hov-spin__copy-done {
    display: none;
    align-items: center;
    gap: 6px;
    justify-content: center;
  }
  .hov-spin__copy.is-copied { background: #1A4D3A; }
  .hov-spin__copy.is-copied .hov-spin__copy-default { display: none; }
  .hov-spin__copy.is-copied .hov-spin__copy-done    { display: inline-flex; }

  .hov-spin__fineprint {
    margin: 12px 0 0;
    font-size: 11px;
    color: rgba(15,61,46,0.55);
    letter-spacing: 0.3px;
  }

  /* Try-Again variant */
  .hov-spin__result.is-tryagain .hov-spin__code-wrap { display: none; }
  .hov-spin__result.is-tryagain .hov-spin__copy { background: transparent; color: #0F3D2E; }
  .hov-spin__result.is-tryagain .hov-spin__copy:hover { background: rgba(15,61,46,0.06); }

  .hov-spin__confetti {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
  }

  /* ============== Mobile ============== */
  @media (max-width: 900px) {
    .hov-spin { padding: 12px; }
    .hov-spin__card {
      aspect-ratio: auto;
      width: 100%;
      max-height: 96vh;
      overflow-y: auto;
    }
    .hov-spin__grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
    }
    .hov-spin__wheel-side {
      padding: 56px 20px 16px;
      gap: 18px;
    }
    .hov-spin__wheel-wrap { width: min(80vw, 360px); }
    .hov-spin__panel {
      padding: 8px 26px 32px;
      text-align: center;
      align-items: center;
    }
    .hov-spin__brand-rule { justify-content: center; }
    .hov-spin__subtitle { margin-left: auto; margin-right: auto; }
    .hov-spin__close { top: 12px; right: 12px; }
    .hov-spin__mute  { top: 12px; right: 56px; }
  }
  @media (max-width: 480px) {
    .hov-spin__headline { font-size: 32px; }
    .hov-spin__prize { font-size: 22px; }
    .hov-spin__panel { padding: 8px 18px 24px; }
    .hov-spin__cta { padding: 12px 28px; font-size: 12px; letter-spacing: 3px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hov-spin__sparkle,
    .hov-spin__hub-spark { animation: none !important; }
  }
</style>

<script>
(function () {
  'use strict';

  // ============================================================
  //  House of Viya — Spin Wheel (RAF + cubic-bezier)
  // ============================================================
  //  Why a custom RAF loop instead of CSS `transition: transform`?
  //  CSS transitions on `transform` of a heavy element get throttled
  //  during layout/paint; the result is a visible micro-stutter near
  //  the end of the spin (when frame budget is most precious because
  //  the eye is tracking the deceleration). We drive the rotation
  //  ourselves via requestAnimationFrame, evaluating a parametric
  //  cubic-bezier ease on each frame. This guarantees:
  //    - sub-pixel float precision (no `Math.round`)
  //    - a stable 60fps because we mutate exactly one attribute
  //    - control over a tiny landing overshoot bounce
  //    - per-frame side effects (pointer wiggle, tick sound)
  //  Easing (0.17, 0.67, 0.12, 0.99): fast head-start, very long
  //  graceful tail — feels like a real prize wheel coasting to rest.
  // ============================================================

  var STORAGE_KEY = 'hov_spin_v1';
  var FORCE = /[?&](spin|stw)=1\b/.test(window.location.search) || window.location.hash === '#spin';

  // Prize table — order MUST match the visual segment order (clockwise from 12 o'clock)
  var PRIZES = [
    { label: 'Buy 2 at 45% Off', code: 'STORY45',  fill: '#C9A961', text: '#0F3D2E', win: true  },
    { label: 'Buy 3 at 55% Off', code: 'STORY55',  fill: '#1A4D3A', text: '#D4AF6A', win: true  },
    { label: 'Flat ₹400 Off', code: 'STORY400', fill: '#C9A961', text: '#0F3D2E', win: true  },
    { label: 'Flat ₹200 Off', code: 'STORY200', fill: '#1A4D3A', text: '#D4AF6A', win: true  },
    { label: 'Mystery Gift',     code: 'MYSTERY',  fill: '#C9A961', text: '#0F3D2E', win: true  },
    { label: 'Try Again',        code: '',         fill: '#1A4D3A', text: '#D4AF6A', win: false }
  ];
  var SEGMENT_ANGLE = 360 / PRIZES.length; // 60°

  function readState() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; }
    catch (e) { return {}; }
  }
  function writeState(patch) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(Object.assign(readState(), patch))); }
    catch (e) {}
  }
  function alreadyPlayed() {
    if (FORCE) return false;
    return readState().played === true;
  }
  function markPlayed(idx) {
    if (FORCE) return;
    writeState({ played: true, idx: idx, ts: Date.now() });
  }
  window.HOV_SPIN_RESET = function () {
    try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
    location.reload();
  };

  // ---------- Cubic Bezier (parametric, Newton-Raphson invert) ----------
  function bezier(p1x, p1y, p2x, p2y) {
    // Bezier curve: B(t) = 3(1-t)²t·P1 + 3(1-t)t²·P2 + t³·P3, with P0=(0,0), P3=(1,1)
    // x(t) = ax·t³ + bx·t² + cx·t      where cx=3p1x, bx=3(p2x-p1x)-cx, ax=1-cx-bx
    var cx = 3 * p1x, bx = 3 * (p2x - p1x) - cx, ax = 1 - cx - bx;
    var cy = 3 * p1y, by = 3 * (p2y - p1y) - cy, ay = 1 - cy - by;
    function sampleX(t) { return ((ax * t + bx) * t + cx) * t; }
    function sampleY(t) { return ((ay * t + by) * t + cy) * t; }
    function sampleDX(t) { return (3 * ax * t + 2 * bx) * t + cx; }
    function solveX(x) {
      var t = x;
      // Newton-Raphson — converges in 4 iterations for typical curves
      for (var i = 0; i < 8; i++) {
        var fx = sampleX(t) - x;
        if (Math.abs(fx) < 1e-7) return t;
        var dx = sampleDX(t);
        if (Math.abs(dx) < 1e-7) break;
        t -= fx / dx;
      }
      // Bisection fallback for the rare ill-conditioned case
      var lo = 0, hi = 1, mid = t;
      for (var j = 0; j < 24; j++) {
        var sx = sampleX(mid);
        if (Math.abs(sx - x) < 1e-7) return mid;
        if (sx < x) lo = mid; else hi = mid;
        mid = (lo + hi) / 2;
      }
      return mid;
    }
    return function (x) {
      if (x <= 0) return 0;
      if (x >= 1) return 1;
      return sampleY(solveX(x));
    };
  }
  var EASE = bezier(0.17, 0.67, 0.12, 0.99);

  function ready(fn) {
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn);
    else fn();
  }

  ready(function () {
    var root = document.getElementById('hovSpin');
    if (!root) return;
    if (alreadyPlayed()) return;

    var card        = root.querySelector('.hov-spin__card');
    var wheelSvg    = root.querySelector('.hov-spin__wheel');
    var rotor       = root.querySelector('.hov-spin__rotor');
    var rivets      = root.querySelector('.hov-spin__rivets');
    var pointer     = root.querySelector('.hov-spin__pointer');
    var spinBtn     = root.querySelector('#hovSpinBtn');
    var emailForm   = root.querySelector('#hovEmailForm');
    var emailInput  = root.querySelector('#hovEmailInput');
    var emailError  = root.querySelector('#hovEmailError');
    var resultBox   = root.querySelector('#hovResult');
    var prizeEl     = root.querySelector('#hovPrize');
    var codeWrap    = root.querySelector('#hovCodeWrap');
    var codeEl      = root.querySelector('#hovCode');
    var copyBtn     = root.querySelector('#hovCopy');
    var copyDefault = copyBtn.querySelector('.hov-spin__copy-default');
    var muteBtn     = root.querySelector('.hov-spin__mute');
    var confettiCv  = root.querySelector('.hov-spin__confetti');

    // ---------- Email gate ----------
    // RFC-5322-lite: good enough to catch typos without rejecting valid edge cases.
    var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    var unlocked = false;

    function showEmailError(msg) {
      emailError.textContent = msg;
      emailError.hidden = false;
      emailForm.classList.add('is-invalid');
    }
    function clearEmailError() {
      emailError.hidden = true;
      emailForm.classList.remove('is-invalid');
    }
    emailInput.addEventListener('input', clearEmailError);

    emailForm.addEventListener('submit', function (e) {
      e.preventDefault();
      if (unlocked) return;
      var value = (emailInput.value || '').trim();
      if (!value) { showEmailError('Please enter your email to continue.'); emailInput.focus(); return; }
      if (!EMAIL_RE.test(value)) { showEmailError('Please enter a valid email address.'); emailInput.focus(); return; }

      // Persist the email locally — wire this to a backend (Shopify customer
      // create / Klaviyo / Mailchimp) when the merchant is ready.
      writeState({ email: value, emailTs: Date.now() });

      unlocked = true;
      root.classList.add('is-unlocked');
      spinBtn.hidden = false;
      // Give the swap a beat before drawing focus, so screen readers announce it.
      setTimeout(function () { spinBtn.focus(); }, 50);
    });

    // ---------- Render the wheel SVG (segments + labels + rivets) ----------
    function pt(angleDeg, radius) {
      var a = angleDeg * Math.PI / 180;
      return { x: 200 + radius * Math.sin(a), y: 200 - radius * Math.cos(a) };
    }
    function svgEl(name, attrs) {
      var el = document.createElementNS('http://www.w3.org/2000/svg', name);
      for (var k in attrs) el.setAttribute(k, attrs[k]);
      return el;
    }

    var SEG_R = 184;
    for (var i = 0; i < PRIZES.length; i++) {
      var p = PRIZES[i];
      var a1 = i * SEGMENT_ANGLE;
      var a2 = (i + 1) * SEGMENT_ANGLE;
      var p1 = pt(a1, SEG_R);
      var p2 = pt(a2, SEG_R);
      var d = 'M 200 200 L ' + p1.x.toFixed(2) + ' ' + p1.y.toFixed(2) +
              ' A ' + SEG_R + ' ' + SEG_R + ' 0 0 1 ' + p2.x.toFixed(2) + ' ' + p2.y.toFixed(2) + ' Z';
      rotor.appendChild(svgEl('path', {
        d: d,
        fill: p.fill,
        stroke: 'rgba(245,239,227,0.18)',
        'stroke-width': '1'
      }));

      // Label group rotated to segment bisector — text sits near the rim, reads outward
      var center = i * SEGMENT_ANGLE + SEGMENT_ANGLE / 2;
      var lblG = svgEl('g', { transform: 'rotate(' + center + ' 200 200)' });
      var words = p.label.split(' ');
      var lines = [];
      // Greedy 2-line wrap targeting roughly equal halves
      if (words.length <= 2) {
        lines = [p.label];
      } else {
        var mid = Math.ceil(words.length / 2);
        lines = [words.slice(0, mid).join(' '), words.slice(mid).join(' ')];
      }
      var lh = 18;
      var startY = 200 - SEG_R * 0.62 - ((lines.length - 1) * lh) / 2;
      for (var j = 0; j < lines.length; j++) {
        var t = svgEl('text', {
          x: '200',
          y: (startY + j * lh).toFixed(1),
          'text-anchor': 'middle',
          'dominant-baseline': 'middle',
          fill: p.text,
          'font-family': "'Playfair Display', Georgia, serif",
          'font-size': '14',
          'font-weight': '600',
          'letter-spacing': '0.5'
        });
        t.textContent = lines[j];
        lblG.appendChild(t);
      }
      rotor.appendChild(lblG);
    }

    // 12 rivets evenly spaced around the band (radius 191, mid-band)
    for (var k = 0; k < 12; k++) {
      var ra = (k * 30) * Math.PI / 180;
      var rx = 200 + 191 * Math.sin(ra);
      var ry = 200 - 191 * Math.cos(ra);
      rivets.appendChild(svgEl('circle', { cx: rx.toFixed(2), cy: ry.toFixed(2), r: '2.4', fill: '#7A5C26' }));
    }

    // Initial rotation — render segment 0 centered under pointer at rest
    var currentRotation = 0;
    rotor.setAttribute('transform', 'rotate(0 200 200)');

    // ---------- Modal open/close ----------
    function openModal() {
      if (alreadyPlayed()) return;
      root.classList.add('is-open');
      root.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      root.classList.remove('is-open');
      root.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    var delay = parseInt(root.dataset.delay, 10) || 0;
    var openTimer = setTimeout(openModal, delay);

    if (root.dataset.exitIntent === 'true') {
      var exitFired = false;
      document.addEventListener('mouseout', function (e) {
        if (exitFired || alreadyPlayed()) return;
        if (e.clientY <= 0 && !e.relatedTarget) {
          exitFired = true;
          clearTimeout(openTimer);
          openModal();
        }
      });
    }

    Array.prototype.forEach.call(root.querySelectorAll('[data-hov-close]'), function (el) {
      el.addEventListener('click', closeModal);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && root.classList.contains('is-open')) closeModal();
    });

    // ---------- Sound (Web Audio synth tick) ----------
    var muted = false;
    var audioCtx = null;
    function playTick() {
      if (muted) return;
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        var t0 = audioCtx.currentTime;
        var osc = audioCtx.createOscillator();
        var gain = audioCtx.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(1200, t0);
        osc.frequency.exponentialRampToValueAtTime(700, t0 + 0.05);
        gain.gain.setValueAtTime(0.05, t0);
        gain.gain.exponentialRampToValueAtTime(0.0001, t0 + 0.06);
        osc.connect(gain).connect(audioCtx.destination);
        osc.start(t0);
        osc.stop(t0 + 0.07);
      } catch (e) { /* no-op */ }
    }
    muteBtn.addEventListener('click', function () {
      muted = !muted;
      muteBtn.setAttribute('aria-pressed', muted ? 'true' : 'false');
    });

    // ---------- Pointer wiggle on segment crossing ----------
    var wiggleStart = 0;
    var WIGGLE_MS = 110;
    function triggerWiggle() {
      wiggleStart = performance.now();
    }
    function pointerWiggleAt(now) {
      var dt = now - wiggleStart;
      if (dt < 0 || dt > WIGGLE_MS) return 0;
      // Half-sine envelope, peak ~5° rotation
      var phase = dt / WIGGLE_MS;
      return Math.sin(phase * Math.PI) * 5;
    }

    function segmentUnderPointer(rotationDeg) {
      // Wheel-angle currently under the (top) pointer: -rotationDeg mod 360
      var a = ((-rotationDeg) % 360 + 360) % 360;
      return Math.floor(a / SEGMENT_ANGLE) % PRIZES.length;
    }

    // ---------- Spin animation ----------
    var spinning = false;
    var SPIN_MS = 4500;       // main spin; +350ms bounce → ~4.85s total, in 4.5–5s window
    var FULL_ROTATIONS = 5;
    var OVERSHOOT_DEG = 3;

    function pickWinner() {
      // Uniform random across all segments. Flip this to a weighted table
      // if you want to bias outcomes (e.g. lower 'Try Again' probability).
      return Math.floor(Math.random() * PRIZES.length);
    }

    function spin() {
      if (spinning || alreadyPlayed()) return;
      if (!unlocked) { emailInput && emailInput.focus(); return; }
      spinning = true;
      root.classList.add('is-spinning');
      spinBtn.disabled = true;

      var winningIdx = pickWinner();
      // Land winningIdx centered under the pointer.
      // Position of segment i's center after rotation R: (i*60 + 30 + R) mod 360.
      // We want this ≡ 0 (mod 360), so R ≡ -i*60 - 30 (mod 360).
      var landingOffset = (360 - SEGMENT_ANGLE * winningIdx - SEGMENT_ANGLE / 2);
      var targetRotation = FULL_ROTATIONS * 360 + landingOffset;

      var startTs = 0;
      var prevSeg = segmentUnderPointer(currentRotation);

      function frame(now) {
        if (!startTs) startTs = now;
        var t = Math.min((now - startTs) / SPIN_MS, 1);
        var eased = EASE(t);
        var rot = currentRotation + (targetRotation - currentRotation) * eased; // float, never rounded

        // Detect segment crossings during the slow phase — gives the pointer
        // its little "tick-tick-tick" as the wheel coasts past edges.
        var segNow = segmentUnderPointer(rot);
        if (segNow !== prevSeg && t > 0.25) {
          triggerWiggle();
          playTick();
        }
        prevSeg = segNow;

        var wiggleDeg = pointerWiggleAt(now);
        pointer.style.transform = 'translateX(-50%) rotate(' + (-wiggleDeg).toFixed(3) + 'deg)';

        rotor.setAttribute('transform', 'rotate(' + rot.toFixed(4) + ' 200 200)');

        if (t < 1) {
          requestAnimationFrame(frame);
        } else {
          landingBounce(targetRotation, winningIdx);
        }
      }
      requestAnimationFrame(frame);
    }

    function landingBounce(target, winningIdx) {
      // Tiny overshoot: rotate +OVERSHOOT_DEG past target, then settle back.
      // Using two-phase ease (ease-out, then smooth-in) keeps the bounce gentle.
      var T1 = 130, T2 = 220;
      var startTs = 0;
      function smoothstep(x) { return x * x * (3 - 2 * x); }

      function frame(now) {
        if (!startTs) startTs = now;
        var elapsed = now - startTs;
        var rot;
        if (elapsed < T1) {
          var u = elapsed / T1;
          rot = target + OVERSHOOT_DEG * (1 - Math.pow(1 - u, 3));
        } else if (elapsed < T1 + T2) {
          var v = (elapsed - T1) / T2;
          rot = target + OVERSHOOT_DEG * (1 - smoothstep(v));
        } else {
          rot = target;
          rotor.setAttribute('transform', 'rotate(' + rot.toFixed(4) + ' 200 200)');
          pointer.style.transform = 'translateX(-50%) rotate(0deg)';
          currentRotation = rot;
          onSpinComplete(winningIdx);
          return;
        }
        rotor.setAttribute('transform', 'rotate(' + rot.toFixed(4) + ' 200 200)');
        var wd = pointerWiggleAt(now);
        pointer.style.transform = 'translateX(-50%) rotate(' + (-wd).toFixed(3) + 'deg)';
        requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    }

    function onSpinComplete(idx) {
      var prize = PRIZES[idx];
      markPlayed(idx);
      spinning = false;
      root.classList.remove('is-spinning');
      root.classList.add('is-result');

      resultBox.hidden = false;
      if (prize.win) {
        resultBox.classList.remove('is-tryagain');
        prizeEl.textContent = prize.label.toUpperCase() + '!';
        codeEl.textContent = prize.code;
        codeWrap.style.display = '';
        copyDefault.textContent = 'Copy Code';
        copyBtn.onclick = doCopy;
        // Confetti only for wins
        fireConfetti();
      } else {
        resultBox.classList.add('is-tryagain');
        prizeEl.textContent = 'Better luck next time';
        codeWrap.style.display = 'none';
        copyDefault.textContent = 'Close';
        copyBtn.onclick = closeModal;
      }
    }

    function doCopy() {
      var code = codeEl.textContent;
      if (!code) return;
      var done = function () {
        copyBtn.classList.add('is-copied');
        setTimeout(function () { copyBtn.classList.remove('is-copied'); }, 2000);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(code).then(done, function () {
          fallbackCopy(code); done();
        });
      } else {
        fallbackCopy(code); done();
      }
    }
    function fallbackCopy(text) {
      try {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      } catch (e) {}
    }

    spinBtn.addEventListener('click', spin);

    // ---------- Confetti (gold-only, small particles) ----------
    function fireConfetti() {
      var rect = card.getBoundingClientRect();
      var dpr = window.devicePixelRatio || 1;
      confettiCv.width = rect.width * dpr;
      confettiCv.height = rect.height * dpr;
      confettiCv.style.width = rect.width + 'px';
      confettiCv.style.height = rect.height + 'px';
      var ctx = confettiCv.getContext('2d');
      ctx.scale(dpr, dpr);

      var colors = ['#C9A961', '#E8C87C', '#B8923F', '#D4AF6A'];
      var particles = [];
      // Burst originates from above the right panel's headline area
      var ox = rect.width * 0.72;
      var oy = rect.height * 0.30;
      for (var i = 0; i < 48; i++) {
        var ang = (Math.random() * Math.PI) - Math.PI / 2;          // upward fan
        var spd = 4 + Math.random() * 7;
        particles.push({
          x: ox + (Math.random() - 0.5) * 40,
          y: oy,
          vx: Math.cos(ang) * spd * (Math.random() < 0.5 ? -1 : 1),
          vy: Math.sin(ang) * spd - 2,
          r: 2 + Math.random() * 3,
          color: colors[Math.floor(Math.random() * colors.length)],
          rot: Math.random() * Math.PI * 2,
          spin: (Math.random() - 0.5) * 0.35,
          life: 1
        });
      }
      var start = performance.now();
      var DURATION = 1700;
      function step(now) {
        var elapsed = now - start;
        ctx.clearRect(0, 0, rect.width, rect.height);
        for (var i = 0; i < particles.length; i++) {
          var p = particles[i];
          p.vy += 0.22;     // gravity
          p.vx *= 0.995;    // slight drag
          p.x += p.vx;
          p.y += p.vy;
          p.rot += p.spin;
          p.life = Math.max(0, 1 - elapsed / DURATION);
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          ctx.globalAlpha = p.life;
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.r, -p.r * 0.4, p.r * 2, p.r * 0.8);
          ctx.restore();
        }
        if (elapsed < DURATION) requestAnimationFrame(step);
        else ctx.clearRect(0, 0, rect.width, rect.height);
      }
      requestAnimationFrame(step);
    }
  });
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Spin to Win",
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable popup",
      "default": true
    },
    {
      "type": "range",
      "id": "delay",
      "label": "Open delay (seconds)",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "exit_intent",
      "label": "Trigger on exit intent (desktop)",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Append ?spin=1 to any URL (or visit #spin) to force-open the modal for QA, even after the visitor has played. Run window.HOV_SPIN_RESET() in the console to clear the one-use flag."
    }
  ],
  "presets": [
    {
      "name": "Spin to Win",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
