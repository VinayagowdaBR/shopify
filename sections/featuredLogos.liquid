{%- assign sec = section.settings -%}

<section id="featured-logos-{{ section.id }}" class="featured-logos-section">
  <div class="featured-logos-inner page-width">

    {% if sec.heading != blank %}
      <div class="featured-logos-heading alignment-{{ sec.heading_align }}">
        {{ sec.heading }}
      </div>
    {% endif %}

    <div class="featured-logos-marquee-wrapper">
      <div
        class="featured-logos-marquee {% if sec.enable_scroll %}animate{% endif %}"
        id="marquee-track-{{ section.id }}"
      >
        {%- comment -%} First set of logos {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- assign blk = block.settings -%}
          <div class="featured-logo-item" {{ block.shopify_attributes }}>
            {% if blk.link != blank %}<a href="{{ blk.link }}">{% endif %}
              {% if blk.image != blank %}
                <img
                  src="{{ blk.image | img_url: '300x' }}"
                  srcset="{{ blk.image | img_url: '300x' }} 1x, {{ blk.image | img_url: '600x' }} 2x"
                  loading="lazy"
                  alt="{{ blk.image.alt | escape }}"
                  style="height:{{ sec.logo_height }}px; width:auto;"
                >
              {% endif %}
            {% if blk.link != blank %}</a>{% endif %}
          </div>
        {%- endfor -%}

        {%- comment -%} Duplicate set of logos for seamless loop {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- assign blk = block.settings -%}
          <div class="featured-logo-item featured-logo-item--dup">
            {% if blk.link != blank %}<a href="{{ blk.link }}">{% endif %}
              {% if blk.image != blank %}
                <img
                  src="{{ blk.image | img_url: '300x' }}"
                  srcset="{{ blk.image | img_url: '300x' }} 1x, {{ blk.image | img_url: '600x' }} 2x"
                  loading="lazy"
                  alt="{{ blk.image.alt | escape }}"
                  style="height:{{ sec.logo_height }}px; width:auto;"
                >
              {% endif %}
            {% if blk.link != blank %}</a>{% endif %}
          </div>
        {%- endfor -%}
      </div>
    </div>

  </div>
</section>

<style>
  #featured-logos-{{ section.id }} {
    padding: 24px 0;
    background: {{ sec.bg_color }};
  }

  /* LAYOUT */
  #featured-logos-{{ section.id }} .featured-logos-inner {
    display: flex;
    align-items: center;
    gap: 32px;
    flex-wrap: nowrap;
  }

  /* HEADING ALIGNMENT */
  #featured-logos-{{ section.id }} .featured-logos-heading {
    white-space: nowrap;
    font-weight: 600;
    font-size: 18px;
    flex-shrink: 0;
  }

  #featured-logos-{{ section.id }} .alignment-left {
    text-align: left;
    margin-right: 0;
    margin-left: 0;
  }

  #featured-logos-{{ section.id }} .alignment-center {
    text-align: center;
    margin: 0 auto;
  }

  #featured-logos-{{ section.id }} .alignment-right {
    text-align: right;
    margin-left: auto;
  }

  /* MARQUEE CONTAINER */
  #featured-logos-{{ section.id }} .featured-logos-marquee-wrapper {
    flex: 1;
    overflow: hidden;
    position: relative;
  }

  /* MARQUEE TRACK */
  #featured-logos-{{ section.id }} .featured-logos-marquee {
    display: flex;
    gap: {{ sec.logo_gap }}px;
    width: max-content;
    white-space: nowrap;
    will-change: transform;
  }

  /* LOGO ITEMS */
  #featured-logos-{{ section.id }} .featured-logo-item img {
    height: {{ sec.logo_height }}px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  /* INFINITE SCROLL ANIMATION (Flows continuously from right to left visually) */
  @keyframes scroll-{{ section.id }} {
    0%    { transform: translateX(0); }
    100% { transform: translateX(-50%); } 
  }

  #featured-logos-{{ section.id }} .animate {
    animation: scroll-{{ section.id }} {{ sec.speed }}s linear infinite;
  }

  /* MOBILE */
  @media (max-width: 749px) {
    #featured-logos-{{ section.id }} {
      padding: 16px 0;
    }

    #featured-logos-{{ section.id }} .featured-logos-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    #featured-logos-{{ section.id }} .featured-logos-heading {
      font-size: 16px;
    }
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const marquee = document.querySelector("#marquee-track-{{ section.id }}");
  if (!marquee) return;

  const container = marquee.parentElement;
  if (!container) return;

  const duplicateContent = () => {
    // Collect original content (not liquid-added duplicates, not JS-added duplicates)
    const originalContent = Array.from(marquee.querySelectorAll('.featured-logo-item:not(.featured-logo-item--dup)'));
    
    // Remove existing JS-added duplicates before recalculating
    marquee.querySelectorAll('.featured-logo-item--js-dup').forEach(dup => dup.remove());

    let totalWidth = marquee.scrollWidth;
    const containerWidth = container.offsetWidth;

    // Add more duplicates via JS until track is long enough
    while (totalWidth < containerWidth * 3) {
      originalContent.forEach(item => {
        const clone = item.cloneNode(true);
        clone.classList.add('featured-logo-item--js-dup'); // Tag JS duplicates
        marquee.appendChild(clone);
      });
      totalWidth = marquee.scrollWidth;
    }
  };

  // Run on load
  duplicateContent();

  // Re-run on window resize
  window.addEventListener('resize', duplicateContent);


  {% if sec.enable_scroll %}
    marquee.classList.add("animate");
  {% else %}
    marquee.classList.remove("animate");
  {% endif %}
});
</script>

{% schema %}
{
  "name": "Featured logos marquee",
  "class": "index-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "Featured In"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "enable_scroll",
      "label": "Enable auto scroll",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed (seconds, lower = faster)",
      "min": 8,
      "max": 80,
      "step": 2,
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height (px)",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "logo_gap",
      "label": "Gap between logos (px)",
      "min": 10,
      "max": 80,
      "step": 5,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional URL"
        }
      ]
    }
  ],
  "max_blocks": 40,
  "presets": [
    {
      "name": "Featured logos marquee",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}