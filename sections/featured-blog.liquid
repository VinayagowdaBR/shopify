{%- assign secSt = section.settings -%}
{%- assign blog = blogs[secSt.blog] -%}

<section
  id="knowledge-lab-{{ section.id }}"
  class="hov-knowledge-lab{% if secSt.hide_mobile %} hide-sm{% endif %}{% if secSt.hided %} hide-md hide-lg{% endif %}"
>
  <div class="hov-knowledge-inner">

    <div class="hov-knowledge-heading-wrap">
      <h2 class="hov-knowledge-heading">
        {% if secSt.title != blank %}
          {{ secSt.title | strip_html }}
        {% else %}
          From the Knowledge Lab
        {% endif %}
      </h2>

      <div class="hov-knowledge-line">
        <span></span>
      </div>

      {% if secSt.subtitle != blank %}
        <div class="hov-knowledge-subtitle">
          {{ secSt.subtitle }}
        </div>
      {% else %}
        <div class="hov-knowledge-subtitle">
          Expert jewellery care tips, styling guides, and curated insights to elevate your everyday elegance.
        </div>
      {% endif %}
    </div>

    <div class="hov-blog-scroll">
      <div class="hov-blog-grid">
        {% for article in blog.articles limit: secSt.post_limit %}
          <article class="hov-blog-card">

            <a href="{{ article.url }}" class="hov-blog-image-link">
              {% if article.image != blank %}
                <img
                  src="{{ article.image | image_url: width: 700 }}"
                  alt="{{ article.image.alt | default: article.title | escape }}"
                  loading="lazy"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </a>

            <div class="hov-blog-content">
              <h3 class="hov-blog-title">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h3>

              {% if secSt.blog_show_date %}
                <div class="hov-blog-date">
                  {{ article.published_at | date: "%B %d, %Y" }}
                </div>
              {% endif %}

              {% if secSt.show_mini_des %}
                <div class="hov-blog-excerpt">
                  {% if article.excerpt != blank %}
                    {{ article.excerpt | strip_html | truncatewords: 18 }}
                  {% else %}
                    {{ article.content | strip_html | truncatewords: 18 }}
                  {% endif %}
                </div>
              {% endif %}
            </div>

            {% if secSt.show_read_more %}
              <a href="{{ article.url }}" class="hov-blog-read-more">
                Read More
              </a>
            {% endif %}

          </article>
        {% else %}
          {% for i in (1..3) %}
            <article class="hov-blog-card">
              <a href="#" class="hov-blog-image-link">
                {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
              </a>

              <div class="hov-blog-content">
                <h3 class="hov-blog-title">
                  <a href="#">Jewellery Styling Guide</a>
                </h3>
                <div class="hov-blog-date">April 4, 2026</div>
                <div class="hov-blog-excerpt">
                  Discover simple jewellery tips and styling ideas for everyday elegance.
                </div>
              </div>

              <a href="#" class="hov-blog-read-more">
                Read More
              </a>
            </article>
          {% endfor %}
        {% endfor %}
      </div>
    </div>

    {% if secSt.show_view_all %}
      <div class="hov-blog-view-all">
        <a href="{{ blog.url }}" class="btn {{ secSt.btn-style }} {{ secSt.btn-size-mob }} {{ secSt.btn-size-desk }}">
          View All
        </a>
      </div>
    {% endif %}

  </div>
</section>

<style>
  #knowledge-lab-{{ section.id }} {
    width: 100%;
    background: #ffffff;
    padding: 34px 14px 46px;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }

  #knowledge-lab-{{ section.id }} * {
    box-sizing: border-box;
  }

  #knowledge-lab-{{ section.id }}::before {
    content: "";
    position: absolute;
    left: 18px;
    top: 18px;
    width: 118px;
    height: 86px;
    opacity: 0.22;
    background-image:
      linear-gradient(#dfe9e5 1px, transparent 1px),
      linear-gradient(90deg, #dfe9e5 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
  }

  #knowledge-lab-{{ section.id }} .hov-knowledge-inner {
    max-width: 1050px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  #knowledge-lab-{{ section.id }} .hov-knowledge-heading-wrap {
    text-align: center;
    margin-bottom: 28px;
  }

  #knowledge-lab-{{ section.id }} .hov-knowledge-heading {
    margin: 0;
    color: #0F3B2E;
    font-size: 28px;
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: 0.2px;
  }

  #knowledge-lab-{{ section.id }} .hov-knowledge-line {
    width: 22%;
    max-width: 190px;
    min-width: 105px;
    height: 12px;
    margin: 7px auto 0;
    position: relative;
  }

  #knowledge-lab-{{ section.id }} .hov-knowledge-line::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 5px;
    height: 2px;
    background: #000000;
  }

  #knowledge-lab-{{ section.id }} .hov-knowledge-line::after,
  #knowledge-lab-{{ section.id }} .hov-knowledge-line span::after {
    content: "";
    position: absolute;
    top: 1px;
    width: 9px;
    height: 9px;
    background: #000000;
    transform: rotate(45deg);
  }

  #knowledge-lab-{{ section.id }} .hov-knowledge-line::after {
    left: -1px;
  }

  #knowledge-lab-{{ section.id }} .hov-knowledge-line span::after {
    right: -1px;
  }

  #knowledge-lab-{{ section.id }} .hov-knowledge-subtitle {
    max-width: 620px;
    margin: 14px auto 0;
    color: #777777;
    font-size: 15px;
    line-height: 1.35;
    font-weight: 400;
  }

  #knowledge-lab-{{ section.id }} .hov-blog-scroll {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  #knowledge-lab-{{ section.id }} .hov-blog-scroll::-webkit-scrollbar {
    display: none;
  }

  #knowledge-lab-{{ section.id }} .hov-blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 34px;
  }

  #knowledge-lab-{{ section.id }} .hov-blog-card {
    background: #ffffff;
    border: 1px solid #d8e1dc;
    box-shadow: 0 8px 18px rgba(15, 59, 46, 0.08);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  #knowledge-lab-{{ section.id }} .hov-blog-image-link {
    display: block;
    width: 100%;
    height: 215px;
    overflow: hidden;
    background: #f7f0ea;
  }

  #knowledge-lab-{{ section.id }} .hov-blog-image-link img,
  #knowledge-lab-{{ section.id }} .hov-blog-image-link svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #knowledge-lab-{{ section.id }} .hov-blog-content {
    padding: 12px 12px 10px;
    flex: 1;
  }

  #knowledge-lab-{{ section.id }} .hov-blog-title {
    margin: 0;
    font-size: 13px;
    line-height: 1.25;
    font-weight: 500;
    color: #333333;
  }

  #knowledge-lab-{{ section.id }} .hov-blog-title a {
    color: inherit;
    text-decoration: none;
  }

  #knowledge-lab-{{ section.id }} .hov-blog-date {
    margin-top: 7px;
    font-size: 10px;
    color: #777777;
    line-height: 1.2;
  }

  #knowledge-lab-{{ section.id }} .hov-blog-excerpt {
    margin-top: 7px;
    color: #444444;
    font-size: 10px;
    line-height: 1.35;
  }

  #knowledge-lab-{{ section.id }} .hov-blog-read-more {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    background: #0F6B4F;
    color: #ffffff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    margin-top: auto;
  }

  #knowledge-lab-{{ section.id }} .hov-blog-view-all {
    text-align: center;
    margin-top: 28px;
  }

  @media screen and (max-width: 768px) {
    #knowledge-lab-{{ section.id }} {
      padding: 30px 12px 38px;
    }

    #knowledge-lab-{{ section.id }}::before {
      left: 10px;
      top: 12px;
      width: 92px;
      height: 70px;
      background-size: 20px 20px;
      opacity: 0.18;
    }

    #knowledge-lab-{{ section.id }} .hov-knowledge-heading-wrap {
      margin-bottom: 22px;
    }

    #knowledge-lab-{{ section.id }} .hov-knowledge-heading {
      font-size: 22px;
      line-height: 1.15;
    }

    #knowledge-lab-{{ section.id }} .hov-knowledge-line {
      width: 20%;
      min-width: 96px;
      max-width: 125px;
      height: 11px;
      margin-top: 6px;
    }

    #knowledge-lab-{{ section.id }} .hov-knowledge-line::after,
    #knowledge-lab-{{ section.id }} .hov-knowledge-line span::after {
      width: 8px;
      height: 8px;
    }

    #knowledge-lab-{{ section.id }} .hov-knowledge-subtitle {
      font-size: 13px;
      line-height: 1.35;
      margin-top: 12px;
      padding: 0 10px;
    }

    #knowledge-lab-{{ section.id }} .hov-blog-grid {
      display: flex;
      flex-wrap: nowrap;
      gap: 14px;
      width: max-content;
      padding: 0 4px 8px;
    }

    #knowledge-lab-{{ section.id }} .hov-blog-card {
      width: 68vw;
      max-width: 280px;
      flex: 0 0 68vw;
    }

    #knowledge-lab-{{ section.id }} .hov-blog-image-link {
      height: 190px;
    }
  }

  @media screen and (max-width: 390px) {
    #knowledge-lab-{{ section.id }} .hov-blog-card {
      width: 66vw;
      flex-basis: 66vw;
      max-width: 260px;
    }

    #knowledge-lab-{{ section.id }} .hov-blog-image-link {
      height: 175px;
    }
  }
</style>

{% schema %}
{
  "name": "Knowledge Lab Blog",
  "class": "index-section",
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "From the Knowledge Lab"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sub heading",
      "default": "Expert jewellery care tips, styling guides, and curated insights to elevate your everyday elegance."
    },
    {
      "id": "blog",
      "type": "blog",
      "label": "Select blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Posts to show",
      "default": 3,
      "min": 1,
      "max": 12,
      "step": 1
    },
    {
      "type": "checkbox",
      "id": "blog_show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mini_des",
      "label": "Show short description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_read_more",
      "label": "Show read more button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide in mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hided",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "select",
      "id": "btn-style",
      "label": "Button style",
      "default": "btn",
      "options": [
        {
          "label": "Solid Button 1",
          "value": "btn"
        },
        {
          "label": "Solid Button 2",
          "value": "btn2"
        },
        {
          "label": "Solid Button 3",
          "value": "btn3"
        },
        {
          "label": "Border Button 1",
          "value": "bdr-btn1"
        },
        {
          "label": "Border Button 2",
          "value": "bdr-btn2"
        }
      ]
    },
    {
      "type": "select",
      "id": "btn-size-desk",
      "label": "Button size desktop",
      "default": "btn-md",
      "options": [
        {
          "label": "Small",
          "value": "btn-sm"
        },
        {
          "label": "Medium",
          "value": "btn-md"
        },
        {
          "label": "Large",
          "value": "btn-lg"
        }
      ]
    },
    {
      "type": "select",
      "id": "btn-size-mob",
      "label": "Button size mobile",
      "default": "mob-btn-sm",
      "options": [
        {
          "label": "Small",
          "value": "mob-btn-sm"
        },
        {
          "label": "Medium",
          "value": "mob-btn-md"
        },
        {
          "label": "Large",
          "value": "mob-btn-lg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Knowledge Lab Blog"
    }
  ]
}
{% endschema %}