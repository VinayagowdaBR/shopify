{% assign current_product = product %}

{%- assign aiui_models = current_product.media | where: 'media_type', 'model' -%}
{%- assign aiui_has_3d = false -%}
{%- if aiui_models.size > 0 -%}{%- assign aiui_has_3d = true -%}{%- endif -%}

{%- comment -%}
  === Extras sections data resolution ===
  Priority: per-product metafield → section default → hidden.
  Each section is gated by its own show_extras_* checkbox in section settings.
{%- endcomment -%}
{%- assign hov_highlights_mf = current_product.metafields.custom.product_highlights | default: '' -%}
{%- assign hov_styling_mf    = current_product.metafields.custom.styling_tips      | default: '' -%}
{%- assign hov_material_mf   = current_product.metafields.custom.material_care     | default: '' -%}
{%- assign hov_box_mf        = current_product.metafields.custom.box_contents      | default: '' -%}

{%- if hov_highlights_mf != blank -%}{%- assign hov_highlights_raw = hov_highlights_mf -%}{%- else -%}{%- assign hov_highlights_raw = section.settings.default_highlights | default: '' -%}{%- endif -%}
{%- if hov_styling_mf    != blank -%}{%- assign hov_styling_raw    = hov_styling_mf    -%}{%- else -%}{%- assign hov_styling_raw    = section.settings.default_styling_tips  | default: '' -%}{%- endif -%}
{%- if hov_material_mf   != blank -%}{%- assign hov_material_raw   = hov_material_mf   -%}{%- else -%}{%- assign hov_material_raw   = section.settings.default_material_care | default: '' -%}{%- endif -%}
{%- if hov_box_mf        != blank -%}{%- assign hov_box_raw        = hov_box_mf        -%}{%- else -%}{%- assign hov_box_raw        = section.settings.default_box_contents  | default: '' -%}{%- endif -%}

{%- unless section.settings.show_extras_highlights -%}{%- assign hov_highlights_raw = '' -%}{%- endunless -%}
{%- unless section.settings.show_extras_styling    -%}{%- assign hov_styling_raw    = '' -%}{%- endunless -%}
{%- unless section.settings.show_extras_material   -%}{%- assign hov_material_raw   = '' -%}{%- endunless -%}
{%- unless section.settings.show_extras_box        -%}{%- assign hov_box_raw        = '' -%}{%- endunless -%}

{%- assign hov_has_extras = false -%}
{%- if hov_highlights_raw != blank or hov_styling_raw != blank or hov_material_raw != blank or hov_box_raw != blank -%}
  {%- assign hov_has_extras = true -%}
{%- endif -%}
<section class="hov-product-conversion aiui-pdp" id="hov-product-conversion-{{ section.id }}" data-aiui-has-3d="{{ aiui_has_3d }}">

  <div class="hov-page-width">

    <div class="hov-grid">

      
      <div class="hov-media">
        {% if current_product.images.size > 1 %}
          <div class="hov-thumbnails">
            {% for image in current_product.images limit: 4 %}
              {%- assign hov_full = image | image_url: width: 1200 -%}
              {%- assign hov_zoom = image | image_url: width: 2000 -%}
              <button
                type="button"
                class="hov-thumb{% if forloop.first %} is-active{% endif %}"
                data-full-image="{{ hov_full }}"
                data-zoom-image="{{ hov_zoom }}"
                aria-label="Show product image {{ forloop.index }}"
              >
                {{
                  image
                  | image_url: width: 300
                  | image_tag: loading: 'lazy', class: 'hov-thumb-image', alt: image.alt | escape
                }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
        {% if current_product.featured_media %}
          {%- assign hov_initial_zoom = current_product.featured_media | image_url: width: 2000 -%}
          <div class="hov-main-image" data-zoom-image="{{ hov_initial_zoom }}">
            {{
              current_product.featured_media
              | image_url: width: 1200
              | image_tag: loading: 'eager', fetchpriority: 'high', class: 'hov-product-image', alt: current_product.title
            }}
            <div class="hov-zoom-lens" aria-hidden="true"></div>

            {%- if settings.enable_wishlist -%}
              <a
                class="btn wishlist addto-wishlist hov-pdp-wishlist"
                href="{{ pages[settings.wishlist_page].url }}"
                rel="{{ current_product.handle | handleize }}"
                aria-label="{{ 'products.wishlist.add_to' | t }}"
              >
                <i class="at at-heart-l" aria-hidden="true"></i>
                <span class="tooltip-label">{{ 'products.wishlist.add_to' | t }}</span>
              </a>
            {%- endif -%}

            {%- if aiui_has_3d -%}
              {%- assign aiui_first_model = aiui_models | first -%}
              <div class="aiui-3d-stage" hidden aria-hidden="true">
                <div class="aiui-3d-mount"
                     data-model-src="{{ aiui_first_model | model_url }}"
                     data-poster="{{ current_product.featured_media | image_url: width: 1200 }}"
                     data-alt="{{ current_product.title | escape }}">
                </div>
                <div class="aiui-3d-hint">Drag to rotate · Pinch to zoom</div>
              </div>
              <button type="button" class="aiui-3d-toggle" data-aiui-3d-toggle aria-pressed="false">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"/>
                  <path d="M4 7.5L12 12m0 0l8-4.5M12 12v9"/>
                </svg>
                <span class="aiui-3d-toggle-label">View in 3D</span>
              </button>
            {%- endif -%}
          </div>
          <div class="hov-zoom-window" aria-hidden="true"></div>
        {% endif %}
      </div>

      <div class="hov-content">
        <h1 class="hov-title">{{ current_product.title }}</h1>

        <link rel="stylesheet" href="https://cdn.retenzy.com/assets/extensions/rating.css" type="text/css" media="all" />
        <script src="https://cdn.retenzy.com/assets/extensions/rating.js" defer></script>
        <div
          class="retenzy-rating"
          data-product-id="{{ current_product.id }}"
          data-shop-name="{{ shop.domain }}"
          data-total-rating="{{ current_product.metafields.thevital.cf_total_review.value }}"
          data-avg-rating="{{ current_product.metafields.thevital.cf_average_rating.value }}"
          data-locale="{{ request.locale.iso_code }}"
          data-size="large">
        </div>

        {%- if section.settings.show_guarantee_badge -%}
          {%- assign guarantee_label = product.metafields.custom.guarantee_text | default: section.settings.guarantee_badge_text -%}
          {% render 'badge-anti-tarnish', label: guarantee_label %}
        {%- endif -%}

        {% if section.settings.show_reviews %}
          <div class="hov-reviews">
            <span class="hov-stars">★★★★★</span>
            <span class="hov-review-text">{{ section.settings.review_text }}</span>
          </div>
        {% endif %}

        {% if section.settings.show_urgency %}
          <div class="hov-urgency">
            {{ section.settings.urgency_text }}
          </div>
        {% endif %}

        <div class="hov-trust-badges">
          {% if section.settings.badge_1 != blank %}<span>{{ section.settings.badge_1 }}</span>{% endif %}
          {% if section.settings.badge_2 != blank %}<span>{{ section.settings.badge_2 }}</span>{% endif %}
          {% if section.settings.badge_3 != blank %}<span>{{ section.settings.badge_3 }}</span>{% endif %}
          {% if section.settings.badge_4 != blank %}<span>{{ section.settings.badge_4 }}</span>{% endif %}
        </div>

        {% form 'product', current_product, class: 'hov-product-form' %}
          <input type="hidden" name="id" value="{{ current_product.selected_or_first_available_variant.id }}">

          {% if current_product.variants.size > 1 %}
            <div class="hov-variant-wrap">
              <label for="hov-variant-{{ section.id }}" class="hov-label">Select Option</label>
              <select
                id="hov-variant-{{ section.id }}"
                name="id"
                class="hov-variant-select"
              >
                {% for variant in current_product.variants %}
                  <option
                    value="{{ variant.id }}"
                    {% if variant == current_product.selected_or_first_available_variant %}selected{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    {{ variant.title }} - {{ variant.price | money_without_trailing_zeros }}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% endif %}

          <div class="hov-qty-wrap">
            <label for="hov-quantity-{{ section.id }}" class="hov-label">Quantity</label>
            <input
              id="hov-quantity-{{ section.id }}"
              type="number"
              name="quantity"
              min="1"
              value="1"
              class="hov-quantity-input"
            >
          </div>

          <div class="hov-buttons">
            <button type="submit" name="add" class="hov-btn hov-btn-primary" {% unless current_product.selected_or_first_available_variant.available %}disabled{% endunless %}>
              {% if current_product.selected_or_first_available_variant.available %}
                Add to Cart
              {% else %}
                Sold Out
              {% endif %}
            </button>
            {%- comment -%}
              Buy It Now — mirrors the cart page's "Proceed to Checkout" flow.
              Why: that flow (cart-template.liquid:329) calls `handleFloCheckoutBtn()` and
              successfully opens Shopflo's checkout. We do the same here, just with an
              add-to-cart step in front so the product lands in the cart first.
              `handleFloBuyNowBtn` proved unreliable; `handleFloCheckoutBtn` is the one
              the cart page already uses in production.
            {%- endcomment -%}
            <button type="button" id="hov-buy-it-now-btn" class="hov-btn hov-btn-secondary" {% unless current_product.selected_or_first_available_variant.available %}disabled{% endunless %}>
              Buy It Now
            </button>
          </div>

          <div
            id="reward-page-points"
            class="reward-page-points-container"
            data-shop-name="{{ shop.domain }}"
            data-is-logged-in="{% if customer %}true{% else %}false{% endif %}"
            data-customer-id="{% if customer %}{{ customer.id }}{% else %}null{% endif %}"
            data-currency-symbol="{{ shop.currency }}"
            data-theme="{{ settings.theme_style }}"
            data-product-id="{{ current_product.id }}"
            data-product-price="{{ current_product.price }}"
            data-store-name="{{ shop.name }}"
            data-store-logo="{{ settings.logo }}"
            data-locale="{{ localization.language.iso_code }}"
          ></div>
        {% endform %}

        <div class="hov-reassurance">
          {% if section.settings.reassurance_1 != blank %}<p>{{ section.settings.reassurance_1 }}</p>{% endif %}
          {% if section.settings.reassurance_2 != blank %}<p>{{ section.settings.reassurance_2 }}</p>{% endif %}
        </div>

        {%- comment -%} Description is merged into the unified "About this piece" card rendered by hov-product-makeover.liquid {%- endcomment -%}
      </div>
    </div>

    {%- if hov_has_extras -%}
      <div class="hov-extras">

        {%- if hov_highlights_raw != blank -%}
          {%- assign hov_highlight_lines = hov_highlights_raw | newline_to_br | split: '<br />' -%}
          <section class="hov-extras-section hov-extras-highlights">
            <h2 class="hov-extras-title"><span class="hov-extras-mark">✦</span> Product Highlights</h2>
            <div class="hov-extras-highlights-grid">
              {%- for line in hov_highlight_lines -%}
                {%- assign clean = line | strip | replace: '<br>', '' | replace: '<br/>', '' | strip -%}
                {%- if clean != blank -%}
                  {%- assign parts = clean | split: '|' -%}
                  {%- assign h_title = parts[0] | strip -%}
                  {%- assign h_desc  = parts[1] | strip -%}
                  <div class="hov-extras-card">
                    <div class="hov-extras-card-num">0{{ forloop.index }}</div>
                    <h3 class="hov-extras-card-title">{{ h_title }}</h3>
                    {%- if h_desc != blank -%}
                      <p class="hov-extras-card-desc">{{ h_desc }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </section>
        {%- endif -%}

        {%- if hov_styling_raw != blank -%}
          <section class="hov-extras-section hov-extras-styling">
            <h2 class="hov-extras-title"><span class="hov-extras-mark">✦</span> Style It Your Way</h2>
            <div class="hov-extras-prose">{{ hov_styling_raw | newline_to_br }}</div>
          </section>
        {%- endif -%}

        {%- if hov_material_raw != blank -%}
          <section class="hov-extras-section hov-extras-material">
            <h2 class="hov-extras-title"><span class="hov-extras-mark">✦</span> Material &amp; Care</h2>
            <div class="hov-extras-prose">{{ hov_material_raw | newline_to_br }}</div>
          </section>
        {%- endif -%}

        {%- if hov_box_raw != blank -%}
          {%- assign hov_box_lines = hov_box_raw | newline_to_br | split: '<br />' -%}
          <section class="hov-extras-section hov-extras-box">
            <h2 class="hov-extras-title"><span class="hov-extras-mark">✦</span> What's In The Box</h2>
            <ul class="hov-extras-box-list">
              {%- for line in hov_box_lines -%}
                {%- assign item = line | strip | replace: '<br>', '' | replace: '<br/>', '' | replace: '•', '' | replace: '·', '' | strip -%}
                {%- if item != blank -%}
                  <li class="hov-extras-box-item">
                    <svg class="hov-extras-box-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    <span>{{ item }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </section>
        {%- endif -%}

      </div>
    {%- endif -%}

  </div>

  <div class="hov-sticky-bar">
    <div class="hov-sticky-inner">
      <div class="hov-sticky-price">
        <span class="hov-sticky-current">{{ current_product.price | money_without_trailing_zeros }}</span>
        {% if current_product.compare_at_price > current_product.price %}
          <span class="hov-sticky-compare">{{ current_product.compare_at_price | money_without_trailing_zeros }}</span>
        {% endif %}
      </div>
      <form method="post" action="/cart/add" class="hov-sticky-form">
        <input type="hidden" name="id" value="{{ current_product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="hov-sticky-btn">Add to Cart</button>
      </form>
    </div>
  </div>

</section>
<style>
  #hov-product-conversion-{{ section.id }} {
    --hov-ivory: #F4F1EC;
    --hov-emerald: #0F3B2E;
    --hov-gold: #C8B28A;
    --hov-charcoal: #2E2E2E;
    --hov-muted: #7A7A7A;
    --hov-border: #E8E1D8;
    --hov-bg: #ffffff;
    --hov-sticky-top: 100px;
    background: var(--hov-bg);
    padding: 40px 0 80px;
    box-sizing: border-box;
    width: 100%;
    overflow-x: clip;
  }
  #hov-product-conversion-{{ section.id }} *,
  #hov-product-conversion-{{ section.id }} *::before,
  #hov-product-conversion-{{ section.id }} *::after {
    box-sizing: border-box;
  }
  #hov-product-conversion-{{ section.id }} .hov-page-width {
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 20px;
    padding-right: 20px;
    width: 100%;
  }
  #hov-product-conversion-{{ section.id }} .hov-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 48px;
    align-items: start;
  }
  #hov-product-conversion-{{ section.id }} .hov-media,
  #hov-product-conversion-{{ section.id }} .hov-content {
    min-width: 0;
    max-width: 100%;
  }
  #hov-product-conversion-{{ section.id }} .hov-main-image {
    background: #fff;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(0,0,0,0.05);
    cursor: zoom-in;
    position: relative;
  }
  #hov-product-conversion-{{ section.id }} .hov-product-image,
  #hov-product-conversion-{{ section.id }} .hov-thumb-image {
    width: 100%;
    display: block;
    height: auto;
  }
  #hov-product-conversion-{{ section.id }} .hov-zoom-lens {
    position: absolute;
    top: 0;
    left: 0;
    width: 40%;
    height: 40%;
    background: rgba(255, 255, 255, 0.35);
    border: 1px solid rgba(15, 59, 46, 0.45);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 120ms ease;
    z-index: 5;
  }

  /* PDP wishlist heart — overlay on top-right of the main image */
  #hov-product-conversion-{{ section.id }} .hov-pdp-wishlist {
    position: absolute !important;
    top: 16px !important;
    right: 16px !important;
    z-index: 6;
    width: 46px !important;
    height: 46px !important;
    min-width: 46px !important;
    box-shadow: 0 4px 14px rgba(15, 59, 46, 0.12) !important;
  }
  #hov-product-conversion-{{ section.id }} .hov-pdp-wishlist .at {
    font-size: 18px !important;
  }
  #hov-product-conversion-{{ section.id }} .hov-pdp-wishlist:hover {
    transform: scale(1.06);
  }
  @media (max-width: 749px) {
    #hov-product-conversion-{{ section.id }} .hov-pdp-wishlist {
      top: 12px !important;
      right: 12px !important;
      width: 42px !important;
      height: 42px !important;
      min-width: 42px !important;
    }
    #hov-product-conversion-{{ section.id }} .hov-pdp-wishlist .at {
      font-size: 16px !important;
    }
  }
  #hov-product-conversion-{{ section.id }} .hov-zoom-window {
    position: absolute;
    top: 0;
    left: calc(100% + 20px);
    width: 500px;
    height: 500px;
    background-repeat: no-repeat;
    background-size: 250% 250%;
    background-color: #fff;
    border-radius: 16px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 150ms ease;
    z-index: 10;
  }
  #hov-product-conversion-{{ section.id }} .hov-media.is-zooming .hov-zoom-lens,
  #hov-product-conversion-{{ section.id }} .hov-media.is-zooming .hov-zoom-window {
    opacity: 1;
    visibility: visible;
  }
  @media (hover: none) {
    #hov-product-conversion-{{ section.id }} .hov-main-image {
      cursor: default;
    }
    #hov-product-conversion-{{ section.id }} .hov-zoom-lens,
    #hov-product-conversion-{{ section.id }} .hov-zoom-window {
      display: none;
    }
  }
  #hov-product-conversion-{{ section.id }} .hov-media {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    grid-template-rows: auto auto;
    gap: 14px;
    position: relative;
  }
  #hov-product-conversion-{{ section.id }} .hov-media:not(:has(.hov-thumbnails)) {
    grid-template-columns: minmax(0, 1fr);
  }
  #hov-product-conversion-{{ section.id }} .hov-thumbnails {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 12px;
    margin-top: 0;
    grid-column: 1;
    grid-row: 1;
  }
  #hov-product-conversion-{{ section.id }} .hov-main-image {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
    width: 100%;
  }
  #hov-product-conversion-{{ section.id }} .hov-media:not(:has(.hov-thumbnails)) > .hov-main-image {
    grid-column: 1;
  }
  #hov-product-conversion-{{ section.id }} .hov-media > .hov2-about {
    grid-column: 1 / -1;
    grid-row: 2;
    width: 100%;
    margin-top: 6px;
  }
  #hov-product-conversion-{{ section.id }} .hov-thumb {
    padding: 0;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--hov-border);
    cursor: pointer;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }
  #hov-product-conversion-{{ section.id }} .hov-thumb:hover {
    border-color: var(--hov-emerald);
    transform: translateY(-1px);
  }
  #hov-product-conversion-{{ section.id }} .hov-thumb.is-active {
    border-color: var(--hov-emerald);
    box-shadow: 0 0 0 2px var(--hov-emerald);
  }
  #hov-product-conversion-{{ section.id }} .hov-thumb:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--hov-emerald);
  }
  #hov-product-conversion-{{ section.id }} .hov-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(15, 59, 46, 0.08);
    color: var(--hov-emerald);
    border: 1px solid rgba(15, 59, 46, 0.12);
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 16px;
  }
  #hov-product-conversion-{{ section.id }} .hov-title {
    font-size: 34px;
    line-height: 1.2;
    color: var(--hov-charcoal);
    margin: 0 0 10px;
    font-weight: 600;
  }
  #hov-product-conversion-{{ section.id }} .hov-subtitle {
    font-size: 16px;
    line-height: 1.7;
    color: var(--hov-muted);
    margin: 0 0 14px;
  }
  #hov-product-conversion-{{ section.id }} .hov-reviews {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
  }
  #hov-product-conversion-{{ section.id }} .hov-stars {
    color: var(--hov-gold);
    letter-spacing: 1px;
    font-size: 16px;
  }
  #hov-product-conversion-{{ section.id }} .hov-review-text {
    color: var(--hov-muted);
    font-size: 14px;
  }
  #hov-product-conversion-{{ section.id }} .hov-price-wrap {
    padding: 20px 0 14px;
    border-top: 1px solid var(--hov-border);
    border-bottom: 1px solid var(--hov-border);
  }
  #hov-product-conversion-{{ section.id }} .hov-price-row {
    display: flex;
    align-items: flex-end;
    gap: 18px;
    flex-wrap: wrap;
  }
  #hov-product-conversion-{{ section.id }} .hov-price-block {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
  }
  #hov-product-conversion-{{ section.id }} .hov-price-block[hidden] { display: none; }
  #hov-product-conversion-{{ section.id }} .hov-price-label {
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--hov-muted);
    margin-bottom: 6px;
  }
  #hov-product-conversion-{{ section.id }} .hov-price-current {
    font-size: 32px;
    line-height: 1;
    font-weight: 700;
    color: var(--hov-emerald);
  }
  #hov-product-conversion-{{ section.id }} .hov-price-compare {
    font-size: 20px;
    color: var(--hov-muted);
    text-decoration: line-through;
    font-weight: 500;
  }
  #hov-product-conversion-{{ section.id }} .hov-discount-badge {
    display: inline-flex;
    align-items: center;
    background: var(--hov-emerald);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 12px;
    border-radius: 999px;
    letter-spacing: 0.2px;
  }
  #hov-product-conversion-{{ section.id }} .hov-tax-text {
    margin: 12px 0 0;
    font-size: 13px;
    color: var(--hov-muted);
