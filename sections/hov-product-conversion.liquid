{% assign current_product = product %}

<section class="hov-product-conversion" id="hov-product-conversion-{{ section.id }}">

  <div class="hov-page-width">

    <div class="hov-grid">

      
      <div class="hov-media">
        {% if current_product.images.size > 1 %}
          <div class="hov-thumbnails">
            {% for image in current_product.images limit: 4 %}
              {%- assign hov_full = image | image_url: width: 1200 -%}
              {%- assign hov_zoom = image | image_url: width: 2000 -%}
              <button
                type="button"
                class="hov-thumb{% if forloop.first %} is-active{% endif %}"
                data-full-image="{{ hov_full }}"
                data-zoom-image="{{ hov_zoom }}"
                aria-label="Show product image {{ forloop.index }}"
              >
                {{
                  image
                  | image_url: width: 300
                  | image_tag: loading: 'lazy', class: 'hov-thumb-image', alt: image.alt | escape
                }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
        {% if current_product.featured_media %}
          {%- assign hov_initial_zoom = current_product.featured_media | image_url: width: 2000 -%}
          <div class="hov-main-image" data-zoom-image="{{ hov_initial_zoom }}">
            {{
              current_product.featured_media
              | image_url: width: 1200
              | image_tag: loading: 'lazy', class: 'hov-product-image', alt: current_product.title
            }}
            <div class="hov-zoom-lens" aria-hidden="true"></div>
          </div>
          <div class="hov-zoom-window" aria-hidden="true"></div>
        {% endif %}
      </div>

      <div class="hov-content">
        <h1 class="hov-title">{{ current_product.title }}</h1>

        {% if section.settings.show_reviews %}
          <div class="hov-reviews">
            <span class="hov-stars">★★★★★</span>
            <span class="hov-review-text">{{ section.settings.review_text }}</span>
          </div>
        {% endif %}



        {% if section.settings.show_urgency %}
          <div class="hov-urgency">
            {{ section.settings.urgency_text }}
          </div>
        {% endif %}

        <div class="hov-trust-badges">
          {% if section.settings.badge_1 != blank %}<span>{{ section.settings.badge_1 }}</span>{% endif %}
          {% if section.settings.badge_2 != blank %}<span>{{ section.settings.badge_2 }}</span>{% endif %}
          {% if section.settings.badge_3 != blank %}<span>{{ section.settings.badge_3 }}</span>{% endif %}
          {% if section.settings.badge_4 != blank %}<span>{{ section.settings.badge_4 }}</span>{% endif %}
        </div>

        {% form 'product', current_product, class: 'hov-product-form' %}
          <input type="hidden" name="id" value="{{ current_product.selected_or_first_available_variant.id }}">

          {% if current_product.variants.size > 1 %}
            <div class="hov-variant-wrap">
              <label for="hov-variant-{{ section.id }}" class="hov-label">Select Option</label>
              <select
                id="hov-variant-{{ section.id }}"
                name="id"
                class="hov-variant-select"
              >
                {% for variant in current_product.variants %}
                  <option
                    value="{{ variant.id }}"
                    {% if variant == current_product.selected_or_first_available_variant %}selected{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    {{ variant.title }} - {{ variant.price | money_without_trailing_zeros }}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% endif %}

          <div class="hov-qty-wrap">
            <label for="hov-quantity-{{ section.id }}" class="hov-label">Quantity</label>
            <input
              id="hov-quantity-{{ section.id }}"
              type="number"
              name="quantity"
              min="1"
              value="1"
              class="hov-quantity-input"
            >
          </div>

          <div class="hov-buttons">
            <button type="submit" name="add" class="hov-btn hov-btn-primary" {% unless current_product.selected_or_first_available_variant.available %}disabled{% endunless %}>
              {% if current_product.selected_or_first_available_variant.available %}
                Add to Cart
              {% else %}
                Sold Out
              {% endif %}
            </button>
            <button type="submit" name="checkout" class="hov-btn hov-btn-secondary" {% unless current_product.selected_or_first_available_variant.available %}disabled{% endunless %}>
              Buy It Now
            </button>
          </div>
        {% endform %}

        <div class="hov-reassurance">
          {% if section.settings.reassurance_1 != blank %}<p>{{ section.settings.reassurance_1 }}</p>{% endif %}
          {% if section.settings.reassurance_2 != blank %}<p>{{ section.settings.reassurance_2 }}</p>{% endif %}
        </div>

        {% if current_product.description != blank %}
          <div class="hov-description">
            <h3>Description</h3>
            <div class="hov-description-content">
              {{ current_product.description }}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="hov-sticky-bar">
    <div class="hov-sticky-inner">
      <div class="hov-sticky-price">
        <span class="hov-sticky-current">{{ current_product.price | money_without_trailing_zeros }}</span>
        {% if current_product.compare_at_price > current_product.price %}
          <span class="hov-sticky-compare">{{ current_product.compare_at_price | money_without_trailing_zeros }}</span>
        {% endif %}
      </div>
      <form method="post" action="/cart/add" class="hov-sticky-form">
        <input type="hidden" name="id" value="{{ current_product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="hov-sticky-btn">Add to Cart</button>
      </form>
    </div>
  </div>

</section>
<style>
  #hov-product-conversion-{{ section.id }} {
    --hov-ivory: #F4F1EC;
    --hov-emerald: #0F3B2E;
    --hov-gold: #C8B28A;
    --hov-charcoal: #2E2E2E;
    --hov-muted: #7A7A7A;
    --hov-border: #E8E1D8;
    --hov-bg: #FCFAF7;
    background: var(--hov-bg);
    padding: 40px 0 80px;
    box-sizing: border-box;
    width: 100%;
    overflow-x: clip;
  }
  #hov-product-conversion-{{ section.id }} *,
  #hov-product-conversion-{{ section.id }} *::before,
  #hov-product-conversion-{{ section.id }} *::after {
    box-sizing: border-box;
  }
  #hov-product-conversion-{{ section.id }} .hov-page-width {
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 20px;
    padding-right: 20px;
    width: 100%;
  }
  #hov-product-conversion-{{ section.id }} .hov-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 48px;
    align-items: start;
  }
  #hov-product-conversion-{{ section.id }} .hov-media,
  #hov-product-conversion-{{ section.id }} .hov-content {
    min-width: 0;
    max-width: 100%;
  }
  #hov-product-conversion-{{ section.id }} .hov-main-image {
    background: #fff;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(0,0,0,0.05);
    cursor: zoom-in;
    position: relative;
  }
  #hov-product-conversion-{{ section.id }} .hov-product-image,
  #hov-product-conversion-{{ section.id }} .hov-thumb-image {
    width: 100%;
    display: block;
    height: auto;
  }
  #hov-product-conversion-{{ section.id }} .hov-zoom-lens {
    position: absolute;
    top: 0;
    left: 0;
    width: 40%;
    height: 40%;
    background: rgba(255, 255, 255, 0.35);
    border: 1px solid rgba(15, 59, 46, 0.45);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 120ms ease;
    z-index: 5;
  }
  #hov-product-conversion-{{ section.id }} .hov-zoom-window {
    position: absolute;
    top: 0;
    left: calc(100% + 20px);
    width: 500px;
    height: 500px;
    background-repeat: no-repeat;
    background-size: 250% 250%;
    background-color: #fff;
    border-radius: 16px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 150ms ease;
    z-index: 10;
  }
  #hov-product-conversion-{{ section.id }} .hov-media.is-zooming .hov-zoom-lens,
  #hov-product-conversion-{{ section.id }} .hov-media.is-zooming .hov-zoom-window {
    opacity: 1;
    visibility: visible;
  }
  @media (hover: none) {
    #hov-product-conversion-{{ section.id }} .hov-main-image {
      cursor: default;
    }
    #hov-product-conversion-{{ section.id }} .hov-zoom-lens,
    #hov-product-conversion-{{ section.id }} .hov-zoom-window {
      display: none;
    }
  }
  #hov-product-conversion-{{ section.id }} .hov-media {
    display: flex;
    flex-direction: row;
    gap: 14px;
    align-items: flex-start;
    position: relative;
  }
  #hov-product-conversion-{{ section.id }} .hov-thumbnails {
    display: flex;
    flex-direction: column;
    width: 84px;
    flex-shrink: 0;
    gap: 12px;
    margin-top: 0;
  }
  #hov-product-conversion-{{ section.id }} .hov-main-image {
    flex: 1 1 auto;
    min-width: 0;
  }
  #hov-product-conversion-{{ section.id }} .hov-thumb {
    padding: 0;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--hov-border);
    cursor: pointer;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }
  #hov-product-conversion-{{ section.id }} .hov-thumb:hover {
    border-color: var(--hov-emerald);
    transform: translateY(-1px);
  }
  #hov-product-conversion-{{ section.id }} .hov-thumb.is-active {
    border-color: var(--hov-emerald);
    box-shadow: 0 0 0 2px var(--hov-emerald);
  }
  #hov-product-conversion-{{ section.id }} .hov-thumb:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--hov-emerald);
  }
  #hov-product-conversion-{{ section.id }} .hov-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(15, 59, 46, 0.08);
    color: var(--hov-emerald);
    border: 1px solid rgba(15, 59, 46, 0.12);
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 16px;
  }
  #hov-product-conversion-{{ section.id }} .hov-title {
    font-size: 34px;
    line-height: 1.2;
    color: var(--hov-charcoal);
    margin: 0 0 10px;
    font-weight: 600;
  }
  #hov-product-conversion-{{ section.id }} .hov-subtitle {
    font-size: 16px;
    line-height: 1.7;
    color: var(--hov-muted);
    margin: 0 0 14px;
  }
  #hov-product-conversion-{{ section.id }} .hov-reviews {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
  }
  #hov-product-conversion-{{ section.id }} .hov-stars {
    color: var(--hov-gold);
    letter-spacing: 1px;
    font-size: 16px;
  }
  #hov-product-conversion-{{ section.id }} .hov-review-text {
    color: var(--hov-muted);
    font-size: 14px;
  }
  #hov-product-conversion-{{ section.id }} .hov-price-wrap {
    padding: 20px 0 14px;
    border-top: 1px solid var(--hov-border);
    border-bottom: 1px solid var(--hov-border);
  }
  #hov-product-conversion-{{ section.id }} .hov-price-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  #hov-product-conversion-{{ section.id }} .hov-price-current {
    font-size: 36px;
    line-height: 1;
    font-weight: 700;
    color: var(--hov-emerald);
  }
  #hov-product-conversion-{{ section.id }} .hov-price-compare {
    font-size: 20px;
    color: var(--hov-muted);
    text-decoration: line-through;
  }
  #hov-product-conversion-{{ section.id }} .hov-discount-badge {
    display: inline-flex;
    align-items: center;
    background: var(--hov-emerald);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 12px;
    border-radius: 999px;
    letter-spacing: 0.2px;
  }
  #hov-product-conversion-{{ section.id }} .hov-tax-text {
    margin: 12px 0 0;
    font-size: 13px;
    color: var(--hov-muted);
  }
  #hov-product-conversion-{{ section.id }} .hov-urgency {
    margin-top: 18px;
    background: #fff;
    border: 1px solid var(--hov-border);
    border-radius: 16px;
    padding: 12px 14px;
    color: var(--hov-charcoal);
    font-size: 14px;
    font-weight: 500;
  }
  #hov-product-conversion-{{ section.id }} .hov-trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 18px 0 24px;
  }
  #hov-product-conversion-{{ section.id }} .hov-trust-badges span {
    display: inline-flex;
    align-items: center;
    padding: 10px 14px;
    background: #fff;
    border: 1px solid var(--hov-border);
    border-radius: 999px;
    color: var(--hov-charcoal);
    font-size: 13px;
    font-weight: 500;
  }
  #hov-product-conversion-{{ section.id }} .hov-product-form {
    margin-top: 8px;
  }
  #hov-product-conversion-{{ section.id }} .hov-label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--hov-charcoal);
    margin-bottom: 8px;
  }
  #hov-product-conversion-{{ section.id }} .hov-variant-wrap,
  #hov-product-conversion-{{ section.id }} .hov-qty-wrap {
    margin-bottom: 16px;
  }
  #hov-product-conversion-{{ section.id }} .hov-variant-select,
  #hov-product-conversion-{{ section.id }} .hov-quantity-input {
    width: 100%;
    min-height: 52px;
    border: 1px solid var(--hov-border);
    border-radius: 14px;
    background: #fff;
    padding: 0 16px;
    font-size: 15px;
    color: var(--hov-charcoal);
    outline: none;
    box-shadow: none;
  }
  #hov-product-conversion-{{ section.id }} .hov-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 8px;
  }
  #hov-product-conversion-{{ section.id }} .hov-btn {
    min-height: 56px;
    border-radius: 16px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
    border: none;
  }
  #hov-product-conversion-{{ section.id }} .hov-btn-primary {
    background: var(--hov-emerald);
    color: #fff;
  }
  #hov-product-conversion-{{ section.id }} .hov-btn-primary:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }
  #hov-product-conversion-{{ section.id }} .hov-btn-secondary {
    background: transparent;
    color: var(--hov-emerald);
    border: 1px solid var(--hov-emerald);
  }
  #hov-product-conversion-{{ section.id }} .hov-btn-secondary:hover {
    background: rgba(15, 59, 46, 0.05);
  }
  #hov-product-conversion-{{ section.id }} .hov-reassurance {
    margin-top: 18px;
    color: var(--hov-muted);
    font-size: 14px;
    line-height: 1.7;
  }
  #hov-product-conversion-{{ section.id }} .hov-reassurance p {
    margin: 4px 0;
  }
  #hov-product-conversion-{{ section.id }} .hov-description {
    margin-top: 30px;
    background: #fff;
    border: 1px solid var(--hov-border);
    border-radius: 20px;
    padding: 24px;
  }
  #hov-product-conversion-{{ section.id }} .hov-description h3 {
    margin: 0 0 14px;
    font-size: 20px;
    color: var(--hov-charcoal);
  }
  #hov-product-conversion-{{ section.id }} .hov-description-content {
    color: var(--hov-muted);
    font-size: 15px;
    line-height: 1.8;
  }
  #hov-product-conversion-{{ section.id }} .hov-description-content p:first-child {
    margin-top: 0;
  }
  #hov-product-conversion-{{ section.id }} .hov-sticky-bar {
    position: fixed;
    bottom: 14px;
    left: 14px;
    right: 14px;
    z-index: 30;
    display: none;
  }
  #hov-product-conversion-{{ section.id }} .hov-sticky-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: rgba(255,255,255,0.96);
    border: 1px solid var(--hov-border);
    box-shadow: 0 12px 40px rgba(0,0,0,0.08);
    backdrop-filter: blur(10px);
    border-radius: 18px;
    padding: 12px;
  }
  #hov-product-conversion-{{ section.id }} .hov-sticky-price {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  #hov-product-conversion-{{ section.id }} .hov-sticky-current {
    color: var(--hov-emerald);
    font-weight: 700;
    font-size: 20px;
    line-height: 1;
  }
  #hov-product-conversion-{{ section.id }} .hov-sticky-compare {
    color: var(--hov-muted);
    text-decoration: line-through;
    font-size: 13px;
  }
  #hov-product-conversion-{{ section.id }} .hov-sticky-form {
    margin: 0;
  }
  #hov-product-conversion-{{ section.id }} .hov-sticky-btn {
    min-height: 46px;
    border: none;
    background: var(--hov-emerald);
    color: #fff;
    border-radius: 14px;
    padding: 0 18px;
    font-weight: 700;
    cursor: pointer;
  }
  @media screen and (max-width: 989px) {
    #hov-product-conversion-{{ section.id }} {
      padding: 24px 0 60px;
    }
    #hov-product-conversion-{{ section.id }} .hov-page-width {
      padding-left: 16px;
      padding-right: 16px;
    }
    #hov-product-conversion-{{ section.id }} .hov-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    #hov-product-conversion-{{ section.id }} .hov-media {
      flex-direction: column;
    }
    #hov-product-conversion-{{ section.id }} .hov-thumbnails {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      width: 100%;
      margin-top: 14px;
    }
    #hov-product-conversion-{{ section.id }} .hov-main-image {
      width: 100%;
    }
    #hov-product-conversion-{{ section.id }} .hov-zoom-lens,
    #hov-product-conversion-{{ section.id }} .hov-zoom-window {
      display: none;
    }
    #hov-product-conversion-{{ section.id }} .hov-title {
      font-size: 28px;
    }
    #hov-product-conversion-{{ section.id }} .hov-price-current {
      font-size: 30px;
    }
    #hov-product-conversion-{{ section.id }} .hov-buttons {
      grid-template-columns: 1fr;
    }
    #hov-product-conversion-{{ section.id }} .hov-sticky-bar {
      display: block;
    }
  }
</style>

{% render 'hov-product-makeover' %}

<script>
  (function () {
    var root = document.getElementById('hov-product-conversion-{{ section.id }}');
    if (!root) return;
    var media = root.querySelector('.hov-media');
    var mainWrap = root.querySelector('.hov-main-image');
    var main = root.querySelector('.hov-product-image');
    var thumbs = root.querySelector('.hov-thumbnails');
    var lens = root.querySelector('.hov-zoom-lens');
    var zoomWindow = root.querySelector('.hov-zoom-window');
    if (!main) return;

    function setZoomImage(url) {
      if (!zoomWindow || !url) return;
      zoomWindow.style.backgroundImage = 'url("' + url + '")';
    }

    function zoomUrlFor(el) {
      return (el && el.getAttribute('data-zoom-image')) || (el && el.getAttribute('data-full-image')) || '';
    }

    function swapMain(fullUrl, zoomUrl) {
      var resolvedZoom = zoomUrl || fullUrl || (main && main.src);
      if (resolvedZoom) setZoomImage(resolvedZoom);
      if (!fullUrl || main.getAttribute('src') === fullUrl) return;
      main.removeAttribute('srcset');
      main.src = fullUrl;
      if (mainWrap && resolvedZoom) mainWrap.setAttribute('data-zoom-image', resolvedZoom);
    }

    if (mainWrap) {
      var initialZoom = mainWrap.getAttribute('data-zoom-image') || (main && main.currentSrc) || (main && main.src);
      if (initialZoom) setZoomImage(initialZoom);
    }

    if (thumbs) {
      var activeThumb = thumbs.querySelector('.hov-thumb.is-active') || thumbs.querySelector('.hov-thumb');

      thumbs.addEventListener('mouseover', function (e) {
        var thumb = e.target.closest('.hov-thumb');
        if (!thumb || !thumbs.contains(thumb)) return;
        swapMain(thumb.getAttribute('data-full-image'), zoomUrlFor(thumb));
      });

      thumbs.addEventListener('mouseleave', function () {
        if (activeThumb) swapMain(activeThumb.getAttribute('data-full-image'), zoomUrlFor(activeThumb));
      });

      thumbs.addEventListener('click', function (e) {
        var thumb = e.target.closest('.hov-thumb');
        if (!thumb || !thumbs.contains(thumb)) return;
        thumbs.querySelectorAll('.hov-thumb.is-active').forEach(function (el) {
          el.classList.remove('is-active');
        });
        thumb.classList.add('is-active');
        activeThumb = thumb;
        swapMain(thumb.getAttribute('data-full-image'), zoomUrlFor(thumb));
      });
    }

    if (mainWrap && lens && zoomWindow && media && window.matchMedia('(hover: hover)').matches) {
      var rafId = null;
      var lastClientX = 0;
      var lastClientY = 0;

      function applyZoom() {
        rafId = null;
        var rect = mainWrap.getBoundingClientRect();
        if (!rect.width || !rect.height) return;

        var x = lastClientX - rect.left;
        var y = lastClientY - rect.top;
        if (x < 0 || y < 0 || x > rect.width || y > rect.height) return;

        var lensW = lens.offsetWidth;
        var lensH = lens.offsetHeight;
        if (!lensW || !lensH) return;

        var lensX = Math.max(0, Math.min(rect.width - lensW, x - lensW / 2));
        var lensY = Math.max(0, Math.min(rect.height - lensH, y - lensH / 2));
        lens.style.left = lensX + 'px';
        lens.style.top = lensY + 'px';

        var xRange = rect.width - lensW;
        var yRange = rect.height - lensH;
        var bgX = xRange > 0 ? (lensX / xRange) * 100 : 0;
        var bgY = yRange > 0 ? (lensY / yRange) * 100 : 0;
        zoomWindow.style.backgroundPosition = bgX + '% ' + bgY + '%';
      }

      function scheduleApply() {
        if (rafId === null) rafId = requestAnimationFrame(applyZoom);
      }

      mainWrap.addEventListener('mouseenter', function (e) {
        lastClientX = e.clientX;
        lastClientY = e.clientY;
        media.classList.add('is-zooming');
        scheduleApply();
      });

      mainWrap.addEventListener('mousemove', function (e) {
        lastClientX = e.clientX;
        lastClientY = e.clientY;
        scheduleApply();
      });

      mainWrap.addEventListener('mouseleave', function () {
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
        media.classList.remove('is-zooming');
      });

      var onLayoutShift = function () {
        if (media.classList.contains('is-zooming')) scheduleApply();
      };
      window.addEventListener('scroll', onLayoutShift, { passive: true });
      window.addEventListener('resize', onLayoutShift);
    }
  })();
</script>

{% schema %}
{
  "name": "HOV Product Conversion",
  "settings": [
    {
