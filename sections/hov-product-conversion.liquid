<script type="application/json" id="hov-variants-{{ section.id }}">
[
  {%- for v in current_product.variants -%}
    {%- assign cap = v.compare_at_price | default: 0 -%}
    {%- assign saved = cap | minus: v.price -%}
    {%- assign pct = 0 -%}
    {%- if cap > v.price -%}{%- assign pct = saved | times: 100 | divided_by: cap -%}{%- endif -%}
    {"id":{{ v.id }},"price":{{ v.price | money_without_trailing_zeros | json }},"compare":{% if cap > v.price %}{{ cap | money_without_trailing_zeros | json }}{% else %}null{% endif %},"pct":{{ pct }},"available":{{ v.available }}}{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
</script>

<script>
  (function () {
    var root = document.getElementById('hov-product-conversion-{{ section.id }}');
    if (!root) return;

    // Buy It Now: add the variant, then trigger Shopflo via the same function
    // the cart page's "Proceed to Checkout" button uses (handleFloCheckoutBtn).
    var hovBuyBtn = root.querySelector('#hov-buy-it-now-btn');
    var hovForm = root.querySelector('.hov-product-form');
    if (hovBuyBtn && hovForm) {
      hovBuyBtn.addEventListener('click', function (e) {
        e.preventDefault();
        var sel = hovForm.querySelector('select[name="id"]');
        var hidden = hovForm.querySelector('input[name="id"]');
        var vid = (sel && sel.value) || (hidden && hidden.value);
        var qtyInput = hovForm.querySelector('input[name="quantity"]');
        var qty = qtyInput ? (parseInt(qtyInput.value, 10) || 1) : 1;
        if (!vid) return;
        hovBuyBtn.disabled = true;
        var origText = hovBuyBtn.textContent;
        hovBuyBtn.textContent = 'Loading...';
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: parseInt(vid, 10), quantity: qty })
        })
          .then(function (r) { return r.json(); })
          .then(function () {
            if (typeof window.handleFloCheckoutBtn === 'function') {
              window.handleFloCheckoutBtn();
            } else {
              console.error('[hov] handleFloCheckoutBtn not available — Shopflo bundle did not load.');
              hovBuyBtn.textContent = origText;
              hovBuyBtn.disabled = false;
            }
          })
          .catch(function () {
            hovBuyBtn.textContent = origText;
            hovBuyBtn.disabled = false;
          });
      });
    }

    try {
      var variantData = JSON.parse(document.getElementById('hov-variants-{{ section.id }}').textContent);
      var select = root.querySelector('.hov-variant-select');
      var stickyCur = root.querySelector('.hov-sticky-current');
      var stickyCmp = root.querySelector('.hov-sticky-compare');

      function applyVariant(id) {
        var v = variantData.find(function (x) { return String(x.id) === String(id); });
        if (!v) return;
        var hasSale = !!v.compare && v.pct > 0;
        if (stickyCur) stickyCur.textContent = v.price;
        if (stickyCmp) {
          stickyCmp.textContent = hasSale ? v.compare : '';
          stickyCmp.hidden = !hasSale;
        }
      }
      if (select) select.addEventListener('change', function () { applyVariant(select.value); });
    } catch (e) {}

    var media = root.querySelector('.hov-media');
    var mainWrap = root.querySelector('.hov-main-image');
    var main = root.querySelector('.hov-product-image');
    var thumbs = root.querySelector('.hov-thumbnails');
    var lens = root.querySelector('.hov-zoom-lens');
    var zoomWindow = root.querySelector('.hov-zoom-window');
    if (!main) return;

    function setZoomImage(url) {
      if (!zoomWindow || !url) return;
      zoomWindow.style.backgroundImage = 'url("' + url + '")';
    }

    function zoomUrlFor(el) {
      return (el && el.getAttribute('data-zoom-image')) || (el && el.getAttribute('data-full-image')) || '';
    }

    function swapMain(fullUrl, zoomUrl) {
      var resolvedZoom = zoomUrl || fullUrl || (main && main.src);
      if (resolvedZoom) setZoomImage(resolvedZoom);
      if (!fullUrl || main.getAttribute('src') === fullUrl) return;
      main.removeAttribute('srcset');
      main.src = fullUrl;
      if (mainWrap && resolvedZoom) mainWrap.setAttribute('data-zoom-image', resolvedZoom);
    }

    if (mainWrap) {
      var initialZoom = mainWrap.getAttribute('data-zoom-image') || (main && main.currentSrc) || (main && main.src);
      if (initialZoom) setZoomImage(initialZoom);
    }

    if (thumbs) {
      var activeThumb = thumbs.querySelector('.hov-thumb.is-active') || thumbs.querySelector('.hov-thumb');

      thumbs.addEventListener('mouseover', function (e) {
        var thumb = e.target.closest('.hov-thumb');
        if (!thumb || !thumbs.contains(thumb)) return;
        swapMain(thumb.getAttribute('data-full-image'), zoomUrlFor(thumb));
      });

      thumbs.addEventListener('mouseleave', function () {
        if (activeThumb) swapMain(activeThumb.getAttribute('data-full-image'), zoomUrlFor(activeThumb));
      });

      thumbs.addEventListener('click', function (e) {
        var thumb = e.target.closest('.hov-thumb');
        if (!thumb || !thumbs.contains(thumb)) return;
        thumbs.querySelectorAll('.hov-thumb.is-active').forEach(function (el) {
          el.classList.remove('is-active');
        });
        thumb.classList.add('is-active');
        activeThumb = thumb;
        swapMain(thumb.getAttribute('data-full-image'), zoomUrlFor(thumb));
      });
    }

    if (mainWrap && lens && zoomWindow && media && window.matchMedia('(hover: hover)').matches) {
      var rafId = null;
      var lastClientX = 0;
      var lastClientY = 0;

      function applyZoom() {
        rafId = null;
        var rect = mainWrap.getBoundingClientRect();
        if (!rect.width || !rect.height) return;

        var x = lastClientX - rect.left;
        var y = lastClientY - rect.top;
        if (x < 0 || y < 0 || x > rect.width || y > rect.height) return;

        var lensW = lens.offsetWidth;
        var lensH = lens.offsetHeight;
        if (!lensW || !lensH) return;

        var lensX = Math.max(0, Math.min(rect.width - lensW, x - lensW / 2));
        var lensY = Math.max(0, Math.min(rect.height - lensH, y - lensH / 2));
        lens.style.left = lensX + 'px';
        lens.style.top = lensY + 'px';

        var xRange = rect.width - lensW;
        var yRange = rect.height - lensH;
        var bgX = xRange > 0 ? (lensX / xRange) * 100 : 0;
        var bgY = yRange > 0 ? (lensY / yRange) * 100 : 0;
        zoomWindow.style.backgroundPosition = bgX + '% ' + bgY + '%';
      }

      function scheduleApply() {
        if (rafId === null) rafId = requestAnimationFrame(applyZoom);
      }

      mainWrap.addEventListener('mouseenter', function (e) {
        lastClientX = e.clientX;
        lastClientY = e.clientY;
        media.classList.add('is-zooming');
        scheduleApply();
      });

      mainWrap.addEventListener('mousemove', function (e) {
        lastClientX = e.clientX;
        lastClientY = e.clientY;
        scheduleApply();
      });

      mainWrap.addEventListener('mouseleave', function () {
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
        media.classList.remove('is-zooming');
      });

      var onLayoutShift = function () {
        if (media.classList.contains('is-zooming')) scheduleApply();
      };
      window.addEventListener('scroll', onLayoutShift, { passive: true });
      window.addEventListener('resize', onLayoutShift);
    }
  })();
</script>

