<section id="customer-love-{{ section.id }}" class="hov-customer-love">
  <div class="hov-love-inner">

    <div class="hov-love-heading-wrap">
      <h2 class="hov-love-heading">Loved By Our Beautiful Customers</h2>
      <div class="hov-love-line">
        <span></span>
      </div>
    </div>

    <div class="hov-love-content">

      <div class="hov-love-images">
        <div class="hov-love-img">
          <img src="https://cdn.shopify.com/s/files/1/0748/4935/3868/files/image_16.png?v=1779533632" alt="Happy customer wearing jewellery" loading="lazy">
        </div>

        <div class="hov-love-img">
          <img src="https://cdn.shopify.com/s/files/1/0748/4935/3868/files/image_17.png?v=1779533632" alt="Customer jewellery styling" loading="lazy">
        </div>

        <div class="hov-love-img">
          <img src="https://cdn.shopify.com/s/files/1/0748/4935/3868/files/image_15.png?v=1779533632" alt="Customer wearing necklace" loading="lazy">
        </div>

        <div class="hov-love-img">
          <img src="https://cdn.shopify.com/s/files/1/0748/4935/3868/files/image_18.png?v=1779533632" alt="Customer wearing bracelets" loading="lazy">
        </div>
      </div>

      <div class="hov-love-stats">

        <div class="hov-love-stat">
          <div class="hov-love-icon">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M16 11C17.657 11 19 9.657 19 8C19 6.343 17.657 5 16 5C14.343 5 13 6.343 13 8C13 9.657 14.343 11 16 11Z" stroke="currentColor" stroke-width="1.7"/>
              <path d="M8 11C9.657 11 11 9.657 11 8C11 6.343 9.657 5 8 5C6.343 5 5 6.343 5 8C5 9.657 6.343 11 8 11Z" stroke="currentColor" stroke-width="1.7"/>
              <path d="M3 19C3 16.239 5.239 14 8 14C10.761 14 13 16.239 13 19" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
              <path d="M11 17.5C11.836 15.466 13.836 14 16 14C18.761 14 21 16.239 21 19" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <div class="hov-love-number">10,000 +</div>
            <div class="hov-love-label">Happy Customers</div>
          </div>
        </div>

        <div class="hov-love-stat">
          <div class="hov-love-icon">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 3.5L14.65 8.87L20.58 9.73L16.29 13.91L17.3 19.82L12 17.03L6.7 19.82L7.71 13.91L3.42 9.73L9.35 8.87L12 3.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <div class="hov-love-number">4.7 +</div>
            <div class="hov-love-label">Customer Rated</div>
          </div>
        </div>

        <div class="hov-love-stat">
          <div class="hov-love-icon">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 3.5L19 6.5V11.5C19 16.2 16.1 20.1 12 21C7.9 20.1 5 16.2 5 11.5V6.5L12 3.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
              <path d="M9 12L11.1 14.1L15.5 9.7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <div class="hov-love-number">5000 +</div>
            <div class="hov-love-label">Trusted Across<br>India</div>
          </div>
        </div>

      </div>

    </div>

    <div class="hov-trust-marquee">
      <div class="hov-trust-track">

        {% for i in (1..2) %}
          <div class="hov-trust-card">
            <span class="hov-trust-icon">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M7 14C4.5 12.5 3.5 10.4 4.2 8.2C5.2 9.2 6.6 9.5 8.2 9.1C7.9 7.3 8.5 5.8 10 4.7C10.4 7.8 12 9.9 14.7 11.1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M18 7C17.8 10.8 16.5 14 13.8 16.4C11.4 18.5 8.6 19.1 6 18.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                <path d="M8 17C10.8 15.8 13.2 13.8 15.2 11" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
              </svg>
            </span>
            <span>Lust Tarnish &<br>Waterproof/Sweat proof</span>
          </div>

          <div class="hov-trust-card">
            <span class="hov-trust-icon">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 20S4.5 15.6 4.5 9.7C4.5 7.3 6.1 5.7 8.2 5.7C9.5 5.7 10.8 6.5 12 8C13.2 6.5 14.5 5.7 15.8 5.7C17.9 5.7 19.5 7.3 19.5 9.7C19.5 15.6 12 20 12 20Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                <path d="M8 10.5H11M9.5 9V12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </span>
            <span>Hypoallergenic &<br>Skin Safe</span>
          </div>

          <div class="hov-trust-card">
            <span class="hov-trust-icon">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M6 5H18L21 10L12 20L3 10L6 5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                <path d="M3 10H21M8 5L10 10L12 20L14 10L16 5" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
              </svg>
            </span>
            <span>Premium 18k Gold<br>Plated</span>
          </div>

          <div class="hov-trust-card">
            <span class="hov-trust-icon">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 3.5C12 3.5 6.5 9.2 6.5 14C6.5 17.3 8.9 20 12 20C15.1 20 17.5 17.3 17.5 14C17.5 9.2 12 3.5 12 3.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
              </svg>
            </span>
            <span>Made in India</span>
          </div>
        {% endfor %}

      </div>
    </div>

  </div>
</section>

<style>
  #customer-love-{{ section.id }} {
    width: 100%;
    background: #ffffff;
    padding: 34px 18px 30px;
    box-sizing: border-box;
    overflow: hidden;
  }

  #customer-love-{{ section.id }} * {
    box-sizing: border-box;
  }

  #customer-love-{{ section.id }} .hov-love-inner {
    max-width: 900px;
    margin: 0 auto;
  }

  #customer-love-{{ section.id }} .hov-love-heading-wrap {
    text-align: center;
    margin-bottom: 30px;
  }

  #customer-love-{{ section.id }} .hov-love-heading {
    margin: 0;
    color: #0F3B2E;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0.1px;
  }

  #customer-love-{{ section.id }} .hov-love-line {
    width: 48%;
    max-width: 410px;
    min-width: 220px;
    height: 12px;
    margin: 8px auto 0;
    position: relative;
  }

  #customer-love-{{ section.id }} .hov-love-line::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 5px;
    height: 2px;
    background: #000000;
  }

  #customer-love-{{ section.id }} .hov-love-line::after,
  #customer-love-{{ section.id }} .hov-love-line span::after {
    content: "";
    position: absolute;
    top: 1px;
    width: 9px;
    height: 9px;
    background: #000000;
    transform: rotate(45deg);
  }

  #customer-love-{{ section.id }} .hov-love-line::after {
    left: -1px;
  }

  #customer-love-{{ section.id }} .hov-love-line span::after {
    right: -1px;
  }

  #customer-love-{{ section.id }} .hov-love-content {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 42px;
    align-items: center;
  }

  #customer-love-{{ section.id }} .hov-love-images {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  #customer-love-{{ section.id }} .hov-love-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f7f0ea;
  }

  #customer-love-{{ section.id }} .hov-love-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #customer-love-{{ section.id }} .hov-love-stats {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  #customer-love-{{ section.id }} .hov-love-stat {
    min-height: 78px;
    background: #0F3B2E;
    color: #ffffff;
    border-radius: 6px;
    padding: 15px 18px;
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 14px;
    align-items: center;
    box-shadow: 0 4px 10px rgba(15, 59, 46, 0.18);
  }

  #customer-love-{{ section.id }} .hov-love-icon {
    width: 28px;
    height: 28px;
    color: #ffffff;
  }

  #customer-love-{{ section.id }} .hov-love-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #customer-love-{{ section.id }} .hov-love-number {
    font-size: 20px;
    line-height: 1.1;
    font-weight: 400;
    letter-spacing: 0.2px;
  }

  #customer-love-{{ section.id }} .hov-love-label {
    margin-top: 5px;
    font-size: 11px;
    line-height: 1.25;
    color: rgba(255,255,255,0.9);
  }

  #customer-love-{{ section.id }} .hov-trust-marquee {
    margin-top: 22px;
    width: 100%;
    overflow: hidden;
    padding: 0 0 4px;
  }

  #customer-love-{{ section.id }} .hov-trust-track {
    display: flex;
    gap: 8px;
    width: max-content;
    animation: hovTrustScroll-{{ section.id }} 18s linear infinite;
    will-change: transform;
  }

  #customer-love-{{ section.id }} .hov-trust-marquee:hover .hov-trust-track {
    animation-play-state: paused;
  }

  #customer-love-{{ section.id }} .hov-trust-card {
    flex: 0 0 230px;
    min-height: 52px;
    background: #fffdf2;
    border: 1.1px solid #111111;
    border-radius: 7px;
    color: #111111;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 13px;
    font-size: 14px;
    line-height: 1.1;
    font-weight: 400;
    white-space: nowrap;
  }

  #customer-love-{{ section.id }} .hov-trust-icon {
    width: 21px;
    height: 21px;
    flex: 0 0 21px;
    color: #111111;
  }

  #customer-love-{{ section.id }} .hov-trust-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  @keyframes hovTrustScroll-{{ section.id }} {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 4px));
    }
  }

  @media screen and (max-width: 768px) {
    #customer-love-{{ section.id }} {
      padding: 30px 12px 28px;
    }

    #customer-love-{{ section.id }} .hov-love-heading-wrap {
      margin-bottom: 22px;
    }

    #customer-love-{{ section.id }} .hov-love-heading {
      font-size: 20px;
    }

    #customer-love-{{ section.id }} .hov-love-line {
      width: 72%;
      min-width: 210px;
      max-width: 380px;
      margin-top: 7px;
    }

    #customer-love-{{ section.id }} .hov-love-content {
      grid-template-columns: 1fr 0.82fr;
      gap: 14px;
      align-items: center;
    }

    #customer-love-{{ section.id }} .hov-love-images {
      gap: 7px;
    }

    #customer-love-{{ section.id }} .hov-love-stats {
      gap: 11px;
    }

    #customer-love-{{ section.id }} .hov-love-stat {
      min-height: 70px;
      padding: 10px 8px;
      grid-template-columns: 22px 1fr;
      gap: 8px;
      border-radius: 5px;
    }

    #customer-love-{{ section.id }} .hov-love-icon {
      width: 21px;
      height: 21px;
    }

    #customer-love-{{ section.id }} .hov-love-number {
      font-size: 14px;
    }

    #customer-love-{{ section.id }} .hov-love-label {
      font-size: 8.5px;
      margin-top: 4px;
    }

    #customer-love-{{ section.id }} .hov-trust-marquee {
      margin-top: 18px;
    }

    #customer-love-{{ section.id }} .hov-trust-track {
      gap: 6px;
      animation-duration: 12s;
    }

    #customer-love-{{ section.id }} .hov-trust-card {
      flex: 0 0 142px;
      min-height: 40px;
      border-radius: 6px;
      padding: 6px 8px;
      gap: 6px;
      font-size: 8.8px;
      line-height: 1.08;
      border-width: 1px;
    }

    #customer-love-{{ section.id }} .hov-trust-icon {
      width: 15px;
      height: 15px;
      flex-basis: 15px;
    }
  }

  @media screen and (max-width: 390px) {
    #customer-love-{{ section.id }} .hov-love-content {
      gap: 10px;
    }

    #customer-love-{{ section.id }} .hov-love-stat {
      min-height: 64px;
      padding: 9px 7px;
    }

    #customer-love-{{ section.id }} .hov-love-number {
      font-size: 13px;
    }

    #customer-love-{{ section.id }} .hov-trust-card {
      flex-basis: 136px;
      font-size: 8.4px;
    }
  }
</style>

{% schema %}
{
  "name": "Customer Love",
  "settings": [],
  "presets": [
    {
      "name": "Customer Love"
    }
  ]
}
{% endschema %}