{%- assign secSt = section.settings -%}

{%- capture topHeader -%}
<div class="top-header fl f-aic f-col f-row-md fullwidth" style="background:{% if secSt.header_bgg != blank %}{{ secSt.header_bgg }}{% else %}{{ secSt.header_bg }}{% endif %};padding:{{ secSt.header_padding }}px 0;color:{{ secSt.header_cl }};">
    <div class="header-txt fl1 left-hdr hide-sm hide-md">
        {% if secSt.phone != blank %}
            <i class="at at-phone-l"></i> {{ secSt.phone }}
        {% endif %}
        {% if secSt.email != blank %}
            <i class="at at-envelope1"></i> {{ secSt.email }}
        {% endif %}
    </div>
    <div class="header-txt fl1 middle-hdr tc">
        {{ secSt.free_shipping_text }}
    </div>
    <div class="header-social fl1 right-hdr tr hide-sm hide-md">
        <ul class="list list--inline social-icons">
            {% if secSt.facebook_url != blank %}
            <li>
                <a class="social-link" href="{{ secSt.facebook_url }}" title="{{ shop.name }} on Facebook" target="_blank">
                    <i class="at at-facebook" aria-hidden="true"><span class="sr-only">Facebook</span>
                </a>
            </li>
            {% endif %}
            {% if secSt.twitter_url != blank %}
                <li>
                    <a class="social-link" href="{{ secSt.twitter_url }}" title="{{ shop.name }} on Twitter" target="_blank">
                    <i class="at at-twitter-x" aria-hidden="true"><span class="sr-only">Twitter</span>
                    </a>
                </li>
            {% endif %}
            {% if secSt.pinterest_url != blank %}
                <li>
                    <a class="social-link" href="{{ secSt.pinterest_url }}" title="{{ shop.name }} on Pinterest" target="_blank">
                    <i class="at at-pinterest-p" aria-hidden="true"><span class="sr-only">Pinterest</span>
                    </a>
                </li>
            {% endif %}
            {% if secSt.instagram_url != blank %}
            <li>
                <a class="social-link" href="{{ secSt.instagram_url }}" title="{{ shop.name }} on Instagram" target="_blank">
                    <i class="at at-instagram" aria-hidden="true"><span class="sr-only">Instagram</span>
                </a>
            </li>
            {% endif %}
        </ul>
    </div>
</div>
{%- endcapture -%}

{%- capture topInfoBar -%}
<div class="top-bar fl f-aic{% if secSt.hide_mobile %} hide-sm{% endif %}{% if secSt.hided %} hide-md hide-lg{% endif %}" style="background:{% if secSt.bgg != blank %}{{ secSt.bgg }}{% else %}{{secSt.bg}}{% endif %};padding:{{secSt.padding}}px 0;">
    <div class="page-width wd100" id="carousel-{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="scrolling">
        <div class="fl scrollingBar" id="st{{ section.id }}" style="--spd:{{ secSt.speed }}s;--spdm:{{ secSt.speedm }}s;--tcl:{{ secSt.cl }};--tfs:{{ secSt.fs }}px;--tfsm:{{ secSt.fsm }}px;--tff:var(--{{secSt.ff}});--tfw:{{ secSt.tfw }};">
            {% for block in section.blocks limit: section.blocks.size %}
                {%- assign blkSt = block.settings -%}
                {% if blkSt.title != blank %}
                    <div class="ttlTxt fl1 tc std{{ section.id }}" {{ block.shopify_attributes }}>
                        <{% if blkSt.url == blank %}span{% else %}a href="{{ blkSt.url }}"{% endif %}>
                            {% if blkSt.icn != blank %}<i class="at {{ blkSt.icn }} mr10"></i>{% endif %} {{ blkSt.title }}
                        </{% if blkSt.url == blank %}span{% else %}a{% endif %}>
                    </div>
                {% endif %}
            {% endfor %}
            {% for block in section.blocks limit: section.blocks.size %}
                {%- assign blkSt = block.settings -%}
                {% if blkSt.title != blank %}
                    <div class="ttlTxt fl1 tc">
                        <{% if blkSt.url == blank %}span{% else %}a href="{{ blkSt.url }}"{% endif %}>
                            {% if blkSt.icn != blank %}<i class="at {{ blkSt.icn }} mr10"></i>{% endif %} {{ blkSt.title }}
                        </{% if blkSt.url == blank %}span{% else %}a{% endif %}>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</div>
<script>
    var textWd = document.querySelectorAll('.std{{ section.id }}'),
        element = document.getElementById('st{{ section.id }}'),
        winWd = window.innerWidth,
        width = 0;
    for (var i = 0; i < textWd.length; i++) {
        width += textWd[i].offsetWidth;
    }
    if (winWd < width) {
        element.style.width = width * 2 + 'px';
    } else {
        element.style.width = window.innerWidth * 2 + 'px';
    }
</script>
{%- endcapture -%}

{{ topHeader | strip_newlines | remove: "  " | remove: "	" }}
{{ topInfoBar | strip_newlines | remove: "  " | remove: "	" }}

