<style>
  /* =========================
     DESKTOP NAVIGATION
  ========================= */
  .hov-main-navigation {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hov-nav-list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hov-nav-item {
    position: relative;
    margin: 0;
    padding: 0;
  }

  .hov-nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 24px 0;
    color: #0F3B2E;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.35px;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.25s ease;
  }

  .hov-nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 18px;
    width: 0;
    height: 2px;
    background: #C8B28A;
    transition: width 0.25s ease;
  }

  .hov-nav-link:hover {
    color: #C8B28A;
  }

  .hov-nav-link:hover::after {
    width: 100%;
  }

  .hov-dropdown-arrow {
    font-size: 10px;
    line-height: 1;
    margin-top: 2px;
  }

  .hov-dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    min-width: 230px;
    margin: 0;
    padding: 10px 0;
    list-style: none;
    background: #ffffff;
    border: 1px solid rgba(200, 178, 138, 0.35);
    border-radius: 14px;
    box-shadow: 0 18px 45px rgba(15, 59, 46, 0.12);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(-50%) translateY(12px);
    transition: all 0.25s ease;
    z-index: 9999;
  }

  .hov-dropdown-right {
    left: auto;
    right: 0;
    transform: translateY(12px);
  }

  .hov-nav-item:hover > .hov-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .hov-nav-item:hover > .hov-dropdown-right {
    transform: translateY(0);
  }

  .hov-dropdown li {
    margin: 0;
    padding: 0;
  }

  .hov-dropdown a {
    display: block;
    padding: 11px 18px;
    color: #0F3B2E;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.2px;
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .hov-dropdown a:hover {
    background: rgba(200, 178, 138, 0.13);
    color: #0F3B2E;
    padding-left: 23px;
  }

  /* =========================
     MOBILE FULL SCREEN SIDEBAR
  ========================= */
  .hov-mobile-overlay {
    display: none !important;
  }

  .hov-mobile-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    background: #ffffff;
    transform: translateX(-105%);
    transition: transform 0.32s ease;
    z-index: 99999;
    overflow-y: auto;
    overflow-x: hidden;
    box-shadow: none;
    -webkit-overflow-scrolling: touch;
  }

  .hov-mobile-sidebar.is-open {
    transform: translateX(0);
  }

  .hov-mobile-header {
    position: sticky;
    top: 0;
    z-index: 2;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px;
    border-bottom: 1px solid rgba(15, 59, 46, 0.08);
  }

  .hov-mobile-title {
    color: #0F3B2E;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  .hov-mobile-close {
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 50%;
    background: rgba(200, 178, 138, 0.16);
    color: #0F3B2E;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
  }

  .hov-mobile-nav-inner {
    padding: 8px 14px 28px;
  }

  .hov-mobile-nav-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hov-mobile-nav-list > li {
    border-bottom: 1px solid rgba(15, 59, 46, 0.08);
  }

  .hov-mobile-nav-list a,
  .hov-mobile-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 15px 6px;
    color: #0F3B2E;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.25px;
    text-decoration: none;
    cursor: pointer;
  }

  .hov-mobile-summary {
    list-style: none;
  }

  .hov-mobile-summary::-webkit-details-marker {
    display: none;
  }

  .hov-mobile-plus {
    font-size: 18px;
    font-weight: 400;
    transition: transform 0.2s ease;
  }

  .hov-mobile-details[open] .hov-mobile-plus {
    transform: rotate(45deg);
  }

  .hov-mobile-details[open] .hov-mobile-summary {
    color: #C8B28A;
  }

  /* =========================
     MOBILE SHOP BY CATEGORY CARDS
  ========================= */
  .hov-mobile-category-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin: 2px 0 16px;
    padding: 0;
    list-style: none;
  }

  .hov-mobile-category-grid li {
    border: 0 !important;
    margin: 0;
    padding: 0;
  }

  .hov-mobile-category-card {
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 74px;
    padding: 8px !important;
    background: #0F3B2E;
    border-radius: 16px;
    color: #ffffff !important;
    text-decoration: none;
    overflow: hidden;
  }

  .hov-mobile-category-img {
    flex: 0 0 52px;
    width: 52px;
    height: 52px;
    border-radius: 13px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.14);
  }

  .hov-mobile-category-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hov-mobile-category-img svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hov-mobile-category-text {
    flex: 1;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0;
  }

  .hov-mobile-category-arrow {
    flex: 0 0 auto;
    color: #ffffff;
    font-size: 22px;
    font-weight: 400;
    line-height: 1;
    padding-right: 2px;
  }

  .hov-mobile-submenu {
    margin: 0;
    padding: 0 0 12px 14px;
    list-style: none;
  }

  .hov-mobile-submenu li {
    border-bottom: 0;
  }

  .hov-mobile-submenu a {
    padding: 9px 0;
    color: rgba(15, 59, 46, 0.82);
    font-size: 14px;
    font-weight: 500;
  }

  .hov-mobile-submenu a:hover {
    color: #C8B28A;
  }

  html.hov-menu-open,
  body.hov-menu-open {
    overflow: hidden !important;
    height: 100% !important;
    touch-action: none;
  }

  @media screen and (max-width: 989px) {
    .hov-main-navigation {
      display: none !important;
    }
  }

  @media screen and (min-width: 990px) {
    .hov-mobile-overlay,
    .hov-mobile-sidebar {
      display: none !important;
    }
  }

  @media screen and (max-width: 380px) {
    .hov-mobile-category-card {
      min-height: 68px;
      padding: 7px !important;
      gap: 7px;
    }

    .hov-mobile-category-img {
      flex-basis: 48px;
      width: 48px;
      height: 48px;
    }

    .hov-mobile-category-text {
      font-size: 13px;
    }

    .hov-mobile-category-arrow {
      font-size: 20px;
    }
  }
</style>

