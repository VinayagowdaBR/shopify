{% comment %}
Collection Banner + 3 Products (Avone Theme, 4 per view desktop, 1.3 mobile)
{% endcomment %}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css">

<section class="collection-banner-with-products" style="background:#fff;">
  <div class="page-width">
    {% if section.settings.title != blank %}
      <div class="section-header">
        <h2 class="section-title">{{ section.settings.title }}</h2>
      </div>
    {% endif %}

    <div class="swiper collection-banner-slider">
      <div class="swiper-wrapper">

        {% for block in section.blocks %}
          <div class="swiper-slide">
            <div class="collection-banner-item">

              {% if block.settings.banner_image != blank %}
                <a href="{{ block.settings.collection_url | default: '#' }}" class="banner-link">
                  <img
                    src="{{ block.settings.banner_image | img_url: 'master' }}"
                    alt="{{ block.settings.collection_title | escape }}"
                    class="banner-image"
                    loading="lazy"
                  >
                </a>
              {% endif %}

              <div class="collection-products-row">
                {% for i in (1..3) %}
                  {% capture product_key %}product_{{ i }}{% endcapture %}
                  {% assign selected_product = all_products[block.settings[product_key]] %}
                  {% if selected_product %}
                    <a href="{{ selected_product.url }}" class="product-thumb">
                      <img
                        src="{{ selected_product.featured_image | img_url: '400x' }}"
                        alt="{{ selected_product.title | escape }}"
                        loading="lazy"
                      >
                    </a>
                  {% endif %}
                {% endfor %}
              </div>

            </div>
          </div>
        {% endfor %}

      </div>

      <!-- Swiper Controls -->
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const autoplayEnabled = {{ section.settings.enable_autoplay | json }};
    const swiper = new Swiper('.collection-banner-slider', {
      slidesPerView: 1.3,
      spaceBetween: 15,
      centeredSlides: false,
      loop: true,
      autoplay: autoplayEnabled ? {
        delay: {{ section.settings.autoplay_speed | default: 3000 }},
        disableOnInteraction: false
      } : false,
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev'
      },
      breakpoints: {
        768: { slidesPerView: 2, spaceBetween: 20 },
        1024: { slidesPerView: 4, spaceBetween: 25 }
      }
    });
  });
</script>

<style>
.collection-banner-with-products {
  padding: 30px 0;
}
.collection-banner-with-products .section-header {
  text-align: center;
  margin-bottom: 20px;
}
.collection-banner-with-products .section-title {
  font-size: 26px;
  font-weight: 600;
  letter-spacing: 0.5px;
}
.collection-banner-item {
  position: relative;
}
.banner-link img.banner-image {
  width: 100%;
  border-radius: 16px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.05);
  display: block;
}
.collection-products-row {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin-top: -8%;
}
.collection-products-row .product-thumb {
  width: 22%;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 3px 6px rgba(0,0,0,0.08);
  background: #fff;
  transition: transform 0.3s ease;
}
.collection-products-row .product-thumb:hover {
  transform: scale(1.05);
}
.collection-products-row .product-thumb img {
  width: 100%;
  display: block;
}
/* 1. Container for the button: Ensure Perfect Circle and Smaller Size */
.swiper-button-prev,
.swiper-button-next {
    /* Set the background to green */
    background: #1b352c !important;
    /* Set the arrow color to white */
    color: #FFFFFF !important;

    /* REDUCED SIZE for a smaller look */
    width: 28px !important; 
    height: 28px !important; 
    
    /* Ensure perfect circle override */
    border-radius: 50% !important; 
    
    /* Ensure proper centering/display override */
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    
    /* Ensure no distracting shadow */
    box-shadow: none !important; 
    
    /* Reset margins or positioning if they affect shape */
    margin: 0 !important;
    padding: 0 !important;
}

/* 2. The arrow icon itself (the :after content) - Set Small Arrow Size */
.swiper-button-prev:after,
.swiper-button-next:after {
    /* Inherit white color */
    color: inherit; 
    
    /* ADJUSTED FONT-SIZE for a very small arrow (5-7px visual size) */
    font-size: 7px !important; 
    
    /* Reset line height which can affect vertical centering and shape */
    line-height: 1 !important;
    
    /* Remove any default Swiper content padding */
    padding: 0 !important;
}

@media screen and (max-width: 767px) {
  .collection-products-row {
    margin-top: -12%;
  }
  .collection-products-row .product-thumb {
    width: 25%;
  }
  .collection-banner-with-products .section-title {
    font-size: 20px;
  }
}
</style>

{% schema %}
{
  "name": "Collection Banners P",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Latest Collections"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed (ms)",
      "min": 1000,
      "max": 9000,
      "step": 500,
      "default": 3000
    }
  ],
  "blocks": [
    {
      "type": "collection_slide",
      "name": "Collection Slide",
      "settings": [
        { "type": "image_picker", "id": "banner_image", "label": "Banner image" },
        { "type": "url", "id": "collection_url", "label": "Collection link" },
        { "type": "text", "id": "collection_title", "label": "Collection title (alt text)" },
        { "type": "header", "content": "Select 3 Products" },
        { "type": "product", "id": "product_1", "label": "Select Product 1" },
        { "type": "product", "id": "product_2", "label": "Select Product 2" },
        { "type": "product", "id": "product_3", "label": "Select Product 3" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Banners P",
      "category": "Collection"
    }
  ]
}
{% endschema %}
