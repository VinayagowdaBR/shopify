      "name": "t:sections.custom_liquid.name",
      "settings": {
        "title": "",
        "subtitle": "",
        "custom_liquid": "<div class=\"hov-faq-wrapper\">\n\n  <div class=\"hov-accordion\">\n\n    <div class=\"hov-accordion-item\">\n      <button class=\"hov-accordion-header\">\n        <span>What is House of Viya?</span>\n        <span class=\"hov-chevron\">⌄</span>\n      </button>\n      <div class=\"hov-accordion-content\">\n        <p>\n          House of Viya is a contemporary jewellery brand dedicated to crafting elegant silver and gold-plated designs that blend timeless aesthetics with modern sensibilities. Each piece is thoughtfully designed to be worn effortlessly—every day and beyond.\n        </p>\n      </div>\n    </div>\n\n    <div class=\"hov-accordion-item\">\n      <button class=\"hov-accordion-header\">\n        <span>What kind of jewellery does House of Viya offer?</span>\n        <span class=\"hov-chevron\">⌄</span>\n      </button>\n      <div class=\"hov-accordion-content\">\n        <p>\n          We offer a curated selection of rings, earrings, bracelets, necklaces, pendants, and bangles—crafted in premium 925 sterling silver and high-quality anti-tarnish gold plating, designed for everyday elegance and special moments alike.\n        </p>\n      </div>\n    </div>\n\n    <div class=\"hov-accordion-item\">\n      <button class=\"hov-accordion-header\">\n        <span>Is House of Viya jewellery authentic?</span>\n        <span class=\"hov-chevron\">⌄</span>\n      </button>\n      <div class=\"hov-accordion-content\">\n        <p>\n          Yes. All our silver jewellery is made using genuine 925 sterling silver. Our gold-plated pieces use premium anti-tarnish plating techniques to ensure lasting shine and quality.\n        </p>\n      </div>\n    </div>\n\n    <div class=\"hov-accordion-item\">\n      <button class=\"hov-accordion-header\">\n        <span>Is your jewellery suitable for sensitive skin?</span>\n        <span class=\"hov-chevron\">⌄</span>\n      </button>\n      <div class=\"hov-accordion-content\">\n        <p>\n          Absolutely. Our jewellery is crafted with skin-friendly materials and is nickel-free, making it suitable for most sensitive skin types. We prioritize comfort as much as craftsmanship.\n        </p>\n      </div>\n    </div>\n\n    <div class=\"hov-accordion-item\">\n      <button class=\"hov-accordion-header\">\n        <span>Do you offer custom or personalized jewellery?</span>\n        <span class=\"hov-chevron\">⌄</span>\n      </button>\n      <div class=\"hov-accordion-content\">\n        <p>\n          Select designs may be customized or personalized. We recommend reaching out to our team via WhatsApp for availability, timelines, and design possibilities.\n        </p>\n      </div>\n    </div>\n\n    <div class=\"hov-accordion-item\">\n      <button class=\"hov-accordion-header\">\n        <span>What is your return and exchange policy?</span>\n        <span class=\"hov-chevron\">⌄</span>\n      </button>\n      <div class=\"hov-accordion-content\">\n        <p>\n          We offer a hassle-free return and exchange policy in line with our brand standards. Please refer to our Refund & Shipping Policy page for complete details.\n        </p>\n      </div>\n    </div>\n\n    <div class=\"hov-accordion-item\">\n      <button class=\"hov-accordion-header\">\n        <span>How can I get in touch with House of Viya?</span>\n        <span class=\"hov-chevron\">⌄</span>\n      </button>\n      <div class=\"hov-accordion-content\">\n        <p>\n          You can reach us via WhatsApp, email, or through the Contact Us page. Our support team is always happy to assist you.\n        </p>\n      </div>\n    </div>\n\n  </div>\n</div>\n<script>\ndocument.querySelectorAll('.hov-accordion-header').forEach(header => {\n  header.addEventListener('click', () => {\n    const item = header.parentElement;\n\n    document.querySelectorAll('.hov-accordion-item').forEach(i => {\n      if (i !== item) {\n        i.classList.remove('active');\n        i.querySelector('.hov-accordion-content').style.maxHeight = null;\n      }\n    });\n\n    item.classList.toggle('active');\n    const content = item.querySelector('.hov-accordion-content');\n    content.style.maxHeight = item.classList.contains('active')\n      ? content.scrollHeight + 'px'\n      : null;\n  });\n});\n</script>\n<style>\n.hov-faq-wrapper {\n  max-width: 900px;\n  margin: 60px auto;\n  padding: 0 20px;\n}\n\n.hov-faq-title {\n  text-align: center;\n  font-size: 32px;\n  margin-bottom: 30px;\n  font-family: \"Playfair Display\", serif;\n}\n\n.hov-accordion-item {\n  border-bottom: 1px solid #e5e5e5;\n}\n\n.hov-accordion-header {\n  width: 100%;\n  background: none;\n  border: none;\n  padding: 20px 0;\n  cursor: pointer;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-family: \"Playfair Display\", serif;\n  font-size: 18px;\n}\n\n.hov-chevron {\n  transition: transform 0.4s ease;\n}\n\n.hov-accordion-item.active .hov-chevron {\n  transform: rotate(180deg);\n}\n\n.hov-accordion-content {\n  max-height: 0;\n  overflow: hidden;\n  transition: max-height 0.7s ease;\n}\n\n.hov-accordion-content p {\n  font-family: 'Poppins', sans-serif;\n  font-size: 15px;\n  line-height: 1.8;\n  color: #555;\n  margin: 10px 0 25px;\n}\n</style>",
