    "custom_liquid_zPgqCr": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom_liquid.name",
      "settings": {
        "title": "",
        "subtitle": "",
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Ayarra Luxe - FAQ</title>\n    <style>\n      /* --- GLOBAL LAYOUT STYLES --- */\n      body {\n        margin: 0;\n        padding: 0;\n        background-color: #f9f9f9;\n      }\n      .page-width {\n        max-width: 1400px;\n        margin: 0 auto;\n        padding: 0 20px;\n      }\n      .h1 {\n        font-size: 28px;\n        margin-bottom: 25px;\n        color: #333;\n      }\n      .h4 {\n        font-size: 16px;\n        font-weight: 600;\n        margin: 0;\n        color: #444;\n      }\n\n      /* --- GRID STYLES --- */\n      .collapsible-content__grid {\n        display: grid;\n        grid-template-columns: 1fr 2fr;\n        gap: 40px;\n        margin-top: 30px;\n      }\n\n      /* --- FAQ SIDEBAR --- */\n      .faq-image-section {\n        background: #ffffff;\n        color: #000;\n        border: 2px solid #000000;\n        padding: 40px 25px;\n        border-radius: 8px;\n        text-align: center;\n        position: sticky;\n        top: 20px;\n        height: fit-content;\n      }\n\n      .Common {\n        font-size: 20px;\n        font-weight: 700;\n        margin-bottom: 5px;\n      }\n\n      .people-icon {\n        margin: 20px auto 15px;\n        width: 110px;\n        height: 110px;\n        background: #ffffff;\n        border-radius: 50%;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        overflow: hidden;\n        border: 4px solid #000;\n      }\n\n      .contact-image {\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        display: block;\n      }\n\n      .questions {\n        font-size: 14px;\n        margin-bottom: 8px;\n      }\n\n      .date-month {\n        font-size: 11px;\n        opacity: 0.8;\n        margin-bottom: 25px;\n      }\n\n      .whatsapp-chat {\n        display: inline-block;\n        padding: 10px 20px;\n        background-color: #25d366;\n        color: #fff;\n        text-decoration: none;\n        font-weight: bold;\n        border-radius: 5px;\n        transition: 0.2s;\n        font-size: 14px;\n      }\n\n      .whatsapp-chat:hover {\n        background-color: #128c7e;\n      }\n\n      /* --- ACCORDION --- */\n      .accordion {\n        width: 100%;\n      }\n\n      .accordion-item {\n        border-bottom: 1px solid #ddd;\n      }\n\n      .accordion-header {\n        padding: 15px 0;\n        cursor: pointer;\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        background: none;\n        border: none;\n      }\n\n      .indicator {\n        font-size: 1.8em;\n        margin-left: 15px;\n        transition: 0.3s;\n        width: 20px;\n        text-align: center;\n      }\n\n      .accordion-item.active .indicator {\n        transform: rotate(180deg);\n      }\n\n      .accordion-content {\n        max-height: 0;\n        overflow: hidden;\n        transition: max-height 0.4s ease-in-out;\n      }\n\n      .accordion-content p {\n        margin: 10px 0 20px;\n        font-size: 14px;\n        color: #666;\n        line-height: 1.5;\n      }\n\n      .accordion-item.active .accordion-content {\n        max-height: 300px;\n      }\n\n      /* --- MOBILE --- */\n      @media (max-width: 990px) {\n        .collapsible-content__grid {\n          grid-template-columns: 1fr;\n          gap: 30px;\n        }\n        .faq-image-section {\n          position: relative;\n          top: 0;\n        }\n      }\n    </style>\n  </head>\n\n  <body>\n    <div class=\"page-width\">\n      <div class=\"grid collapsible-content__grid\">\n\n        <!-- LEFT SIDEBAR -->\n        <div class=\"grid__item collapsible-content__grid-item\">\n          <div class=\"faq-image-section\">\n            <div class=\"Common\">Common Questions</div>\n\n            <div class=\"people-icon\">\n              <img \n                src=\"https://static.vecteezy.com/system/resources/thumbnails/027/951/137/small/stylish-spectacles-guy-3d-avatar-character-illustrations-png.png\"\n                alt=\"Ayarra Luxe Customer Support\"\n                class=\"contact-image\"\n              >\n            </div>\n\n            <div class=\"questions\">Got more questions? We’re here to help.</div>\n            <div class=\"date-month\">Mon–Fri: 10am–6pm • Avg reply time: 2 hours</div>\n\n            <a href=\"https://wa.me/91XXXXXXXXXX?text=Hello%20I%20have%20a%20query%20about%20Ayarra%20Luxe\" \n               class=\"whatsapp-chat\">\n               Chat on WhatsApp\n            </a>\n          </div>\n        </div>\n\n        <!-- RIGHT ACCORDION -->\n        <div class=\"grid__item collapsible-section\">\n          <div class=\"accordion\">\n\n            <div class=\"accordion-item\">\n              <button class=\"accordion-header\">\n                <h3 class=\"h4\">What is Ayarra Luxe?</h3>\n                <span class=\"indicator\">+</span>\n              </button>\n              <div class=\"accordion-content\">\n                <p>\n                  Ayarra Luxe is a premium 925 silver jewellery brand offering elegant, tarnish-resistant pieces designed for everyday luxury and timeless style.\n                </p>\n              </div>\n            </div>\n\n            <div class=\"accordion-item\">\n              <button class=\"accordion-header\">\n                <h3 class=\"h4\">What types of jewellery do you offer?</h3>\n                <span class=\"indicator\">+</span>\n              </button>\n              <div class=\"accordion-content\">\n                <p>\n                  We offer 925 silver earrings, rings, bracelets, necklaces, pendants, and elegant collections crafted for both daily wear and special occasions.\n                </p>\n              </div>\n            </div>\n\n            <div class=\"accordion-item\">\n              <button class=\"accordion-header\">\n                <h3 class=\"h4\">Is your jewellery real sterling silver?</h3>\n                <span class=\"indicator\">+</span>\n              </button>\n              <div class=\"accordion-content\">\n                <p>\n                  Yes! Every Ayarra Luxe piece is made from authentic 925 sterling silver, known for its purity, durability, and long-lasting shine.\n                </p>\n              </div>\n            </div>\n\n            <div class=\"accordion-item\">\n              <button class=\"accordion-header\">\n                <h3 class=\"h4\">Is Ayarra Luxe jewellery tarnish-resistant?</h3>\n                <span class=\"indicator\">+</span>\n              </button>\n              <div class=\"accordion-content\">\n                <p>\n                  Our jewellery is crafted with advanced anti-tarnish coatings to keep your silver shine bright. Proper care ensures your pieces last beautifully for years.\n                </p>\n              </div>\n            </div>\n\n            <div class=\"accordion-item\">\n              <button class=\"accordion-header\">\n                <h3 class=\"h4\">Do you accept custom orders?</h3>\n                <span class=\"indicator\">+</span>\n              </button>\n              <div class=\"accordion-content\">\n                <p>\n                  Yes, we accept select custom requests for 925 silver pieces. Share your idea, and we’ll explore a beautiful customised design for you.\n                </p>\n              </div>\n            </div>\n\n            <div class=\"accordion-item\">\n              <button class=\"accordion-header\">\n                <h3 class=\"h4\">Do you offer international shipping?</h3>\n                <span class=\"indicator\">+</span>\n              </button>\n              <div class=\"accordion-content\">\n                <p>\n                  Yes! Ayarra Luxe ships worldwide. Delivery times may vary by country, and tracking details are provided for every order.\n                </p>\n              </div>\n            </div>\n\n            <div class=\"accordion-item\">\n              <button class=\"accordion-header\">\n                <h3 class=\"h4\">What is your return policy?</h3>\n                <span class=\"indicator\">+</span>\n              </button>\n              <div class=\"accordion-content\">\n                <p>\n                  We offer a 7-day return/exchange window for unworn items in original condition. For complete terms, please check our Return Policy page.\n                </p>\n              </div>\n            </div>\n\n            <div class=\"accordion-item\">\n              <button class=\"accordion-header\">\n                <h3 class=\"h4\">How can I contact customer support?</h3>\n                <span class=\"indicator\">+</span>\n              </button>\n              <div class=\"accordion-content\">\n                <p>\n                  You can reach us at <strong>support@ayarraluxe.com</strong> or through the Contact Us page. Our team replies within 24 business hours.\n                </p>\n              </div>\n            </div>\n\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n    <script>\n      document.querySelectorAll('.accordion-header').forEach(header => {\n        header.addEventListener('click', function () {\n          const item = this.closest('.accordion-item');\n          item.classList.toggle('active');\n\n          const indicator = item.querySelector('.indicator');\n          indicator.textContent = item.classList.contains('active') ? '—' : '+';\n        });\n      });\n    </script>\n  </body>\n</html>",
