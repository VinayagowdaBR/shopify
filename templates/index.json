        "title": "",
        "subtitle": "",
        "custom_liquid": "<!-- ✅ FULL-WIDTH POLICY SECTION (full-bleed, no side gaps) -->\n<div class=\"policy-section-wrapper\">\n  <div class=\"policy-box\">\n\n    <div class=\"policy-item\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0695/6879/0581/files/Frame_21a13de0-8e83-442b-9834-fb6f564d405f.svg?v=1765446568\" class=\"policy-icon\">\n      <p class=\"policy-text\">2 Days Return</p>\n    </div>\n\n    <div class=\"policy-item\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0695/6879/0581/files/usp-return-d_svg.svg?v=1765446571\" class=\"policy-icon\">\n      <p class=\"policy-text\">10 Days Exchange</p>\n    </div>\n\n    <div class=\"policy-item\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0695/6879/0581/files/usp-warranty-d.svg?v=1765446577\" class=\"policy-icon\">\n      <p class=\"policy-text\">Cash On Delivery</p>\n    </div>\n\n    <div class=\"policy-item\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0695/6879/0581/files/Layer_1.svg?v=1765446579\" class=\"policy-icon\">\n      <p class=\"policy-text\">Fast Shipping</p>\n    </div>\n\n  </div>\n</div>\n\n<style>\n/* FULL-BLEED WRAPPER: forces the section to span the viewport width\n   even if the theme adds container padding. */\n.policy-section-wrapper {\n  width: 100vw;\n  position: relative;\n  left: 50%;\n  right: 50%;\n  margin-left: -50vw;\n  margin-right: -50vw;\n  background: #c4e4af;\n  box-sizing: border-box;\n  padding: 0; /* remove any vertical padding if present */\n}\n\n/* CENTERED CONTENT BOX: keeps content centered and constrained */\n.policy-box {\n  max-width: 1200px;\n  margin: 0 auto;           /* center inside the full-bleed wrapper */\n  display: flex;\n  justify-content: space-between;\n  border: 1px solid #ddd;\n  padding: 20px 10px;       /* internal padding for the box */\n  background: transparent;  /* wrapper provides the bg color */\n  box-sizing: border-box;\n}\n\n/* 4 equal columns */\n.policy-item {\n  width: 25%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  position: relative;\n  text-align: center;\n  box-sizing: border-box;\n}\n\n/* Separators */\n.policy-item:not(:last-child)::after {\n  content: \"\";\n  position: absolute;\n  right: 0;\n  top: 20%;\n  height: 60%;\n  width: 1px;\n  background: #999;\n}\n\n.policy-icon {\n  width: 40px;\n}\n\n.policy-text {\n  font-size: 14px;\n  white-space: nowrap;\n}\n\n/* MOBILE */\n@media (max-width: 768px) {\n  .policy-box {\n    padding: 12px 8px;\n  }\n\n  .policy-item {\n    width: 25%;\n    flex-direction: column; /* stack icon + text */\n    justify-content: center;\n    align-items: center;\n    gap: 6px;\n  }\n\n  .policy-item:not(:last-child)::after {\n    height: 70%;\n    top: 15%;\n  }\n\n  .policy-icon {\n    width: 26px;\n  }\n\n  .policy-text {\n    font-size: 10px;\n    line-height: 1.3;\n    text-align: center;\n  }\n}\n</style>",
        "top-offeset": "none",
