<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.body.addEventListener("submit", function (e) {
      const form = e.target.closest('.product-form');
      if (!form) return;

      e.preventDefault();

      const formData = new FormData(form);
      const spinner = form.querySelector('.btn_spinner');
      if (spinner) spinner.classList.remove('hidden');

      fetch('/cart/add.js', {
        method: 'POST',
        body: formData
      })
      .then(response => response.json())
      .then(data => {
        console.log('✅ Product added');

        // ✅ Open cart drawer
        const cartTrigger = document.querySelector('#cartLink');
        if (cartTrigger) cartTrigger.click();

        // ✅ Update cart count
        fetch('/cart.js')
          .then(res => res.json())
          .then(cart => {
            const cartCount = cart.item_count;
            const countElement = document.querySelector('#CartCount');
            if (countElement) {
              countElement.textContent = cartCount;
              countElement.classList.remove('hidden');
            }
          });

        // ✅ Re-render cart drawer content
        fetch('/?sections=cart-drawer')
          .then(res => res.json())
          .then(data => {
            const parser = new DOMParser();
            const html = parser.parseFromString(data['cart-drawer'], 'text/html');
            const newDrawerContent = html.querySelector('.cart-drawer');

            const existingDrawer = document.querySelector('.cart-drawer');
            if (existingDrawer && newDrawerContent) {
              existingDrawer.innerHTML = newDrawerContent.innerHTML;
            }
          });

      })
      .catch(error => {
        console.error('🚨 Error adding to cart:', error);
        alert('Something went wrong.');
      })
      .finally(() => {
        if (spinner) spinner.classList.add('hidden');
      });
    });
  });
</script>


<!-- Swiper JS (CSS already loaded in head) -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>

<script>
document.addEventListener("DOMContentLoaded", function () {
  function initializeSwiper() {
    if (document.querySelector('.cart-reco-swiper')) {
      const existingSwiper = document.querySelector('.cart-reco-swiper').swiper;
      if (existingSwiper) existingSwiper.destroy(true, true);

      new Swiper('.cart-reco-swiper', {
        slidesPerView: 'auto',
        spaceBetween: 12,
        freeMode: true,
        simulateTouch: true, // ✅ Desktop swipe enable
        scrollbar: {
          hide: true
        },
      });
    }
  }

  document.addEventListener('cart:updated', initializeSwiper);

  const drawer = document.querySelector('.drawer__upsell');
  if (drawer) {
    const observer = new MutationObserver(function () {
      if (drawer.offsetParent !== null) {
        initializeSwiper();
        observer.disconnect();
      }
    });
    observer.observe(document.body, { childList: true, subtree: true });
  }

  initializeSwiper();

  // ✅ AJAX Add to Cart with full cart update
  window.addToCartAjax = function(variantId, button) {
    // Disable button and show "Adding..."
    button.disabled = true;
    button.classList.add('adding');
    const textSpan = button.querySelector('.text');
    if (textSpan) textSpan.textContent = 'Adding...';

    const spinner = button.querySelector('.btn_spinner');
    if (spinner) spinner.classList.remove('hidden');

    // Add to cart via AJAX
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] }),
    })
    .then(response => {
      if (!response.ok) throw new Error('Network response was not ok');
      return response.json();
    })
    .then(data => {
      console.log('✅ Product added to cart');

      // ✅ Open cart drawer
      const cartTrigger = document.querySelector('#cartLink');
      if (cartTrigger) cartTrigger.click();

      // ✅ Update cart count
      fetch('/cart.js')
        .then(res => res.json())
        .then(cart => {
          const cartCount = cart.item_count;
          const countElement = document.querySelector('#CartCount');
          if (countElement) {
            countElement.textContent = cartCount;
            countElement.classList.remove('hidden');
          }
        });

      // ✅ Reload cart drawer content
      fetch('/?sections=cart-drawer')
        .then(res => res.json())
        .then(data => {
          const parser = new DOMParser();
          const html = parser.parseFromString(data['cart-drawer'], 'text/html');
          const newDrawer = html.querySelector('.cart-drawer');
          const oldDrawer = document.querySelector('.cart-drawer');
          if (oldDrawer && newDrawer) {
            oldDrawer.innerHTML = newDrawer.innerHTML;
          }

          // ✅ Reinitialize Swiper after content load
          document.dispatchEvent(new CustomEvent('cart:updated'));
        });
    })
    .catch(error => {
      console.error('🚨 Error adding to cart:', error);
      alert('Something went wrong while adding the product.');
    })
    .finally(() => {
      // Reset button
      button.disabled = false;
      button.classList.remove('adding');
      if (textSpan) textSpan.textContent = 'Add to Cart';
      if (spinner) spinner.classList.add('hidden');
    });
  };
});
</script>







<!-- Lazy Loading for Below-the-Fold Images -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    var viewportHeight = window.innerHeight;
    var images = document.querySelectorAll('img:not([loading])');
    images.forEach(function(img) {
      var rect = img.getBoundingClientRect();
      if (rect.top >= viewportHeight) {
        img.setAttribute('loading', 'lazy');
      }
    });
  });
</script>



