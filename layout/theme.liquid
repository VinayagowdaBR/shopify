  {%- comment -%} AIUI Immersive flag detector — must run before paint to avoid FOUC {%- endcomment -%}
  <script>
    (function(){
      try {
        var qs = window.location.search;
        var on = /[?&]preview=immersive(?:&|$)/.test(qs) ||
                 /(?:^|;\s*)aiui=on(?:;|$)/.test(document.cookie);
        var off = /[?&]preview=classic(?:&|$)/.test(qs);
        if (on && !off) {
          document.documentElement.classList.add("aiui-on");
          // Persist for the session so internal links keep the preview
          document.cookie = "aiui=on; path=/; max-age=" + (60*60*24*7) + "; SameSite=Lax";
        }
        if (off) {
          document.cookie = "aiui=; path=/; max-age=0; SameSite=Lax";
        }
      } catch(e) {}
    })();
  </script>
