      <h2 style="font-size: 24px; margin-bottom: 15px; color: #333;">🔒 Coming Soon</h2>
      <input type="password" id="customize-unlock-code" placeholder="Enter Your Code" style="padding: 12px 15px; width: 100%; max-width: 280px; text-align: center; font-size: 16px; border: 1px solid #ccc; border-radius: 6px; margin-bottom: 15px;" autocomplete="off" />
      <button onclick="unlockCustomize()" style="background-color: #007BFF; color: white; padding: 10px 24px; border: none; border-radius: 6px; font-size: 16px; cursor: pointer;">Unlock</button>
      <p id="error-msg" style="margin-top: 10px; color: red; display: none;">❌ Incorrect Code</p>
    </div>

    <p style="margin-top: 25px; color: #b30000; font-size: 15px; font-weight: bold; text-align: center; max-width: 600px; padding: 0 20px;">
      ⚠Your website is under construction, when your website will be ready, then we will close this project from our side and this password will be removed automatically, thank you so much!
    </p>

  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const overlay = document.getElementById("customize-lock-overlay");
      const input = document.getElementById("customize-unlock-code");

      function maintainFocus() {
        if (overlay.style.display === "flex" && document.activeElement !== input) {
          input.focus();
        }
      }

      if ((window.location.host === 'house-of-viya.myshopify.com' || window.location.host === 'houseofviya.in') && !window.location.search.includes('customize')) {
        if (sessionStorage.getItem("theme_customizer_unlocked") !== "yes") {
          overlay.style.display = "flex";
          setTimeout(() => input.focus(), 100);
          document.addEventListener("focusin", maintainFocus);

          input.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
              e.preventDefault();
              unlockCustomize();
            }
          });
        } else {
          overlay.style.display = "none";
        }
      } else {
        overlay.style.display = "none";
      }
    });

    function unlockCustomize() {
      const inputVal = document.getElementById("customize-unlock-code").value.trim();

      if (inputVal === "123") {
        sessionStorage.setItem("theme_customizer_unlocked", "yes");
        document.getElementById("customize-lock-overlay").style.display = "none";
        document.removeEventListener("focusin", maintainFocus);
      } else {
        document.getElementById("error-msg").style.display = "block";
        document.getElementById("customize-unlock-code").value = "";
        setTimeout(() => {
          document.getElementById("error-msg").style.display = "none";
        }, 2000);
      }
    }
  </script>
{% endif %}




